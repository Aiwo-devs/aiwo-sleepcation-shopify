                      }

                      /* FIX THICK PLUS/MINUS ICON IN STICKY ATC */
      .sticky_add_to_cart .quantity__button { font-weight: 400 !important; }
      .sticky_add_to_cart .quantity__button svg { 
        width: 16px !important; 
        height: 16px !important; 
        stroke: #1a1a1a !important; 
        fill: none !important; 
      }
      .sticky_add_to_cart .quantity__button svg path,
      .sticky_add_to_cart .quantity__button svg line,
      .sticky_add_to_cart .quantity__button svg polyline {
        stroke-width: 1.5px !important;
        vector-effect: non-scaling-stroke !important;
      }

                      /* MOBILE (Under 768px) */
                      @media (max-width: 767px) {
                        .x-evoo-v3-container { margin-bottom: 0 !important; } 
                        .x-evoo-v3-mobile-layout { display: none !important; } /* Main UI hidden, relying purely on sticky */
                        .sticky_add_to_cart form { display: flex !important; width: 100% !important; align-items: stretch !important; }
                      }

                      /* DESKTOP (768px+) */
                      @media (min-width: 768px) {
                        .x-evoo-v3-container { max-width: 564px !important; }
                        .x-evoo-v3-mobile-layout { display: none !important; }
                        .x-evoo-v3-desktop-layout { display: flex !important; flex-direction: row !important; gap: 16px !important; width: 100% !important; align-items: flex-end !important; }
                        .x-evoo-v3-qty-wrapper { flex-shrink: 0; }
                        .x-evoo-v3-btn-wrapper { flex-grow: 1; display: flex !important; flex-direction: column !important; width: 100% !important; }
                        .x-evoo-v3-btn-wrapper form { width: 100% !important; margin: 0 !important; display: flex !important; }
                        .x-evoo-v3-desktop-layout .aiwo-evoo-v3-protocol-tooltip { display: flex !important; justify-content: center !important; width: 100% !important; margin-bottom: 12px !important; }
                        .x-evoo-v3-desktop-layout .aiwo-evoo-v3-protocol-tooltip__trigger { margin: 0 auto !important; }
                        .x-evoo-v3-atc-btn { padding: 0 48px !important; height: 48px !important; }
                      }

                      /* DESKTOP (1024px+) */
                      @media (min-width: 1024px) {
                        .x-evoo-v3-atc-btn { padding: 0 112px !important; }
                        body .sticky_add_to_cart button[type="submit"] { padding: 0 112px !important; }
                      }
                    </style>

                    {%- liquid
                      assign check_against_inventory = true
                      if product.selected_or_first_available_variant.inventory_management != 'shopify' or product.selected_or_first_available_variant.inventory_policy == 'continue'
                        assign check_against_inventory = false
                      endif
                      if product.selected_or_first_available_variant.quantity_rule.min > product.selected_or_first_available_variant.inventory_quantity and check_against_inventory
                        assign quantity_rule_soldout = true
                      endif
                      assign is_disabled = false
                      if product.selected_or_first_available_variant.available == false or quantity_rule_soldout or product.selected_or_first_available_variant == nil
                        assign is_disabled = true
                      endif
                      assign button_text = 'products.product.add_to_cart' | t
                      if product.selected_or_first_available_variant == nil
                        assign button_text = 'products.product.unavailable' | t
                      elsif is_disabled
                        assign button_text = 'products.product.sold_out' | t
                      endif
                      assign initial_qty = product.selected_or_first_available_variant.quantity_rule.min | default: 1
                    -%}

                    <div class="x-evoo-v3-container">
                      {%- form 'product', product, id: product_form_id, class: 'form w-full', novalidate: 'novalidate', data-type: 'add-to-cart-form', x-ref: 'product_form' -%}
