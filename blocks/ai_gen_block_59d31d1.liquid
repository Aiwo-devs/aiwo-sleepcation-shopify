      "type": "text",
      "id": "question_2",
      "label": "Question",
      "default": "How long does it take to see results from turmeric supplements?"
    },
    {
      "type": "textarea",
      "id": "answer_2",
      "label": "Answer",
      "default": "Results vary by individual, but most people notice benefits within 4-8 weeks of consistent daily use. For joint health and inflammation support, some may experience improvements sooner, while others may need up to 12 weeks."
    },
    {
      "type": "header",
      "content": "Question 3"
    },
    {
      "type": "text",
      "id": "question_3",
      "label": "Question",
      "default": "Can I take turmeric supplements with other medications?"
    },
