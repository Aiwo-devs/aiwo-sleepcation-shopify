{% doc %}
  @prompt
    Create ingredients section with light muted background:
    Layout: 2 columns (stack on mobile)
    Left Column - Nutritional Card:
    
    Large white rounded card with shadow/border
    Heading: "Nutritional Information"
    Subtext: "Each enteric coated soft gelatin capsule contains (approx.)"
    5 ingredient rows, each showing:
    
    Name [EDITABLE]
    Amount (large, bold, right-aligned) [EDITABLE]
    Description (small, gray) [EDITABLE]
    
    
    First row highlighted: light blue bg, blue text, blue border
    EPA row: gold colored amount
    Bottom: Certification tags in green pills [EDITABLE, repeatable]
    
    Default: "Gelatin Food Grade", "Gluten Free", "HALAL", "GMP", "ISO"
    
    
    
    Right Column - Content:
    
    Gold pill badge: "Premium Ingredients"
    Large heading: "What's Inside" + "Every Capsule" (gold gradient)
    Gray description paragraph [EDITABLE]
    3 feature bullets with colored dot indicators:
    
    Ocean blue dot - "High Potency" + description [EDITABLE]
    Gold dot - "Optimal Ratio" + description [EDITABLE]
    Green dot - "Pure & Safe" + description [EDITABLE]
    
    
    
    Default 5 Ingredients:
    
    Fish Oil - 1000mg - "Premium quality molecularly distilled"
    Total Omega-3 - 660mg - "High concentration of essential fatty acids"
    EPA - 360mg - "Eicosapentaenoic Acid (36%)" (Gold amount)
    DHA - 240mg - "Docosahexaenoic Acid (24%)"
    Other Omega-3 - 60mg - "Additional beneficial fatty acids"
    
    Responsive: Stack vertically on mobile (content first, card second)
    All ingredient rows, amounts, descriptions, bullets, and tags editable via Shopify settings., Every row has a light gray   background with outer line expect first highlighted one and right scetion should be centered alignement, Horizontal centered align
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-ingredients-section-{{ ai_gen_id }} {
    background-color: {{ block.settings.section_background }};
    padding: 60px 20px;
    width: 100%;
  }

  .ai-ingredients-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: center;
  }

  .ai-nutritional-card-{{ ai_gen_id }} {
    background: #ffffff;
    border-radius: 16px;
    padding: 32px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    border: 1px solid #e5e5e5;
  }

  .ai-card-heading-{{ ai_gen_id }} {
    font-size: 24px;
    font-weight: 700;
    color: #000000;
    margin: 0 0 8px 0;
  }

  .ai-card-subtext-{{ ai_gen_id }} {
    font-size: 14px;
    color: #666666;
    margin: 0 0 24px 0;
    line-height: 1.5;
  }

  .ai-ingredient-row-{{ ai_gen_id }} {
    padding: 16px;
    margin-bottom: 12px;
    border-radius: 8px;
    background-color: #f8f8f8;
    border: 1px solid #e5e5e5;
  }

  .ai-ingredient-row-{{ ai_gen_id }}:last-of-type {
    margin-bottom: 24px;
  }

  .ai-ingredient-row-highlighted-{{ ai_gen_id }} {
    background-color: {{ block.settings.highlight_bg_color }};
    border: 2px solid {{ block.settings.highlight_border_color }};
    padding: 16px;
    margin-bottom: 12px;
    border-radius: 8px;
  }

  .ai-ingredient-header-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 4px;
  }

  .ai-ingredient-name-{{ ai_gen_id }} {
    font-size: 16px;
    font-weight: 600;
    color: #000000;
  }

  .ai-ingredient-row-highlighted-{{ ai_gen_id }} .ai-ingredient-name-{{ ai_gen_id }} {
    color: {{ block.settings.highlight_text_color }};
  }

  .ai-ingredient-amount-{{ ai_gen_id }} {
    font-size: 20px;
    font-weight: 700;
    color: #000000;
  }

  .ai-ingredient-row-highlighted-{{ ai_gen_id }} .ai-ingredient-amount-{{ ai_gen_id }} {
    color: {{ block.settings.highlight_text_color }};
  }

  .ai-ingredient-amount-gold-{{ ai_gen_id }} {
    color: {{ block.settings.gold_color }};
  }

  .ai-ingredient-description-{{ ai_gen_id }} {
    font-size: 13px;
    color: #888888;
    margin: 0;
  }

  .ai-certifications-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 8px;
  }

  .ai-cert-tag-{{ ai_gen_id }} {
    background-color: {{ block.settings.cert_bg_color }};
    color: {{ block.settings.cert_text_color }};
    padding: 6px 14px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
  }

  .ai-content-column-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .ai-premium-badge-{{ ai_gen_id }} {
    background: linear-gradient(135deg, {{ block.settings.gold_color }} 0%, #d4af37 100%);
    color: #ffffff;
    padding: 8px 20px;
    border-radius: 20px;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 20px;
    display: inline-block;
  }

  .ai-content-heading-{{ ai_gen_id }} {
    font-size: 36px;
    font-weight: 700;
    color: #000000;
    margin: 0 0 12px 0;
    line-height: 1.2;
  }

  .ai-content-heading-gold-{{ ai_gen_id }} {
    background: linear-gradient(135deg, {{ block.settings.gold_color }} 0%, #d4af37 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .ai-content-description-{{ ai_gen_id }} {
    font-size: 15px;
    color: #666666;
    line-height: 1.6;
    margin: 0 0 32px 0;
  }

  .ai-features-list-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 24px;
    width: 100%;
    max-width: 500px;
  }

  .ai-feature-item-{{ ai_gen_id }} {
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }

  .ai-feature-dot-{{ ai_gen_id }} {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    flex-shrink: 0;
    margin-top: 6px;
  }

  .ai-feature-dot-blue-{{ ai_gen_id }} {
    background-color: {{ block.settings.dot_blue_color }};
  }

  .ai-feature-dot-gold-{{ ai_gen_id }} {
    background-color: {{ block.settings.gold_color }};
  }

  .ai-feature-dot-green-{{ ai_gen_id }} {
    background-color: {{ block.settings.dot_green_color }};
  }

  .ai-feature-content-{{ ai_gen_id }} {
    flex: 1;
    text-align: left;
  }

  .ai-feature-title-{{ ai_gen_id }} {
    font-size: 18px;
    font-weight: 700;
    color: #000000;
    margin: 0 0 6px 0;
  }

  .ai-feature-desc-{{ ai_gen_id }} {
    font-size: 14px;
    color: #666666;
    margin: 0;
    line-height: 1.5;
  }

  @media screen and (max-width: 768px) {
    .ai-ingredients-container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .ai-content-column-{{ ai_gen_id }} {
      order: -1;
    }

    .ai-content-heading-{{ ai_gen_id }} {
      font-size: 28px;
    }

    .ai-ingredient-amount-{{ ai_gen_id }} {
      font-size: 18px;
    }
  }
{% endstyle %}

<div class="ai-ingredients-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-ingredients-container-{{ ai_gen_id }}">
    <div class="ai-nutritional-card-{{ ai_gen_id }}">
      <h2 class="ai-card-heading-{{ ai_gen_id }}">{{ block.settings.card_heading }}</h2>
      <p class="ai-card-subtext-{{ ai_gen_id }}">{{ block.settings.card_subtext }}</p>

      {% for i in (1..5) %}
        {% liquid
          assign name_key = 'ingredient_' | append: i | append: '_name'
          assign amount_key = 'ingredient_' | append: i | append: '_amount'
          assign desc_key = 'ingredient_' | append: i | append: '_description'
          assign is_gold_key = 'ingredient_' | append: i | append: '_gold'
          
          assign ingredient_name = block.settings[name_key]
          assign ingredient_amount = block.settings[amount_key]
          assign ingredient_desc = block.settings[desc_key]
          assign is_gold = block.settings[is_gold_key]
        %}

        {% if i == 1 %}
          <div class="ai-ingredient-row-highlighted-{{ ai_gen_id }}">
        {% else %}
          <div class="ai-ingredient-row-{{ ai_gen_id }}">
        {% endif %}
          <div class="ai-ingredient-header-{{ ai_gen_id }}">
            <span class="ai-ingredient-name-{{ ai_gen_id }}">{{ ingredient_name }}</span>
            <span class="ai-ingredient-amount-{{ ai_gen_id }} {% if is_gold %}ai-ingredient-amount-gold-{{ ai_gen_id }}{% endif %}">{{ ingredient_amount }}</span>
          </div>
          <p class="ai-ingredient-description-{{ ai_gen_id }}">{{ ingredient_desc }}</p>
        </div>
      {% endfor %}

      <div class="ai-certifications-{{ ai_gen_id }}">
        {% for i in (1..5) %}
          {% liquid
            assign cert_key = 'cert_' | append: i
            assign cert_value = block.settings[cert_key]
          %}
          {% if cert_value != blank %}
            <span class="ai-cert-tag-{{ ai_gen_id }}">{{ cert_value }}</span>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <div class="ai-content-column-{{ ai_gen_id }}">
      <span class="ai-premium-badge-{{ ai_gen_id }}">{{ block.settings.badge_text }}</span>
      
      <h2 class="ai-content-heading-{{ ai_gen_id }}">
        {{ block.settings.heading_line_1 }}<br>
        <span class="ai-content-heading-gold-{{ ai_gen_id }}">{{ block.settings.heading_line_2 }}</span>
      </h2>

      <div class="ai-content-description-{{ ai_gen_id }}">
        {{ block.settings.description }}
      </div>

      <div class="ai-features-list-{{ ai_gen_id }}">
        {% for i in (1..3) %}
          {% liquid
            assign title_key = 'feature_' | append: i | append: '_title'
            assign desc_key = 'feature_' | append: i | append: '_description'
            
            assign feature_title = block.settings[title_key]
            assign feature_desc = block.settings[desc_key]
          %}
          
          <div class="ai-feature-item-{{ ai_gen_id }}">
            {% if i == 1 %}
              <div class="ai-feature-dot-{{ ai_gen_id }} ai-feature-dot-blue-{{ ai_gen_id }}"></div>
            {% elsif i == 2 %}
              <div class="ai-feature-dot-{{ ai_gen_id }} ai-feature-dot-gold-{{ ai_gen_id }}"></div>
            {% else %}
              <div class="ai-feature-dot-{{ ai_gen_id }} ai-feature-dot-green-{{ ai_gen_id }}"></div>
            {% endif %}
            <div class="ai-feature-content-{{ ai_gen_id }}">
              <h3 class="ai-feature-title-{{ ai_gen_id }}">{{ feature_title }}</h3>
              <p class="ai-feature-desc-{{ ai_gen_id }}">{{ feature_desc }}</p>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

