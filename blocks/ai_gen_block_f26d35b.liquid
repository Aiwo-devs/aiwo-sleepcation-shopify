{% doc %}
  @prompt
    # Testimonials Section - 3 Column Grid (Condensed)
    
    ## Prompt
    
    Create testimonials section with light secondary background:
    
    **Header** (centered, max-width 700px):
    - Gold pill badge: "Customer Reviews"
    - Large heading: "Trusted by" + "Thousands" (gold gradient) [EDITABLE]
    - Gray subtitle about customer satisfaction [EDITABLE]
    
    **Testimonials Grid:**
    - 3 columns (2 on tablet, 1 on mobile)
    - 6-8px gap between cards
    
    **Testimonial Card:**
    - White bg, rounded corners, border, shadow
    - 32-40px padding
    - Large quote icon (light gray, top-right corner)
    - 5 gold stars (filled) at top [EDITABLE: rating 1-5]
    - Quote text in dark gray [EDITABLE]
    - Bottom: Avatar circle + Name + Role
      - Avatar: Gradient circle with initials [EDITABLE: image or initials]
      - Name: Bold dark text [EDITABLE]
      - Role: Small gray text [EDITABLE]
    
    **Default 3 Testimonials:**
    1. Dr. Priya Sharma (PS) - Cardiologist - 5 stars - "Superior absorption..."
    2. Rahul Mehta (RM) - Fitness Enthusiast - 5 stars - "Joint pain reduced..."
    3. Ananya Krishnan (AK) - Working Professional - 5 stars - "No bad taste..."
    
    **Bottom Trust Stats** (border-top separator):
    - 3 centered stat boxes:
      - "10,000+" - Happy Customers [EDITABLE]
      - "4.8/5" - Average Rating [EDITABLE]
      - "95%" - Would Recommend [EDITABLE]
    
    **Responsive:** Cards stack 3→2→1 columns
    
    **All testimonials repeatable (add/remove). All fields editable via Shopify settings.**
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-testimonials-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.section_background }};
    padding: 60px 20px;
  }

  .ai-testimonials-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-testimonials-header-{{ ai_gen_id }} {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 50px;
  }

  .ai-testimonials-badge-{{ ai_gen_id }} {
    display: inline-block;
    background: linear-gradient(135deg, {{ block.settings.badge_color_start }}, {{ block.settings.badge_color_end }});
    color: {{ block.settings.badge_text_color }};
    padding: 8px 20px;
    border-radius: 50px;
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 20px;
  }

  .ai-testimonials-heading-{{ ai_gen_id }} {
    font-size: 42px;
    font-weight: 700;
    color: {{ block.settings.heading_color }};
    margin: 0 0 15px;
    line-height: 1.2;
  }

  .ai-testimonials-heading-{{ ai_gen_id }} .ai-testimonials-highlight-{{ ai_gen_id }} {
    background: linear-gradient(135deg, {{ block.settings.highlight_color_start }}, {{ block.settings.highlight_color_end }});
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .ai-testimonials-subtitle-{{ ai_gen_id }} {
    font-size: 16px;
    color: {{ block.settings.subtitle_color }};
    margin: 0;
    line-height: 1.6;
  }

  .ai-testimonials-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.card_gap }}px;
    margin-bottom: 50px;
  }

  .ai-testimonial-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border: 1px solid {{ block.settings.card_border_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    position: relative;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-testimonial-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
  }

  .ai-testimonial-quote-icon-{{ ai_gen_id }} {
    position: absolute;
    top: {{ block.settings.card_padding }}px;
    right: {{ block.settings.card_padding }}px;
    width: 40px;
    height: 40px;
    opacity: 0.1;
  }

  .ai-testimonial-stars-{{ ai_gen_id }} {
    display: flex;
    gap: 4px;
    margin-bottom: 15px;
  }

  .ai-testimonial-star-{{ ai_gen_id }} {
    width: 18px;
    height: 18px;
    fill: {{ block.settings.star_color }};
  }

  .ai-testimonial-text-{{ ai_gen_id }} {
    font-size: 15px;
    color: {{ block.settings.quote_text_color }};
    line-height: 1.6;
    margin: 0 0 20px;
  }

  .ai-testimonial-author-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .ai-testimonial-avatar-{{ ai_gen_id }} {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    background: linear-gradient(135deg, {{ block.settings.avatar_gradient_start }}, {{ block.settings.avatar_gradient_end }});
    display: flex;
    align-items: center;
    justify-content: center;
    color: {{ block.settings.avatar_text_color }};
    font-weight: 700;
    font-size: 18px;
  }

  .ai-testimonial-avatar-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-testimonial-author-info-{{ ai_gen_id }} {
    flex-grow: 1;
  }

  .ai-testimonial-author-name-{{ ai_gen_id }} {
    font-size: 15px;
    font-weight: 700;
    color: {{ block.settings.author_name_color }};
    margin: 0 0 4px;
  }

  .ai-testimonial-author-role-{{ ai_gen_id }} {
    font-size: 13px;
    color: {{ block.settings.author_role_color }};
    margin: 0;
  }

  .ai-testimonials-stats-{{ ai_gen_id }} {
    border-top: 1px solid {{ block.settings.stats_border_color }};
    padding-top: 40px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
    text-align: center;
  }

  .ai-testimonials-stat-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .ai-testimonials-stat-value-{{ ai_gen_id }} {
    font-size: 36px;
    font-weight: 700;
    background: linear-gradient(135deg, {{ block.settings.stat_value_color_start }}, {{ block.settings.stat_value_color_end }});
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin: 0;
  }

  .ai-testimonials-stat-label-{{ ai_gen_id }} {
    font-size: 14px;
    color: {{ block.settings.stat_label_color }};
    margin: 0;
  }

  @media screen and (max-width: 989px) {
    .ai-testimonials-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }

    .ai-testimonials-heading-{{ ai_gen_id }} {
      font-size: 32px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-testimonials-section-{{ ai_gen_id }} {
      padding: 40px 15px;
    }

    .ai-testimonials-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-testimonials-heading-{{ ai_gen_id }} {
      font-size: 28px;
    }

    .ai-testimonials-stats-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .ai-testimonial-card-{{ ai_gen_id }} {
      padding: 30px;
    }
  }
{% endstyle %}

<testimonials-section-{{ ai_gen_id }} class="ai-testimonials-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-testimonials-container-{{ ai_gen_id }}">
    <div class="ai-testimonials-header-{{ ai_gen_id }}">
      {% if block.settings.badge_text != blank %}
        <div class="ai-testimonials-badge-{{ ai_gen_id }}">
          {{ block.settings.badge_text }}
        </div>
      {% endif %}

      {% if block.settings.heading_part_1 != blank or block.settings.heading_part_2 != blank %}
        <h2 class="ai-testimonials-heading-{{ ai_gen_id }}">
          {{ block.settings.heading_part_1 }} <span class="ai-testimonials-highlight-{{ ai_gen_id }}">{{ block.settings.heading_part_2 }}</span>
        </h2>
      {% endif %}

      {% if block.settings.subtitle != blank %}
        <p class="ai-testimonials-subtitle-{{ ai_gen_id }}">
          {{ block.settings.subtitle }}
        </p>
      {% endif %}
    </div>

    <div class="ai-testimonials-grid-{{ ai_gen_id }}">
      {% if block.settings.testimonial_1_enabled %}
        <div class="ai-testimonial-card-{{ ai_gen_id }}">
          <svg class="ai-testimonial-quote-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="currentColor">
            <path d="M6 17h3l2-4V7H5v6h3zm8 0h3l2-4V7h-6v6h3z"/>
          </svg>

          <div class="ai-testimonial-stars-{{ ai_gen_id }}">
            {% for i in (1..block.settings.testimonial_1_rating) %}
              <svg class="ai-testimonial-star-{{ ai_gen_id }}" viewBox="0 0 24 24">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
            {% endfor %}
          </div>

          {% if block.settings.testimonial_1_quote != blank %}
            <p class="ai-testimonial-text-{{ ai_gen_id }}">
              "{{ block.settings.testimonial_1_quote }}"
            </p>
          {% endif %}

          <div class="ai-testimonial-author-{{ ai_gen_id }}">
            <div class="ai-testimonial-avatar-{{ ai_gen_id }}">
              {% if block.settings.testimonial_1_avatar %}
                <img src="{{ block.settings.testimonial_1_avatar | image_url: width: 96 }}" alt="{{ block.settings.testimonial_1_name }}" loading="lazy" width="48" height="48">
              {% else %}
                {{ block.settings.testimonial_1_initials }}
              {% endif %}
            </div>
            <div class="ai-testimonial-author-info-{{ ai_gen_id }}">
              {% if block.settings.testimonial_1_name != blank %}
                <p class="ai-testimonial-author-name-{{ ai_gen_id }}">
                  {{ block.settings.testimonial_1_name }}
                </p>
              {% endif %}
              {% if block.settings.testimonial_1_role != blank %}
                <p class="ai-testimonial-author-role-{{ ai_gen_id }}">
                  {{ block.settings.testimonial_1_role }}
                </p>
              {% endif %}
            </div>
          </div>
        </div>
      {% endif %}

      {% if block.settings.testimonial_2_enabled %}
        <div class="ai-testimonial-card-{{ ai_gen_id }}">
          <svg class="ai-testimonial-quote-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="currentColor">
            <path d="M6 17h3l2-4V7H5v6h3zm8 0h3l2-4V7h-6v6h3z"/>
          </svg>

          <div class="ai-testimonial-stars-{{ ai_gen_id }}">
            {% for i in (1..block.settings.testimonial_2_rating) %}
              <svg class="ai-testimonial-star-{{ ai_gen_id }}" viewBox="0 0 24 24">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
            {% endfor %}
          </div>

          {% if block.settings.testimonial_2_quote != blank %}
            <p class="ai-testimonial-text-{{ ai_gen_id }}">
              "{{ block.settings.testimonial_2_quote }}"
            </p>
          {% endif %}

          <div class="ai-testimonial-author-{{ ai_gen_id }}">
            <div class="ai-testimonial-avatar-{{ ai_gen_id }}">
              {% if block.settings.testimonial_2_avatar %}
                <img src="{{ block.settings.testimonial_2_avatar | image_url: width: 96 }}" alt="{{ block.settings.testimonial_2_name }}" loading="lazy" width="48" height="48">
              {% else %}
                {{ block.settings.testimonial_2_initials }}
              {% endif %}
            </div>
            <div class="ai-testimonial-author-info-{{ ai_gen_id }}">
              {% if block.settings.testimonial_2_name != blank %}
                <p class="ai-testimonial-author-name-{{ ai_gen_id }}">
                  {{ block.settings.testimonial_2_name }}
                </p>
              {% endif %}
              {% if block.settings.testimonial_2_role != blank %}
                <p class="ai-testimonial-author-role-{{ ai_gen_id }}">
                  {{ block.settings.testimonial_2_role }}
                </p>
              {% endif %}
            </div>
          </div>
        </div>
      {% endif %}

      {% if block.settings.testimonial_3_enabled %}
        <div class="ai-testimonial-card-{{ ai_gen_id }}">
          <svg class="ai-testimonial-quote-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="currentColor">
            <path d="M6 17h3l2-4V7H5v6h3zm8 0h3l2-4V7h-6v6h3z"/>
          </svg>

          <div class="ai-testimonial-stars-{{ ai_gen_id }}">
            {% for i in (1..block.settings.testimonial_3_rating) %}
              <svg class="ai-testimonial-star-{{ ai_gen_id }}" viewBox="0 0 24 24">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
            {% endfor %}
          </div>

          {% if block.settings.testimonial_3_quote != blank %}
            <p class="ai-testimonial-text-{{ ai_gen_id }}">
              "{{ block.settings.testimonial_3_quote }}"
            </p>
          {% endif %}

          <div class="ai-testimonial-author-{{ ai_gen_id }}">
            <div class="ai-testimonial-avatar-{{ ai_gen_id }}">
              {% if block.settings.testimonial_3_avatar %}
                <img src="{{ block.settings.testimonial_3_avatar | image_url: width: 96 }}" alt="{{ block.settings.testimonial_3_name }}" loading="lazy" width="48" height="48">
              {% else %}
                {{ block.settings.testimonial_3_initials }}
              {% endif %}
            </div>
            <div class="ai-testimonial-author-info-{{ ai_gen_id }}">
              {% if block.settings.testimonial_3_name != blank %}
                <p class="ai-testimonial-author-name-{{ ai_gen_id }}">
                  {{ block.settings.testimonial_3_name }}
                </p>
              {% endif %}
              {% if block.settings.testimonial_3_role != blank %}
                <p class="ai-testimonial-author-role-{{ ai_gen_id }}">
                  {{ block.settings.testimonial_3_role }}
                </p>
              {% endif %}
            </div>
          </div>
        </div>
      {% endif %}
    </div>

    <div class="ai-testimonials-stats-{{ ai_gen_id }}">
      <div class="ai-testimonials-stat-{{ ai_gen_id }}">
        <p class="ai-testimonials-stat-value-{{ ai_gen_id }}">{{ block.settings.stat_1_value }}</p>
        <p class="ai-testimonials-stat-label-{{ ai_gen_id }}">{{ block.settings.stat_1_label }}</p>
      </div>
      <div class="ai-testimonials-stat-{{ ai_gen_id }}">
        <p class="ai-testimonials-stat-value-{{ ai_gen_id }}">{{ block.settings.stat_2_value }}</p>
        <p class="ai-testimonials-stat-label-{{ ai_gen_id }}">{{ block.settings.stat_2_label }}</p>
      </div>
      <div class="ai-testimonials-stat-{{ ai_gen_id }}">
        <p class="ai-testimonials-stat-value-{{ ai_gen_id }}">{{ block.settings.stat_3_value }}</p>
        <p class="ai-testimonials-stat-label-{{ ai_gen_id }}">{{ block.settings.stat_3_label }}</p>
      </div>
    </div>
  </div>
</testimonials-section-{{ ai_gen_id }}>

<script>
  (function() {
    class TestimonialsSection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('testimonials-section-{{ ai_gen_id }}', TestimonialsSection{{ ai_gen_id }});
  })();
</script>

