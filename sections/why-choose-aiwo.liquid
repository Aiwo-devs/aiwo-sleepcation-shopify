{% comment %}
  Why Choose AIWO Section
  All Short Cards - Different Column Widths Per Row
  Updates:
  - Gold: #919FA8
  - Black: #211E1E
  - Grey: #545252
{% endcomment %}

<style>
/* ==========================================================================
   CSS VARIABLES
   ========================================================================== */
:root {
  --wc-bg: #FEFEFE;
  --wc-card-bg: #FBFAFA;
  --wc-card-border: #F0EDED;
  
  /* UPDATED COLORS */
  --wc-text-primary: #211E1E;   /* Was #0C0C0D */
  --wc-text-secondary: #545252; /* Was #4B4B4B */
  --wc-accent-gold: #919FA8;    /* Was #B4A17E */
  
  --wc-radius: 16px;
  --wc-gap: 24px;
  --wc-card-height: 232px;
}

/* ==========================================================================
   SECTION
   ========================================================================== */
.section_why-choose {
  width: 100%;
  padding: 64px 60px;
  background-color: var(--wc-bg);
}

.why-choose_container {
  max-width: 1400px;
  margin: 0 auto;
}

/* ==========================================================================
   HEADER
   ========================================================================== */
.why-choose_header {
  text-align: center;
  margin-bottom: 48px;
}

.why-choose_eyebrow {
  display: inline-block;
  font-size: 14px;
  font-weight: 600;
  line-height: 1.5;
  letter-spacing: 0;
  text-transform: uppercase;
  color: var(--wc-text-primary);
  padding: 4px 12px;
  margin-bottom: 24px;
  /* Updated Gradient to match #919FA8 (RGB: 145, 159, 168) */
  background: linear-gradient(90deg, rgba(145, 159, 168, 0.24), rgba(145, 159, 168, 0.06));
  border-radius: 2px;
}

.why-choose_heading {
  font-size: 48px;
  font-weight: 600;
  line-height: 1.2;
  color: var(--wc-text-primary);
  margin: 0;
}

.why-choose_heading-gold {
  color: var(--wc-accent-gold);
}

/* ==========================================================================
   GRID - 2 ROWS WITH DIFFERENT COLUMN WIDTHS
   ========================================================================== */
.why-choose_grid {
  display: flex;
  flex-direction: column;
  gap: var(--wc-gap);
}

.why-choose_row {
  display: grid;
  gap: var(--wc-gap);
  align-items: start;
}

/* Row 1: WIDE (40fr), NARROW (25fr), MEDIUM (35fr) */
.why-choose_row:nth-child(1) {
  grid-template-columns: 40fr 25fr 35fr;
}

/* Row 2: MEDIUM (35fr), NARROW (25fr), WIDE (40fr) */
.why-choose_row:nth-child(2) {
  grid-template-columns: 35fr 25fr 40fr;
}

/* ==========================================================================
   CARD BASE - ALL SAME HEIGHT
   ========================================================================== */
.why-choose_card {
  position: relative;
  background-color: var(--wc-card-bg);
  border: 1px solid var(--wc-card-border);
  border-radius: var(--wc-radius);
  padding: 24px;
  overflow: hidden;
  box-shadow: 0 2px 4px -2px rgba(16, 24, 40, 0.06), 0 4px 8px -2px rgba(16, 24, 40, 0.10);
  display: flex;
  flex-direction: column;
  min-height: var(--wc-card-height);
}

/* ==========================================================================
   CARD PADDING FOR IMAGES
   ========================================================================== */
.why-choose_row:nth-child(1) .why-choose_card:nth-child(1) {
  padding-right: 144px;
}

.why-choose_row:nth-child(1) .why-choose_card:nth-child(3) {
  padding-right: 175px;
}

.why-choose_row:nth-child(2) .why-choose_card:nth-child(1) {
  padding-right: 175px;
}

.why-choose_row:nth-child(2) .why-choose_card:nth-child(3) {
  padding-right: 144px;
}

/* ==========================================================================
   CARD CONTENT
   ========================================================================== */
.why-choose_card-content {
  position: relative;
  z-index: 2;
}

.why-choose_card-title {
  font-size: 24px;
  font-weight: 600;
  line-height: 1.3;
  color: var(--wc-text-primary);
  margin: 0 0 12px 0;
}

.why-choose_card-text {
  font-size: 16px;
  font-weight: 400;
  line-height: 1.6;
  color: var(--wc-text-secondary);
  margin: 0;
}

/* ==========================================================================
   CARD IMAGES
   ========================================================================== */
.why-choose_card-media {
  position: absolute;
  bottom: 0;
  right: 0;
  z-index: 1;
  pointer-events: none;
}

.why-choose_card-media--woman {
  width: 136px;
  height: 159px;
}

.why-choose_card-media--food {
  width: 167px;
  height: 100px;
}

.why-choose_card-media img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  display: block;
}

/* ==========================================================================
   RESPONSIVE - TABLET (SAME AS MOBILE)
   ========================================================================== */
@media (max-width: 991px) {
  .section_why-choose {
    padding: 56px 40px;
  }
  
  .why-choose_heading {
    font-size: 40px;
  }
  
  .why-choose_header {
    margin-bottom: 32px;
  }
  
  .why-choose_eyebrow {
    font-size: 12px;
  }
  
  .why-choose_grid {
    gap: 16px;
  }
  
  .why-choose_row:nth-child(1),
  .why-choose_row:nth-child(2) {
    grid-template-columns: 1fr;
    gap: 16px;
  }
  
  .why-choose_card {
    min-height: 180px !important;
    padding: 20px !important;
  }
  
  .why-choose_row:nth-child(1) .why-choose_card:nth-child(1),
  .why-choose_row:nth-child(1) .why-choose_card:nth-child(3),
  .why-choose_row:nth-child(2) .why-choose_card:nth-child(1),
  .why-choose_row:nth-child(2) .why-choose_card:nth-child(3) {
    padding-right: 95px !important;
  }
  
  .why-choose_card-title {
    font-size: 18px;
  }
  
  .why-choose_card-text {
    font-size: 14px;
    line-height: 1.5;
  }
  
  .why-choose_card-media {
    opacity: 0.25;
  }
  
  .why-choose_card-media--woman {
    width: 85px;
    height: 99px;
  }
  
  .why-choose_card-media--food {
    width: 105px;
    height: 63px;
  }
}

/* ==========================================================================
   RESPONSIVE - MOBILE
   ========================================================================== */
@media (max-width: 767px) {
  .section_why-choose {
    padding: 40px 24px;
  }
  
  .why-choose_header {
    margin-bottom: 32px;
  }
  
  .why-choose_heading {
    font-size: 32px;
  }
  
  .why-choose_eyebrow {
    font-size: 12px;
  }
  
  .why-choose_grid {
    gap: 16px;
  }
  
  .why-choose_row:nth-child(1),
  .why-choose_row:nth-child(2) {
    grid-template-columns: 1fr;
    gap: 16px;
  }
  
  .why-choose_card {
    min-height: 180px !important;
    padding: 20px !important;
  }
  
  .why-choose_row:nth-child(1) .why-choose_card:nth-child(1),
  .why-choose_row:nth-child(1) .why-choose_card:nth-child(3),
  .why-choose_row:nth-child(2) .why-choose_card:nth-child(1),
  .why-choose_row:nth-child(2) .why-choose_card:nth-child(3) {
    padding-right: 95px !important;
  }
  
  .why-choose_card-title {
    font-size: 18px;
  }
  
  .why-choose_card-text {
    font-size: 14px;
    line-height: 1.5;
  }
  
  .why-choose_card-media {
    opacity: 0.25;
  }
  
  .why-choose_card-media--woman {
    width: 85px;
    height: 99px;
  }
  
  .why-choose_card-media--food {
    width: 105px;
    height: 63px;
  }
}

/* ==========================================================================
   RESPONSIVE - MOBILE PORTRAIT
   ========================================================================== */
@media (max-width: 479px) {
  .section_why-choose {
    padding: 32px 20px;
  }
  
  .why-choose_heading {
    font-size: 28px;
  }
  
  .why-choose_eyebrow {
    font-size: 11px;
  }
  
  .why-choose_card-title {
    font-size: 17px;
  }
  
  .why-choose_card-text {
    font-size: 13px;
  }
}
</style>

<div class="section_why-choose">
  <div class="why-choose_container">
    
    <header class="why-choose_header">
      <span class="why-choose_eyebrow">{{ section.settings.eyebrow }}</span>
