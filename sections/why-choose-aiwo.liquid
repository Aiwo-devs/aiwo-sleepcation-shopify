            </div>
          {%- endif -%}
        </article>
        
        <article class="why-choose_card">
          <div class="why-choose_card-content">
            <h3 class="why-choose_card-title">{{ section.settings.card_5_title }}</h3>
            <p class="why-choose_card-text">{{ section.settings.card_5_description }}</p>
