{% doc %}
  @prompt
    Create the main combo offers section with 8 product combo cards organized in 4 categories. This is the PRIMARY CONVERSION section.
    
    SECTION BACKGROUND: #FFFFFF
    MAX-WIDTH: 1400px centered
    SECTION PADDING: 96px vertical, 20px horizontal
    
    STRUCTURE: 4 Categories, each with category header + combo cards
    
    ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    CATEGORY 1: HERO ESSENTIALS (2 cards)
    ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    
    Category Header:
    - Full-width stripe, background #D68641
    - Text: "Hero Essentials" - Poppins SemiBold 28px, #FFFFFF, centered
    - Padding: 20px vertical
    
    Card Grid: 2 columns, 32px gap
    
    COMBO CARD #1:
    Badge: "BESTSELLER" (top-right, gold #FFD700 bg, #211E1E text)
    Image: Fast Bar Trial Pack (300x300px centered, clean bg)
    Name: "Hero Essentials #1" - Poppins SemiBold 24px #211E1E
    
    What You Get Box:
    - Left border: 4px solid #5B2E28, padding-left 16px
    - Heading: "What You Get:" - Lato Bold 14px #545252
    - Item: "✓ 1× Fast Bar Trial Pack" - checkmark #5B2E28
    
    Freebies Box:
    - Background: #FFF6EF
    - Border: 1px dashed #D68641, border-radius 0px
    - Padding: 16px
    - Heading: "🎁 FREE Worth ₹799" - Poppins SemiBold 16px #D68641
    - Items: "• 1× Keto Fresh Mug (₹799)"
    - Footer: "Limited stock bonuses" - italic 12px
    
    Pricing Section:
    Row 1: "Total Value: ₹1,398" - strikethrough, #999999, 18px
    Row 2: "Combo Price:" label 14px + "₹599" LARGE 44px Poppins Bold #5B2E28
    Row 3: Savings badge - pill shape, bg #D68641, white text "SAVE ₹799" 18px + "~57% OFF" 16px
    
    Urgency: "🔥 Only 12 combos left" - Lato 14px #FF4444
    
    CTA Button:
    "Add to Cart - ₹599"
    - Full width, height 56px
    - Background #5B2E28, text #FFFFFF Poppins SemiBold 18px
    - Border-radius: 0px
    - Hover: left-to-right fill #FFFFFF, text #5B2E28, 0.4s transition
    
    Details Link: "View Full Details >" - centered, #D68641, underlined
    
    COMBO CARD #2:
    Badge: "54% OFF"
    Image: EVOO 500ml bottle
    Name: "Hero Essentials #2"
    What You Get: "✓ 1× Aiwo EVOO (500ml)"
    Freebies: "🎁 FREE Worth ₹2,146" + "• 1× Measured Oil Bottle (₹349)"
    Pricing: Total ₹3,945 → Combo ₹1,799 → SAVE ₹2,146 (~54% OFF)
    Urgency: "⭐ Most Popular Choice" - #4CAF50
    CTA: "Add to Cart - ₹1,799"
    
    ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    CATEGORY 2: DOUBLE DHAMAKA DEALS (2 cards)
    ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    
    Category Header:
    - Background #D68641
    - Text: "Double Dhamaka Deals"
    - Subtitle: "2X Products, 3X Value!" - 16px lighter
    
    COMBO CARD #3:
    Badge: "DHAMAKA" - #FF6B35 background
    Image: 2× Fast Bar packs
    Name: "Double Dhamaka #3"
    What You Get: "✓ 2× Fast Bar Trial Packs"
    Freebies: "🎁 FREE Worth ₹2,347" + "• 1× Measured Oil Bottle • 1× Keto Fresh Mug"
    Pricing: Total ₹3,947 → Combo ₹1,199 → SAVE ₹2,748 (~70% OFF ⭐ HIGHEST SAVINGS)
    Urgency: "🔥 Only 8 combos left"
    CTA: "Add to Cart - ₹1,199"
    
    COMBO CARD #4:
    Badge: "57% OFF"
    Image: 2× EVOO bottles
    Name: "Double Dhamaka #4"
    What You Get: "✓ 2× Aiwo EVOO (500ml each)"
    Freebies: "🎁 FREE Worth ₹3,945" + "• 2× Measured Oil Bottles (different colours) • 1× Glass Herb Oil Maker"
    Pricing: Total ₹8,130 → Combo ₹3,499 → SAVE ₹4,631 (~57% OFF)
    CTA: "Add to Cart - ₹3,499"
    
    ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    CATEGORY 3: BUILD YOUR STACK (3 cards)
    ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    
    Category Header:
    - Background #D68641
    - Text: "Build Your Stack"
    - Subtitle: "Mix & Match for Maximum Benefits"
    
    Grid: First 2 cards in row 1, third card alone in row 2 (or all 3 in single row if width allows)
    
    COMBO CARD #5:
    Image: Fast Bar + EVOO together
    Name: "Build Your Stack #5"
    What You Get: "✓ 1× Fast Bar Trial Pack ✓ 1× Aiwo EVOO (500ml)"
    Freebies: "🎁 FREE Worth ₹3,345" + "• 1× Keto Fresh Mug • 1× Reusable Coffee Cup • 1× Measured Oil Bottle"
    Pricing: Total ₹6,743 → Combo ₹2,299 → SAVE ₹4,444 (~66% OFF)
    CTA: "Add to Cart - ₹2,299"
    
    COMBO CARD #6:
    Badge: "BEST VALUE" - gold
    Image: 2 Fast Bars + 1 EVOO
    Name: "Build Your Stack #6"
    What You Get: "✓ 2× Fast Bar Trial Packs ✓ 1× Aiwo EVOO (500ml)"
    Freebies: "🎁 FREE Worth ₹2,947" + "• 1× Measured Oil Bottle • 1× Keto Fresh Mug • 1× Reusable Coffee Cup"
    Pricing: Total ₹10,542 → Combo ₹2,999 → SAVE ₹7,543 (~72% OFF ⭐ BEST VALUE)
    CTA: "Add to Cart - ₹2,999"
    
    COMBO CARD #7:
    Image: 1 Fast Bar + 2 EVOO
    Name: "Build Your Stack #7"
    What You Get: "✓ 1× Fast Bar Trial Pack ✓ 2× Aiwo EVOO (500ml each)"
    Freebies: "🎁 FREE Worth ₹3,146" + "• 2× Measured Oil Bottles • 1× Glass Herb Oil Maker • 1× Keto Fresh Mug"
    Pricing: Total ₹9,438 → Combo ₹3,799 → SAVE ₹5,639 (~60% OFF)
    CTA: "Add to Cart - ₹3,799"
    
    ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    CATEGORY 4: PREMIUM POWERHOUSE (1 featured card)
    ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    
    Category Header:
    - Gradient background: linear-gradient(90deg, #FFD700, #D68641)
    - Text: "Premium Powerhouse Combo"
    - Subtitle: "Ultimate Transformation Package"
    
    COMBO CARD #8 - FULL WIDTH FEATURED:
    Special design: Spans full width (not 50% like others)
    Background: Subtle gradient #FFF9E6 to #FFFFFF
    Border: 3px solid #FFD700
    Padding: 48px (larger than standard)
    
    Badge: "⭐ BEST VALUE - MOST POPULAR" - larger, gold bg
    Image: All products together (400x40
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-combo-offers-{{ ai_gen_id }} {
    display: block;
    background-color: #FFFFFF;
    padding: 96px 20px;
  }

  .ai-combo-offers-container-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
  }

  .ai-combo-category-{{ ai_gen_id }} {
    margin-bottom: 64px;
  }

  .ai-combo-category-{{ ai_gen_id }}:last-child {
    margin-bottom: 0;
  }

  .ai-combo-category-header-{{ ai_gen_id }} {
    background-color: #D68641;
    padding: 20px;
    text-align: center;
    margin-bottom: 32px;
  }

  .ai-combo-category-header-{{ ai_gen_id }}.gradient {
    background: linear-gradient(90deg, #FFD700, #D68641);
  }

  .ai-combo-category-title-{{ ai_gen_id }} {
    font-family: 'Poppins', sans-serif;
    font-weight: 600;
    font-size: 28px;
    color: #FFFFFF;
    margin: 0;
  }

  .ai-combo-category-subtitle-{{ ai_gen_id }} {
    font-family: 'Poppins', sans-serif;
    font-size: 16px;
    color: #FFFFFF;
    margin: 8px 0 0 0;
    opacity: 0.9;
  }

  .ai-combo-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 32px;
  }

  .ai-combo-grid-{{ ai_gen_id }}.three-col {
    grid-template-columns: repeat(2, 1fr);
  }

  .ai-combo-grid-{{ ai_gen_id }}.three-col .ai-combo-card-{{ ai_gen_id }}:last-child {
    grid-column: 1 / -1;
    max-width: 600px;
    margin: 0 auto;
    width: 100%;
  }

  .ai-combo-card-{{ ai_gen_id }} {
    background-color: #FFFFFF;
    border: 1px solid #F2F2F2;
    padding: 32px;
    position: relative;
    transition: box-shadow 0.3s ease;
  }

  .ai-combo-card-{{ ai_gen_id }}:hover {
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
  }

  .ai-combo-card-{{ ai_gen_id }}.featured {
    background: linear-gradient(135deg, #FFF9E6 0%, #FFFFFF 100%);
    border: 3px solid #FFD700;
    padding: 48px;
  }

  .ai-combo-badge-{{ ai_gen_id }} {
    position: absolute;
    top: 16px;
    right: 16px;
    padding: 8px 16px;
    font-family: 'Poppins', sans-serif;
    font-weight: 600;
    font-size: 12px;
    z-index: 1;
  }

  .ai-combo-badge-{{ ai_gen_id }}.bestseller {
    background-color: #FFD700;
    color: #211E1E;
  }

  .ai-combo-badge-{{ ai_gen_id }}.discount {
    background-color: #5B2E28;
    color: #FFFFFF;
  }

  .ai-combo-badge-{{ ai_gen_id }}.dhamaka {
    background-color: #FF6B35;
    color: #FFFFFF;
  }

  .ai-combo-badge-{{ ai_gen_id }}.best-value {
    background-color: #FFD700;
    color: #211E1E;
    font-size: 14px;
  }

  .ai-combo-image-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 24px;
  }

  .ai-combo-image-{{ ai_gen_id }} img {
    max-width: 300px;
    height: auto;
  }

  .ai-combo-card-{{ ai_gen_id }}.featured .ai-combo-image-{{ ai_gen_id }} img {
    max-width: 400px;
  }

  .ai-combo-name-{{ ai_gen_id }} {
    font-family: 'Poppins', sans-serif;
    font-weight: 600;
    font-size: 24px;
    color: #211E1E;
    margin: 0 0 24px 0;
    text-align: center;
  }

  .ai-combo-what-you-get-{{ ai_gen_id }} {
    border-left: 4px solid #5B2E28;
    padding-left: 16px;
    margin-bottom: 20px;
  }

  .ai-combo-what-you-get-heading-{{ ai_gen_id }} {
    font-family: 'Lato', sans-serif;
    font-weight: 700;
    font-size: 14px;
    color: #545252;
    margin: 0 0 8px 0;
  }

  .ai-combo-what-you-get-item-{{ ai_gen_id }} {
    font-family: 'Lato', sans-serif;
    font-size: 14px;
    color: #211E1E;
    margin: 4px 0;
  }

  .ai-combo-what-you-get-item-{{ ai_gen_id }}::before {
    content: '✓ ';
    color: #5B2E28;
    font-weight: 700;
  }

  .ai-combo-freebies-{{ ai_gen_id }} {
    background-color: #FFF6EF;
    border: 1px dashed #D68641;
    padding: 16px;
    margin-bottom: 24px;
  }

  .ai-combo-freebies-heading-{{ ai_gen_id }} {
    font-family: 'Poppins', sans-serif;
    font-weight: 600;
    font-size: 16px;
    color: #D68641;
    margin: 0 0 8px 0;
  }

  .ai-combo-freebies-list-{{ ai_gen_id }} {
    font-family: 'Lato', sans-serif;
    font-size: 14px;
    color: #211E1E;
    margin: 0 0 8px 0;
  }

  .ai-combo-freebies-footer-{{ ai_gen_id }} {
    font-family: 'Lato', sans-serif;
    font-size: 12px;
    font-style: italic;
    color: #545252;
    margin: 0;
  }

  .ai-combo-pricing-{{ ai_gen_id }} {
    margin-bottom: 16px;
  }

  .ai-combo-total-value-{{ ai_gen_id }} {
    font-family: 'Lato', sans-serif;
    font-size: 18px;
    color: #999999;
    text-decoration: line-through;
    margin: 0 0 8px 0;
    text-align: center;
  }

  .ai-combo-price-row-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-bottom: 12px;
  }

  .ai-combo-price-label-{{ ai_gen_id }} {
    font-family: 'Lato', sans-serif;
    font-size: 14px;
    color: #545252;
  }

  .ai-combo-price-{{ ai_gen_id }} {
    font-family: 'Poppins', sans-serif;
    font-weight: 700;
    font-size: 44px;
    color: #5B2E28;
  }

  .ai-combo-savings-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-bottom: 16px;
  }

  .ai-combo-savings-badge-{{ ai_gen_id }} {
    background-color: #D68641;
    color: #FFFFFF;
    padding: 8px 16px;
    border-radius: 20px;
    font-family: 'Poppins', sans-serif;
    font-weight: 600;
    font-size: 18px;
  }

  .ai-combo-savings-percent-{{ ai_gen_id }} {
    font-family: 'Poppins', sans-serif;
    font-weight: 600;
    font-size: 16px;
    color: #D68641;
  }

  .ai-combo-urgency-{{ ai_gen_id }} {
    font-family: 'Lato', sans-serif;
    font-size: 14px;
    text-align: center;
    margin-bottom: 20px;
  }

  .ai-combo-urgency-{{ ai_gen_id }}.red {
    color: #FF4444;
  }

  .ai-combo-urgency-{{ ai_gen_id }}.green {
    color: #4CAF50;
  }

  .ai-combo-cta-{{ ai_gen_id }} {
    width: 100%;
    height: 56px;
    background-color: #5B2E28;
    color: #FFFFFF;
    font-family: 'Poppins', sans-serif;
    font-weight: 600;
    font-size: 18px;
    border: none;
    cursor: pointer;
    position: relative;
    overflow: hidden;
    transition: color 0.4s ease;
    margin-bottom: 16px;
  }

  .ai-combo-cta-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background-color: #FFFFFF;
    transition: left 0.4s ease;
    z-index: 0;
  }

  .ai-combo-cta-{{ ai_gen_id }}:hover::before {
    left: 0;
  }

  .ai-combo-cta-{{ ai_gen_id }}:hover {
    color: #5B2E28;
  }

  .ai-combo-cta-{{ ai_gen_id }} span {
    position: relative;
    z-index: 1;
  }

  .ai-combo-details-link-{{ ai_gen_id }} {
    display: block;
    text-align: center;
    font-family: 'Lato', sans-serif;
    font-size: 14px;
    color: #D68641;
    text-decoration: underline;
  }

  @media screen and (max-width: 768px) {
    .ai-combo-offers-{{ ai_gen_id }} {
      padding: 48px 16px;
    }

    .ai-combo-grid-{{ ai_gen_id }},
    .ai-combo-grid-{{ ai_gen_id }}.three-col {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .ai-combo-grid-{{ ai_gen_id }}.three-col .ai-combo-card-{{ ai_gen_id }}:last-child {
      grid-column: 1;
      max-width: 100%;
    }

    .ai-combo-category-title-{{ ai_gen_id }} {
      font-size: 22px;
    }

    .ai-combo-category-subtitle-{{ ai_gen_id }} {
      font-size: 14px;
    }

    .ai-combo-card-{{ ai_gen_id }} {
      padding: 24px;
    }

    .ai-combo-card-{{ ai_gen_id }}.featured {
      padding: 32px;
    }

    .ai-combo-name-{{ ai_gen_id }} {
      font-size: 20px;
    }

    .ai-combo-price-{{ ai_gen_id }} {
      font-size: 36px;
    }
  }
{% endstyle %}

