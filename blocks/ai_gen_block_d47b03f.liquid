{% doc %}
  @prompt
    Design a minimal, premium summary stats section for a luxury extra virgin olive oil brand (“AIWO Olive Aura”). The goal is to highlight key lab-verified metrics—purity, freshness, and longevity—using bold typography and balanced spacing.
    
    Layout:
    
    Four key values aligned horizontally (centered grid).
    
    Each value includes:
    
    A large, bold metric (number + unit).
    
    A subtle caption below describing what it represents.
    
    Equal spacing and alignment between each block.
    
    Responsive: on mobile, stack in 2×2 grid or 1×4 vertical layout.
    
    Example Content:
    
    Metric	Caption
    0.16%	Acidity (80% below limit)
    6 meq/kg	Peroxide (70% below limit)
    250+	Pesticides tested: None detected
    23 Months	Shelf life (lab-verified)
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-stats-section-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding_top }}px 20px {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-stats-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
  }

  .ai-stats-heading-{{ ai_gen_id }} {
    text-align: center;
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    font-weight: {{ block.settings.heading_weight }};
    letter-spacing: {{ block.settings.heading_letter_spacing }}px;
  }

  .ai-stats-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    margin: 0;
  }

  .ai-stats-item-{{ ai_gen_id }} {
    text-align: center;
    padding: {{ block.settings.item_padding }}px;
    background-color: {{ block.settings.item_background }};
    border-radius: {{ block.settings.item_border_radius }}px;
    border: {{ block.settings.item_border_width }}px solid {{ block.settings.item_border_color }};
  }

  .ai-stats-metric-{{ ai_gen_id }} {
    display: block;
    font-size: {{ block.settings.metric_size }}px;
    font-weight: {{ block.settings.metric_weight }};
    color: {{ block.settings.metric_color }};
    line-height: 1.2;
    margin: 0 0 {{ block.settings.metric_spacing }}px;
    letter-spacing: {{ block.settings.metric_letter_spacing }}px;
  }

  .ai-stats-caption-{{ ai_gen_id }} {
    display: block;
    font-size: {{ block.settings.caption_size }}px;
    font-weight: {{ block.settings.caption_weight }};
    color: {{ block.settings.caption_color }};
    line-height: 1.5;
    margin: 0;
    letter-spacing: {{ block.settings.caption_letter_spacing }}px;
  }

  @media screen and (max-width: 989px) {
    .ai-stats-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
      gap: {{ block.settings.grid_gap_mobile }}px;
    }

    .ai-stats-metric-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.metric_size }}px * 0.85);
    }

    .ai-stats-caption-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.caption_size }}px * 0.9);
    }

    .ai-stats-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.85);
      margin-bottom: {{ block.settings.heading_spacing | times: 0.7 }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-stats-section-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top | times: 0.7 }}px 16px {{ block.settings.section_padding_bottom | times: 0.7 }}px;
    }

    .ai-stats-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }

    .ai-stats-item-{{ ai_gen_id }} {
      padding: {{ block.settings.item_padding | times: 0.8 }}px;
    }

    .ai-stats-metric-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.metric_size }}px * 0.7);
      margin-bottom: {{ block.settings.metric_spacing | times: 0.8 }}px;
    }

    .ai-stats-caption-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.caption_size }}px * 0.85);
    }

    .ai-stats-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.7);
      margin-bottom: {{ block.settings.heading_spacing | times: 0.6 }}px;
    }
  }
{% endstyle %}

<div class="ai-stats-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-stats-container-{{ ai_gen_id }}">
    {% if block.settings.section_heading != blank %}
      <h2 class="ai-stats-heading-{{ ai_gen_id }}">{{ block.settings.section_heading }}</h2>
    {% endif %}

    <div class="ai-stats-grid-{{ ai_gen_id }}">
      {% if block.settings.stat_1_enabled %}
        <div class="ai-stats-item-{{ ai_gen_id }}">
          <span class="ai-stats-metric-{{ ai_gen_id }}">{{ block.settings.stat_1_metric }}</span>
          <span class="ai-stats-caption-{{ ai_gen_id }}">{{ block.settings.stat_1_caption }}</span>
        </div>
      {% endif %}

      {% if block.settings.stat_2_enabled %}
        <div class="ai-stats-item-{{ ai_gen_id }}">
          <span class="ai-stats-metric-{{ ai_gen_id }}">{{ block.settings.stat_2_metric }}</span>
          <span class="ai-stats-caption-{{ ai_gen_id }}">{{ block.settings.stat_2_caption }}</span>
        </div>
      {% endif %}

      {% if block.settings.stat_3_enabled %}
        <div class="ai-stats-item-{{ ai_gen_id }}">
          <span class="ai-stats-metric-{{ ai_gen_id }}">{{ block.settings.stat_3_metric }}</span>
          <span class="ai-stats-caption-{{ ai_gen_id }}">{{ block.settings.stat_3_caption }}</span>
        </div>
      {% endif %}

      {% if block.settings.stat_4_enabled %}
        <div class="ai-stats-item-{{ ai_gen_id }}">
          <span class="ai-stats-metric-{{ ai_gen_id }}">{{ block.settings.stat_4_metric }}</span>
          <span class="ai-stats-caption-{{ ai_gen_id }}">{{ block.settings.stat_4_caption }}</span>
        </div>
      {% endif %}
    </div>
  </div>
</div>

