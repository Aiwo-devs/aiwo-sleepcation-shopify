    "faq_4JhpGN": {
      "type": "faq",
      "blocks": {
        "frequently_asked_question_EP64mk": {
          "type": "frequently_asked_question",
          "settings": {
            "icon": "heart",
            "another_icon": "",
            "custom_icon": "",
            "heading": "What exactly does the AIWO 100 test cover?",
            "row_content": "<p>The AIWO 100 panel checks over 100 health markers, including cardiac health, liver and kidney function, diabetes risk, vitamins, minerals, thyroid hormones, food intolerances, and metabolic health.</p>"
          }
        },
        "frequently_asked_question_mK4jQW": {
          "type": "frequently_asked_question",
          "settings": {
            "icon": "heart",
            "another_icon": "",
            "custom_icon": "",
            "heading": "How is this different from a regular full-body health checkup?",
            "row_content": "<p>Most traditional checkups are either surface-level or focus only on disease detection. AIWO 100 gives you deep insights, flags early imbalances, and includes food sensitivity testing and a doctor consultation — all under one price.</p>"
          }
        },
        "frequently_asked_question_6d9PWy": {
          "type": "frequently_asked_question",
          "settings": {
            "icon": "heart",
            "another_icon": "",
            "custom_icon": "",
            "heading": "How long does the test take and what is the process?",
            "row_content": "<p>The sample collection usually takes 20–30 minutes. You’ll be contacted for a convenient time slot, and once your samples are processed, your report is delivered digitally within 48–72 hours.</p>"
          }
        },
        "frequently_asked_question_q6cWXm": {
          "type": "frequently_asked_question",
          "settings": {
            "icon": "heart",
            "another_icon": "",
            "custom_icon": "",
            "heading": "Is fasting required before the test?",
            "row_content": "<p>Yes, we recommend fasting for <strong>10–12 hours</strong> before the test for the most accurate readings, especially for sugar, lipid, and insulin-related markers.</p>"
          }
        },
        "frequently_asked_question_xrTpVV": {
          "type": "frequently_asked_question",
          "settings": {
            "icon": "heart",
            "another_icon": "",
            "custom_icon": "",
            "heading": "Can I consult with a doctor about my report?",
            "row_content": "<p>Yes. A <strong>complimentary doctor consultation</strong> is included. You’ll get personalized feedback and recommendations based on your results.</p>"
          }
        },
        "frequently_asked_question_WGBEQg": {
          "type": "frequently_asked_question",
          "settings": {
            "icon": "heart",
            "another_icon": "",
            "custom_icon": "",
            "heading": "How often should I take the AIWO 100?",
            "row_content": "<p>We recommend doing this test <strong>every 6–12 months</strong> for preventive tracking, especially if you're managing stress, diet changes, or lifestyle upgrades.</p>"
          }
        },
        "frequently_asked_question_PwHBUR": {
          "type": "frequently_asked_question",
          "settings": {
            "icon": "heart",
            "another_icon": "",
            "custom_icon": "",
            "heading": "Can I share this report with my own physician?",
            "row_content": "<p>Absolutely. The digital report is easy to download and share. It’s formatted in a medically recognized structure for any external consultation.</p>"
          }
        }
      },
      "block_order": [
