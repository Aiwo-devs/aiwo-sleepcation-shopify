{% doc %}
  @prompt
    Design a premium “Independent Proof of Excellence” section for a luxury food brand (Extra Virgin Olive Oil).
    
    Layout:
    
    Background: olive-green diagonal striped pattern with subtle gradient and depth.
    
    Centered heading in bold white text:
    “Independent Proof of Excellence”
    
    Sub-text below heading (smaller white text):
    “NABL-certified laboratory results dated 16-Jan-2025. Complete transparency you can verify.”
    
    Main Metrics Grid:
    
    Four large, rounded rectangular cards (2×2 grid on desktop, stacked on mobile).
    
    Each card has a slightly transparent dark overlay and white text for contrast.
    
    Icon at the top (yellow/golden line icon) representing the metric.
    
    Metric name in medium text.
    
    Value in large bold numeric font (white).
    
    Sub-label below in smaller muted white text.
    
    Example Metrics:
    
    ⚡ Free Acidity — “0.16%” → “80% below 0.80% limit”
    
    🛡️ Peroxide Value — “6 meq O₂/kg” → “70% below 20 limit”
    
    ✅ PPP Freshness — “2.1%” → “≪ 17% benchmark”
    
    ❤️ Heart-Friendly — “~ 68.5%” → “MUFA content”
    
    Additional Highlights (Bottom Row):
    
    Three centered small feature icons with text underneath:
    
    ✅ No Pesticides — “250-residue screen clear”
    
    ✅ PAH-4 Safe — “< 2 µg/kg”
    
    ✅ 23 Months Shelf Life — “OSI 24.3 h stability”
    
    Style Guide:
    
    Font: modern sans-serif (e.g., Lato / Nunito / Poppins).
    
    Colors:
    
    Background olive (#5B6A2F / #6E7B36 gradient)
    
    Icons gold (#FFD65A)
    
    Text white (#FFFFFF)
    
    Card overlay rgba(255, 255, 255, 0.05 – 0.08)
    
    Rounded corners (16 px), subtle shadow for cards.
    
    Hover effect: slight lift and brighter icon glow.
    
    Layout must be responsive and balanced for desktop and mobile screens.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-proof-excellence-{{ ai_gen_id }} {
    position: relative;
    padding: 80px 20px;
    overflow: hidden;
    background: linear-gradient(135deg, {{ block.settings.bg_color_1 }} 0%, {{ block.settings.bg_color_2 }} 100%);
  }

  .ai-proof-excellence-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: 
      repeating-linear-gradient(
        45deg,
        transparent,
        transparent 35px,
        rgba(255, 255, 255, 0.03) 35px,
        rgba(255, 255, 255, 0.03) 70px
      );
    pointer-events: none;
  }

  .ai-proof-excellence-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  .ai-proof-excellence-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 60px;
  }

  .ai-proof-excellence-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 700;
    color: {{ block.settings.heading_color }};
    margin: 0 0 16px;
    letter-spacing: 0.5px;
  }

  .ai-proof-excellence-subtext-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtext_size }}px;
    color: {{ block.settings.subtext_color }};
    max-width: 700px;
    margin: 0 auto;
    line-height: 1.6;
    opacity: 0.95;
  }

  .ai-proof-excellence-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    margin-bottom: 50px;
  }

  .ai-proof-excellence-card-{{ ai_gen_id }} {
    background: {{ block.settings.card_overlay }};
    border-radius: {{ block.settings.card_radius }}px;
    padding: 32px 24px;
    text-align: center;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
    backdrop-filter: blur(10px);
  }

  .ai-proof-excellence-card-{{ ai_gen_id }}:hover {
    transform: translateY(-8px);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.25);
  }

  .ai-proof-excellence-card-{{ ai_gen_id }}:hover .ai-proof-excellence-icon-{{ ai_gen_id }} {
    filter: drop-shadow(0 0 12px {{ block.settings.icon_color }});
  }

  .ai-proof-excellence-icon-{{ ai_gen_id }} {
    width: 48px;
    height: 48px;
    margin: 0 auto 20px;
    transition: filter 0.3s ease;
  }

  .ai-proof-excellence-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    stroke: {{ block.settings.icon_color }};
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .ai-proof-excellence-metric-name-{{ ai_gen_id }} {
    font-size: 16px;
    color: {{ block.settings.card_text_color }};
    margin: 0 0 12px;
    font-weight: 500;
    opacity: 0.9;
  }

  .ai-proof-excellence-metric-value-{{ ai_gen_id }} {
    font-size: {{ block.settings.value_size }}px;
    font-weight: 700;
    color: {{ block.settings.card_text_color }};
    margin: 0 0 8px;
    line-height: 1.2;
  }

  .ai-proof-excellence-metric-sublabel-{{ ai_gen_id }} {
    font-size: 13px;
    color: {{ block.settings.card_text_color }};
    opacity: 0.75;
    margin: 0;
  }

  .ai-proof-excellence-highlights-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 40px;
    flex-wrap: wrap;
    margin-top: 40px;
  }

  .ai-proof-excellence-highlight-{{ ai_gen_id }} {
    text-align: center;
    max-width: 200px;
  }

  .ai-proof-excellence-highlight-icon-{{ ai_gen_id }} {
    width: 32px;
    height: 32px;
    margin: 0 auto 12px;
  }

  .ai-proof-excellence-highlight-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    stroke: {{ block.settings.icon_color }};
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .ai-proof-excellence-highlight-text-{{ ai_gen_id }} {
    font-size: 15px;
    color: {{ block.settings.heading_color }};
    font-weight: 600;
    margin: 0 0 4px;
  }

  .ai-proof-excellence-highlight-desc-{{ ai_gen_id }} {
    font-size: 13px;
    color: {{ block.settings.subtext_color }};
    opacity: 0.85;
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-proof-excellence-{{ ai_gen_id }} {
      padding: 60px 16px;
    }

    .ai-proof-excellence-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
    }

    .ai-proof-excellence-subtext-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtext_size | times: 0.9 }}px;
    }

    .ai-proof-excellence-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .ai-proof-excellence-card-{{ ai_gen_id }} {
      padding: 24px 20px;
    }

    .ai-proof-excellence-metric-value-{{ ai_gen_id }} {
      font-size: {{ block.settings.value_size | times: 0.8 }}px;
    }

    .ai-proof-excellence-highlights-{{ ai_gen_id }} {
      gap: 30px;
    }
  }
{% endstyle %}

<div class="ai-proof-excellence-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-proof-excellence-container-{{ ai_gen_id }}">
    <div class="ai-proof-excellence-header-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h2 class="ai-proof-excellence-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {% endif %}
      {% if block.settings.subtext != blank %}
        <div class="ai-proof-excellence-subtext-{{ ai_gen_id }}">{{ block.settings.subtext }}</div>
      {% endif %}
    </div>

    <div class="ai-proof-excellence-grid-{{ ai_gen_id }}">
      {% if block.settings.metric_1_enabled %}
        <div class="ai-proof-excellence-card-{{ ai_gen_id }}">
          <div class="ai-proof-excellence-icon-{{ ai_gen_id }}">
            <svg viewBox="0 0 24 24">
              <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
            </svg>
          </div>
          <div class="ai-proof-excellence-metric-name-{{ ai_gen_id }}">{{ block.settings.metric_1_name }}</div>
          <div class="ai-proof-excellence-metric-value-{{ ai_gen_id }}">{{ block.settings.metric_1_value }}</div>
          <div class="ai-proof-excellence-metric-sublabel-{{ ai_gen_id }}">{{ block.settings.metric_1_sublabel }}</div>
        </div>
      {% endif %}

      {% if block.settings.metric_2_enabled %}
        <div class="ai-proof-excellence-card-{{ ai_gen_id }}">
          <div class="ai-proof-excellence-icon-{{ ai_gen_id }}">
            <svg viewBox="0 0 24 24">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
          </div>
          <div class="ai-proof-excellence-metric-name-{{ ai_gen_id }}">{{ block.settings.metric_2_name }}</div>
          <div class="ai-proof-excellence-metric-value-{{ ai_gen_id }}">{{ block.settings.metric_2_value }}</div>
          <div class="ai-proof-excellence-metric-sublabel-{{ ai_gen_id }}">{{ block.settings.metric_2_sublabel }}</div>
        </div>
      {% endif %}

      {% if block.settings.metric_3_enabled %}
        <div class="ai-proof-excellence-card-{{ ai_gen_id }}">
          <div class="ai-proof-excellence-icon-{{ ai_gen_id }}">
            <svg viewBox="0 0 24 24">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </div>
          <div class="ai-proof-excellence-metric-name-{{ ai_gen_id }}">{{ block.settings.metric_3_name }}</div>
          <div class="ai-proof-excellence-metric-value-{{ ai_gen_id }}">{{ block.settings.metric_3_value }}</div>
          <div class="ai-proof-excellence-metric-sublabel-{{ ai_gen_id }}">{{ block.settings.metric_3_sublabel }}</div>
        </div>
      {% endif %}

      {% if block.settings.metric_4_enabled %}
        <div class="ai-proof-excellence-card-{{ ai_gen_id }}">
          <div class="ai-proof-excellence-icon-{{ ai_gen_id }}">
            <svg viewBox="0 0 24 24">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
            </svg>
          </div>
          <div class="ai-proof-excellence-metric-name-{{ ai_gen_id }}">{{ block.settings.metric_4_name }}</div>
          <div class="ai-proof-excellence-metric-value-{{ ai_gen_id }}">{{ block.settings.metric_4_value }}</div>
          <div class="ai-proof-excellence-metric-sublabel-{{ ai_gen_id }}">{{ block.settings.metric_4_sublabel }}</div>
        </div>
      {% endif %}
    </div>

    <div class="ai-proof-excellence-highlights-{{ ai_gen_id }}">
      {% if block.settings.highlight_1_enabled %}
        <div class="ai-proof-excellence-highlight-{{ ai_gen_id }}">
          <div class="ai-proof-excellence-highlight-icon-{{ ai_gen_id }}">
            <svg viewBox="0 0 24 24">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </div>
          <div class="ai-proof-excellence-highlight-text-{{ ai_gen_id }}">{{ block.settings.highlight_1_title }}</div>
          <div class="ai-proof-excellence-highlight-desc-{{ ai_gen_id }}">{{ block.settings.highlight_1_desc }}</div>
        </div>
      {% endif %}

      {% if block.settings.highlight_2_enabled %}
        <div class="ai-proof-excellence-highlight-{{ ai_gen_id }}">
          <div class="ai-proof-excellence-highlight-icon-{{ ai_gen_id }}">
            <svg viewBox="0 0 24 24">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </div>
          <div class="ai-proof-excellence-highlight-text-{{ ai_gen_id }}">{{ block.settings.highlight_2_title }}</div>
          <div class="ai-proof-excellence-highlight-desc-{{ ai_gen_id }}">{{ block.settings.highlight_2_desc }}</div>
        </div>
      {% endif %}

      {% if block.settings.highlight_3_enabled %}
        <div class="ai-proof-excellence-highlight-{{ ai_gen_id }}">
          <div class="ai-proof-excellence-highlight-icon-{{ ai_gen_id }}">
            <svg viewBox="0 0 24 24">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </div>
          <div class="ai-proof-excellence-highlight-text-{{ ai_gen_id }}">{{ block.settings.highlight_3_title }}</div>
          <div class="ai-proof-excellence-highlight-desc-{{ ai_gen_id }}">{{ block.settings.highlight_3_desc }}</div>
        </div>
      {% endif %}
    </div>
  </div>
</div>

