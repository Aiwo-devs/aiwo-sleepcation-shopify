{% schema %}
{
  "name": "How to use instructions",
  "settings": [
    {
      "type": "header",
      "content": "Section settings"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#F6F6F6"
    },
    {
      "type": "range",
      "id": "section_padding_desktop",
      "min": 20,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "Desktop padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "section_padding_mobile",
      "min": 20,
      "max": 80,
      "step": 10,
      "unit": "px",
      "label": "Mobile padding",
      "default": 40
    },
    {
      "type": "header",
      "content": "Badge"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "Usage Instructions"
    },
    {
      "type": "color",
      "id": "badge_color",
      "label": "Badge background",
      "default": "#FFD740"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Badge text",
      "default": "#000000"
    },
    {
