{% doc %}
  @prompt
    Design a "Why Choose" benefits section for AIWO Ultimate Omega 3.
    
    **Layout:**
    Centered section, white background, full-width container with max-width constraint.
    
    **Header:**
    - Yellow pill badge at top: "Science-Backed Benefits"
    - Main heading (bold, large black): "Why Choose AIWO ULTIMATE OMEGA 3?"
    - Subheading (gray, centered): "Our triple strength formula with advanced Enteric Coating technology delivers 1000mg of premium omega-3 fatty acids with proven cardio protective and anti-inflammatory benefits."
    
    **Benefits Cards (4 columns in a row):**
    
    **Card 1 - Cardio Protective Effects**
    - Deep blue circle icon with white heart icon
    - Bold heading: "Cardio Protective Effects"
    - Gray text: "Demonstrates vasodilation, anti-arrhythmic, antioxidant and anti-inflammatory properties for comprehensive heart protection."
    - Bottom link: "Cardio protection studies" (small, underlined)
    
    **Card 2 - Brain Health Support**
    - Deep blue circle icon with white brain icon
    - Bold heading: "Brain Health Support"
    - Gray text: "38% DHA content supports cognitive function, memory, and overall brain health throughout life."
    - Bottom link: "Brain health research"
    
    **Card 3 - Anti-Inflammatory Action**
    - Deep blue circle icon with white eye icon
    - Bold heading: "Anti-Inflammatory Action"
    - Gray text: "Powerful anti-inflammatory properties help reduce systemic inflammation and support joint health."
    - Bottom link: "Inflammation studies"
    
    **Card 4 - Antioxidant Protection**
    - Deep blue circle icon with white shield icon
    - Bold heading: "Antioxidant Protection"
    - Gray text: "Provides antioxidant effects that protect cells from oxidative stress and free radical damage."
    - Bottom link: "Antioxidant research"
    
    **Card Styling:**
    White background, subtle border, rounded corners, equal height, hover lift effect, centered content, generous padding.
    
    **Responsive:** 4 columns on desktop, 2 columns on tablet, 1 column on mobile., Remove the links in 4 cards and link taxt showned be a badge with white background & black stroke
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-benefits-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding_top }}px 20px {{ block.settings.section_padding_bottom }}px;
  }

  .ai-benefits-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_max_width }}px;
    margin: 0 auto;
  }

  .ai-benefits-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-benefits-badge-{{ ai_gen_id }} {
    display: inline-block;
    background-color: {{ block.settings.badge_bg_color }};
    color: {{ block.settings.badge_text_color }};
    padding: 8px 20px;
    border-radius: 50px;
    font-size: {{ block.settings.badge_font_size }}px;
    font-weight: 600;
    margin-bottom: 20px;
  }

  .ai-benefits-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_font_size }}px;
    font-weight: 700;
    color: {{ block.settings.heading_color }};
    margin: 0 0 16px;
    line-height: 1.2;
  }

  .ai-benefits-subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_font_size }}px;
    color: {{ block.settings.subheading_color }};
    max-width: 900px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .ai-benefits-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: {{ block.settings.card_gap }}px;
    margin-top: {{ block.settings.grid_spacing }}px;
  }

  .ai-benefits-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_bg_color }};
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    text-align: center;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .ai-benefits-card-{{ ai_gen_id }}:hover {
    transform: translateY(-{{ block.settings.card_hover_lift }}px);
    box-shadow: 0 {{ block.settings.card_hover_lift | times: 2 }}px {{ block.settings.card_hover_lift | times: 4 }}px rgba(0, 0, 0, 0.1);
  }

  .ai-benefits-icon-wrapper-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    background-color: {{ block.settings.icon_bg_color }};
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 24px;
    flex-shrink: 0;
  }

  .ai-benefits-icon-wrapper-{{ ai_gen_id }} svg {
    width: {{ block.settings.icon_size | times: 0.5 }}px;
    height: {{ block.settings.icon_size | times: 0.5 }}px;
    stroke: {{ block.settings.icon_color }};
    fill: none;
  }

  .ai-benefits-card-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_heading_font_size }}px;
    font-weight: 700;
    color: {{ block.settings.card_heading_color }};
    margin: 0 0 12px;
    line-height: 1.3;
  }

  .ai-benefits-card-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_text_font_size }}px;
    color: {{ block.settings.card_text_color }};
    line-height: 1.6;
    margin: 0 0 20px;
    flex-grow: 1;
  }

  .ai-benefits-card-badge-{{ ai_gen_id }} {
    display: inline-block;
    background-color: {{ block.settings.card_badge_bg_color }};
    color: {{ block.settings.card_badge_text_color }};
    border: {{ block.settings.card_badge_border_width }}px solid {{ block.settings.card_badge_border_color }};
    padding: 6px 16px;
    border-radius: 20px;
    font-size: {{ block.settings.card_badge_font_size }}px;
    font-weight: 500;
  }

  @media screen and (max-width: 989px) {
    .ai-benefits-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }

    .ai-benefits-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_font_size | times: 0.8 }}px;
    }

    .ai-benefits-subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_font_size | times: 0.9 }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-benefits-section-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top | times: 0.7 }}px 16px {{ block.settings.section_padding_bottom | times: 0.7 }}px;
    }

    .ai-benefits-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.card_gap | times: 0.8 }}px;
    }

    .ai-benefits-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_font_size | times: 0.7 }}px;
    }

    .ai-benefits-subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_font_size | times: 0.85 }}px;
    }

    .ai-benefits-card-{{ ai_gen_id }} {
      padding: {{ block.settings.card_padding | times: 0.8 }}px;
    }
  }
{% endstyle %}

<ai-benefits-section-{{ ai_gen_id }} class="ai-benefits-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-benefits-container-{{ ai_gen_id }}">
    <div class="ai-benefits-header-{{ ai_gen_id }}">
      {% if block.settings.show_badge %}
        <div class="ai-benefits-badge-{{ ai_gen_id }}">
          {{ block.settings.badge_text }}
        </div>
      {% endif %}
      
      {% if block.settings.heading != blank %}
        <h2 class="ai-benefits-heading-{{ ai_gen_id }}">
          {{ block.settings.heading }}
        </h2>
      {% endif %}
      
      {% if block.settings.subheading != blank %}
        <div class="ai-benefits-subheading-{{ ai_gen_id }}">
          {{ block.settings.subheading }}
        </div>
      {% endif %}
    </div>

    <div class="ai-benefits-grid-{{ ai_gen_id }}">
      {% if block.settings.card_1_enabled %}
        <div class="ai-benefits-card-{{ ai_gen_id }}">
          <div class="ai-benefits-icon-wrapper-{{ ai_gen_id }}">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
            </svg>
          </div>
          <h3 class="ai-benefits-card-heading-{{ ai_gen_id }}">
            {{ block.settings.card_1_heading }}
          </h3>
          <p class="ai-benefits-card-text-{{ ai_gen_id }}">
            {{ block.settings.card_1_text }}
          </p>
          {% if block.settings.card_1_badge_text != blank %}
            <span class="ai-benefits-card-badge-{{ ai_gen_id }}">
              {{ block.settings.card_1_badge_text }}
            </span>
          {% endif %}
        </div>
      {% endif %}

      {% if block.settings.card_2_enabled %}
        <div class="ai-benefits-card-{{ ai_gen_id }}">
          <div class="ai-benefits-icon-wrapper-{{ ai_gen_id }}">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9.5 2A2.5 2.5 0 0 1 12 4.5v15a2.5 2.5 0 0 1-4.96.44 2.5 2.5 0 0 1-2.96-3.08 3 3 0 0 1-.34-5.58 2.5 2.5 0 0 1 1.32-4.24 2.5 2.5 0 0 1 1.98-3A2.5 2.5 0 0 1 9.5 2Z"></path>
              <path d="M14.5 2A2.5 2.5 0 0 0 12 4.5v15a2.5 2.5 0 0 0 4.96.44 2.5 2.5 0 0 0 2.96-3.08 3 3 0 0 0 .34-5.58 2.5 2.5 0 0 0-1.32-4.24 2.5 2.5 0 0 0-1.98-3A2.5 2.5 0 0 0 14.5 2Z"></path>
            </svg>
          </div>
          <h3 class="ai-benefits-card-heading-{{ ai_gen_id }}">
            {{ block.settings.card_2_heading }}
          </h3>
          <p class="ai-benefits-card-text-{{ ai_gen_id }}">
            {{ block.settings.card_2_text }}
          </p>
          {% if block.settings.card_2_badge_text != blank %}
            <span class="ai-benefits-card-badge-{{ ai_gen_id }}">
              {{ block.settings.card_2_badge_text }}
            </span>
          {% endif %}
        </div>
      {% endif %}

      {% if block.settings.card_3_enabled %}
        <div class="ai-benefits-card-{{ ai_gen_id }}">
          <div class="ai-benefits-icon-wrapper-{{ ai_gen_id }}">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
              <circle cx="12" cy="12" r="3"></circle>
            </svg>
          </div>
          <h3 class="ai-benefits-card-heading-{{ ai_gen_id }}">
            {{ block.settings.card_3_heading }}
          </h3>
          <p class="ai-benefits-card-text-{{ ai_gen_id }}">
            {{ block.settings.card_3_text }}
          </p>
          {% if block.settings.card_3_badge_text != blank %}
