<style>
  .aiwo-evoo-v3-bc {
    width: 100%;
    padding: 14px 20px;
    font-family: 'Outfit', sans-serif !important;
  }
  .aiwo-evoo-v3-bc__inner {
    display: flex;
    align-items: center;
    gap: 8px;
    max-width: 1400px;
    margin: 0 auto;
  }
  .aiwo-evoo-v3-bc__arrow {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    color: #0C0C0D;
    text-decoration: none;
    line-height: 1;
  }
  .aiwo-evoo-v3-bc__link {
    font-size: 14px;
    font-weight: 400;
    color: #0C0C0D;
    text-decoration: none;
  }
  .aiwo-evoo-v3-bc__sep {
    font-size: 14px;
    font-weight: 400;
    color: #0C0C0D;
    user-select: none;
  }
  .aiwo-evoo-v3-bc__current {
    font-size: 14px;
    font-weight: 600;
    color: #0C0C0D;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>

<nav class="aiwo-evoo-v3-bc" role="navigation" aria-label="Breadcrumb">
  <div class="aiwo-evoo-v3-bc__inner">
    <a href="{{ routes.root_url }}" class="aiwo-evoo-v3-bc__arrow" aria-label="Back to Home">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M4.92812 12.0018H20.4845" stroke="#1A1A1A" stroke-width="1.5" stroke-linecap="round"/>
        <path d="M8.55686 16.8585C8.55686 16.8585 4.23754 13.2107 4.23754 12.0017C4.23753 10.7927 8.5569 7.14499 8.5569 7.14499" stroke="#1A1A1A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>
    <a href="{{ routes.root_url }}" class="aiwo-evoo-v3-bc__link">Home</a>
    <span class="aiwo-evoo-v3-bc__sep" aria-hidden="true"> / </span>
    <span class="aiwo-evoo-v3-bc__current" aria-current="page">
      {%- if template contains 'collection' -%}
        {{ collection.title | escape }}
      {%- elsif template contains 'product' -%}
        {{ product.title | escape }}
      {%- else -%}
        {{ page_title | escape }}
      {%- endif -%}
    </span>
  </div>
</nav>
