              {{ block.settings.card_3_badge_text }}
            </span>
          {% endif %}
        </div>
      {% endif %}

      {% if block.settings.card_4_enabled %}
        <div class="ai-benefits-card-{{ ai_gen_id }}">
          <div class="ai-benefits-icon-wrapper-{{ ai_gen_id }}">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
          </div>
          <h3 class="ai-benefits-card-heading-{{ ai_gen_id }}">
            {{ block.settings.card_4_heading }}
          </h3>
          <p class="ai-benefits-card-text-{{ ai_gen_id }}">
            {{ block.settings.card_4_text }}
          </p>
          {% if block.settings.card_4_badge_text != blank %}
            <span class="ai-benefits-card-badge-{{ ai_gen_id }}">
              {{ block.settings.card_4_badge_text }}
            </span>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</ai-benefits-section-{{ ai_gen_id }}>

<script>
  (function() {
    class AiBenefitsSection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }
    }

    customElements.define('ai-benefits-section-{{ ai_gen_id }}', AiBenefitsSection{{ ai_gen_id }});
  })();
</script>

