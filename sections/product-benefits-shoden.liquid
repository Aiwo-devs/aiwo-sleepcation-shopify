<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,wght@0,300;0,400;0,600;1,300;1,400;1,600&family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>
  .shoden-s {
    font-family: 'Outfit', sans-serif;
    color: #1a1a1a;
    line-height: 1.5;
  }
  .shoden-s *, .shoden-s *::before, .shoden-s *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }
  .shoden-s img { display: block; }
  .shoden-wrap {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  /* ================================================================
     SECTION 1 — INGREDIENT COMPARISON (kept from previous)
     ================================================================ */
  .shoden-ingredient {
    background: #f9f6f1;
    padding: 60px 0 0;
    position: relative;
    overflow: hidden;
  }
  .shoden-ingredient__tag {
    display: inline-block;
    border: 1px solid #999;
    border-radius: 4px;
    padding: 6px 16px;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: #555;
    margin-bottom: 20px;
  }
  .shoden-ingredient__title {
    font-family: 'Outfit', sans-serif;
    font-size: 42px;
    font-weight: 600;
    line-height: 1.15;
    margin-bottom: 24px;
    color: #1a1a1a;
  }
  .shoden-ingredient__title em {
    font-family: 'Newsreader', serif;
    font-style: italic;
    font-weight: 400;
  }
  .shoden-ingredient__badges-row {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-bottom: 40px;
    flex-wrap: wrap;
  }
  .shoden-ingredient__badges-row-mobile{
    display: none;
  }
  .shoden-ingredient__badges-row-mobile {
       
      margin-left: 48px;
      padding: 15px;
  }
  @media (max-width: 767px) {
    .shoden-ingredient__badges-row-mobile{
      display: block;
    }
    .shoden-ingredient__badges-row{
      display: none;
    }
  }
  .shoden-ingredient__badge-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: #333;
  }
  .shoden-ingredient__badge-item img {
    width: 20px;
    height: 20px;
    object-fit: contain;
  }
  .shoden-ingredient__hplc-text {
    text-align: center;
    font-size: 14px;
    font-style: italic;
    color: #555;
    margin-bottom: 40px;
  }
  .shoden-circles {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0;
    margin-bottom: 32px;
  }
  .shoden-circles__item {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 0 20px;
    position: relative;
  }
  .shoden-circles__item:not(:last-child)::after {
    content: '';
    position: absolute;
    right: 0;
    top: 10%;
    height: 80%;
    width: 1px;
    background: #ccc;
  }
  .shoden-circles__ring {
    width: 160px;
    height: 160px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    margin-bottom: 16px;
    background:   #FFFFFE;
  }
  .shoden-circles__item:first-child .shoden-circles__ring {
    /*background: #EEEAE3;*/
  }
  .shoden-circles__ring::before {
    content: '';
    position: absolute;
    inset: -13px;
    border-radius: 50%;
    background-image: url('https://cdn.shopify.com/s/files/1/0267/5700/5494/files/round-round.png?v=1773058677');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }
  .shoden-circles__content { text-align: center; z-index: 1; }
  .shoden-circles__percent {
    font-size: 42px;
    font-weight: 700;
    color: #1a1a1a;
    line-height: 1;
    display: block;
  }
  .shoden-circles__sublabel {
    font-size: 11px;
    color: #8a7a5a;
    line-height: 1.3;
    margin-top: 4px;
    display: block;
  }
  .shoden-circles__brand {
    font-size: 14px;
    font-weight: 600;
    color: #1a1a1a;
    margin-top: 4px;
  }
  .shoden-ingredient__deco-top {
    position: absolute;
    top: 0;
    right: 0;
    width: 180px;
    pointer-events: none;
  }
  .shoden-ingredient__deco-top img { width: 100%; height: auto; }
  .shoden-ingredient__deco-bottom {
    position: absolute;
    bottom: 60px;
    left: 0;
    width: 140px;
    pointer-events: none;
  }
  .shoden-ingredient__deco-bottom img { width: 100%; height: auto; }
  .shoden-ingredient__disclaimer {
    text-align: center;
    font-size: 13px;
    font-style: italic;
    color: #777;
    margin-bottom: 40px;
    line-height: 1.5;
  }

  /* Potency Banner — full width */
  .shoden-potency-wrap { background: #2c2c2c; }
  .shoden-potency {
    max-width: 1200px;
    margin: 0 auto;
    padding: 28px 40px;
    color: #fff;
  }
  .shoden-potency__heading {
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 6px;
  }
  .shoden-potency__heading .gold { color: #c5a96a; }
  .shoden-potency__desc {
    font-size: 14px;
    color: #ccc;
    line-height: 1.5;
  }

  /* Pure & Natural Icons */
  .shoden-pure {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    gap: 40px;
    /*padding: 40px 20px;*/
    flex-wrap: wrap;
    border-top: 1px solid #e8e8e8;
    background: #E3D9C4;
  }
  .shoden-pure__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 10px;
    min-width: 90px;
  }
  .shoden-pure__icon { width: 44px; height: 44px; }
  .shoden-pure__icon img { width: 100%; height: 100%; object-fit: contain; }
  .shoden-pure__label { font-size: 12px; font-weight: 500; color: #333; line-height: 1.3; }

  /* ================================================================
     SECTION 2 — RECOMMENDED BY NUTRITIONIST
     ================================================================ */
  .shoden-nutri {
    background: #FEFEFE;
    padding: 70px 0;
  }
  .shoden-nutri__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
  }
  .shoden-nutri__left {
    text-align: center;
    padding: 20px;
  }
  .shoden-nutri__quote-mark {
    font-family: 'Newsreader', serif;
    font-size: 120px;
    line-height: 0.6;
    color: #d6cfc3;
    margin-bottom: 24px;
    display: block;
  }
  .shoden-nutri__heading {
    font-family: 'Outfit', sans-serif;
    font-size: 28px;
    font-weight: 700;
    margin-bottom: 24px;
    color: #1a1a1a;
  }
  .shoden-nutri__heading em {
    font-family: 'Newsreader', serif;
    font-style: italic;
    font-weight: 600;
    color: #A99368;
  }
  .shoden-nutri__text {
    font-size: 15px;
    line-height: 1.7;
    color: #555;
    margin-bottom: 24px;
    font-style: italic;
  }
  .shoden-nutri__author {
    font-size: 14px;
    font-weight: 600;
    font-style: italic;
    color: #1a1a1a;
  }
  .shoden-nutri__right {
    display: flex;
    justify-content: center;
  }
  .shoden-nutri__video-wrap {
    width: 280px;
    border-radius: 16px;
    overflow: hidden;
    position: relative;
    cursor: pointer;
    aspect-ratio: 9/14;
    background: #e8e2d8;
  }
  .shoden-nutri__video-wrap video,
  .shoden-nutri__video-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .shoden-nutri__play-btn {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0,0,0,0.15);
    transition: opacity 0.3s;
  }
  .shoden-nutri__play-btn svg {
    width: 56px;
    height: 56px;
    fill: #fff;
    filter: drop-shadow(0 2px 8px rgba(0,0,0,0.3));
  }
  .shoden-nutri__video-wrap.playing .shoden-nutri__play-btn {
    opacity: 0;
    pointer-events: none;
  }

  /* ================================================================
     SECTION 3 — PROVEN HEALTH BENEFITS
     ================================================================ */
  .shoden-benefits-section {
    background: #fff;
  }
  .shoden-benefits__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    align-items: stretch;
  }
  .shoden-benefits__img {
    background: #eae6e0;
    min-height: 500px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }
  .shoden-benefits__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .shoden-benefits__right {
    padding: 48px 40px;
    position: relative;
    overflow: hidden;
  }
  /* Faded medical icon watermark in bg */
  .shoden-benefits__right::before {
    content: '';
    position: absolute;
    top: 20px;
    left: 28px;
    width: 200px;
    height: 200px;
    background: var(--benefits-bg-img) no-repeat center / contain;
    opacity: 0.8;
    pointer-events: none;
  }
  .shoden-benefits__title-row {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 32px;
    position: relative;
    z-index: 1;
  }
  .shoden-benefits__title-icon {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
  }
  .shoden-benefits__title-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .shoden-benefits__title {
    font-family: 'Outfit', sans-serif;
    font-size: 30px;
    font-weight: 700;
    color: #1a1a1a;
    line-height: 1.2;
  }
  .shoden-benefits__title em {
    font-family: 'Newsreader', serif;
    font-style: italic;
    font-weight: 600;
    color: #A99368;
  }
  /* 2x2 grid with dividers */
  .shoden-benefits__stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    position: relative;
    z-index: 1;
  }
  .shoden-stat {
    text-align: center;
    padding: 28px 16px;
    position: relative;
  }
  /* Vertical divider between columns */
  .shoden-stat:nth-child(odd)::after {
    content: '';
    position: absolute;
    right: 0;
    top: 16px;
    bottom: 16px;
    width: 1px;
    background: #e0dcd6;
  }
  /* Horizontal divider between rows */
  .shoden-stat:nth-child(1),
  .shoden-stat:nth-child(2) {
    border-bottom: 1px solid #e0dcd6;
  }
  .shoden-stat__circle {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: #E3D9C4;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 14px;
  }
  .shoden-stat__num {
    font-size: 20px;
    font-weight: 700;
    color: #A1895E;
  }
  .shoden-stat__label {
    font-size: 13px;
    color: #666;
    line-height: 1.5;
    margin-bottom: 10px;
  }
  .shoden-stat__source {
    font-size: 12px;
    font-weight: 700;
    color: #1a1a1a;
    line-height: 1.3;
  }

  /* Mobile: Proven Health Benefits */
  @media (max-width: 767px) {
    .shoden-benefits__grid { grid-template-columns: 1fr; }
    .shoden-benefits__img { min-height: 300px; }
    .shoden-benefits__right { padding: 32px 20px; }
    .shoden-benefits__right::before {
      top: 10px;
      left: -10px;
      width: 120px;
      height: 120px;
    }
    .shoden-benefits__title { font-size: 26px; }
    .shoden-benefits__title-row { margin-bottom: 24px; }
    /* Vertical list on mobile */
    .shoden-benefits__stats {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .shoden-stat {
      display: flex;
      align-items: flex-start;
      gap: 16px;
      text-align: left;
      padding: 20px 0;
      border-bottom: 1px solid #e0dcd6;
    }
    .shoden-stat:last-child { border-bottom: none; }
    /* Remove desktop dividers on mobile */
    .shoden-stat:nth-child(odd)::after { display: none; }
    .shoden-stat:nth-child(1),
    .shoden-stat:nth-child(2) { border-bottom: 1px solid #e0dcd6; }
    .shoden-stat__circle {
      width: 56px;
      height: 56px;
      flex-shrink: 0;
      margin: 0;
    }
    .shoden-stat__num { font-size: 16px; }
    .shoden-stat__text { flex: 1; }
  }

  /* ================================================================
     SECTION 4 — PRODUCT COMPARISON TABLE
     ================================================================ */
  .shoden-compare {
    padding: 60px 0 70px;
    background: #fff;
    position: relative;
    overflow: hidden;
  }
  .shoden-compare__bg-check {
    position: absolute;
    top: 160px;
    left: 220px;
    pointer-events: none;
    z-index: 0;
  }
  .shoden-compare__bg-check img { width: 100%; height: auto; }
  .shoden-compare__bg-wrong {
    position: absolute;
    bottom: 40px;
    right: 60px;
    width: 121px;
    pointer-events: none;
    z-index: 0;
    opacity: 0.3;
  }
  .shoden-compare__bg-wrong img { width: 100%; height: auto; }

  /* --- DESKTOP VERSION --- */
  .shoden-ct-desktop { display: block; }
  .shoden-ct-mobile  { display: none; }

  .shoden-ct-desktop .ct-header {
    text-align: center;
    margin-bottom: 40px;
    position: relative;
    z-index: 1;
  }
  .shoden-ct-desktop .ct-tag {
    display: inline-block;
    border: 1px solid #999;
    border-radius: 4px;
    padding: 6px 18px;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: #555;
    margin-bottom: 16px;
  }
  .shoden-ct-desktop .ct-title {
    font-size: 38px;
    font-weight: 700;
    line-height: 1.15;
    color: #1a1a1a;
    margin: 0;
  }
  .shoden-ct-desktop .ct-title em {
    font-family: 'Newsreader', serif;
    font-style: italic;
    font-weight: 400;
    color: #999;
  }

  /* Desktop products row */
  .shoden-ct-desktop .ct-products {
    display: flex;
    justify-content: center;
    align-items: flex-end;
    gap: 40px;
    margin-bottom: 0;
    position: relative;
    z-index: 1;
  }
  .shoden-ct-desktop .ct-prod {
    text-align: center;
  }
  .shoden-ct-desktop .ct-prod-img-aiwo {
    border: 2px solid #d4e8d0;
    border-radius: 16px;
    padding: 20px;
    background: #fff;
    display: inline-block;
    margin-bottom: 12px;
  }
  .shoden-ct-desktop .ct-prod-img-aiwo img {
    width: 180px;
    height: auto;
    display: block;
  }
  .shoden-ct-desktop .ct-prod-img-gen {
    background: #f0ece6;
    border-radius: 12px;
    padding: 16px;
    display: inline-block;
    margin-bottom: 12px;
  }
  .shoden-ct-desktop .ct-prod-img-gen img {
    width: 130px;
    height: auto;
    display: block;
  }
  .shoden-ct-desktop .ct-prod-name {
    font-size: 16px;
    font-weight: 700;
    color: #1a1a1a;
  }

  /* Desktop table */
  .shoden-ct-desktop .ct-table {
    width: 100%;
    max-width: 920px;
    margin: 0 auto;
    border-collapse: collapse;
    position: relative;
    z-index: 1;
    table-layout: fixed;
  }
  .shoden-ct-desktop .ct-table col.col-label { width: 30%; }
  .shoden-ct-desktop .ct-table col.col-aiwo  { width: 40%; }
  .shoden-ct-desktop .ct-table col.col-gen   { width: 30%; }

  .shoden-ct-desktop .ct-table td {
    padding: 18px 24px;
    font-size: 15px;
    border-bottom: 1px solid #eee;
    vertical-align: middle;
  }
  .shoden-ct-desktop .ct-aiwo-top {
      text-align: center;
      background: #f2f8f0;
  }
  .shoden-ct-desktop .ct-table td.ct-label {
    font-weight: 600;
    color: #333;
    /*text-align: left;*/
    background: rgba(246, 243, 239, 1);
    text-align: center;
  }
  .shoden-ct-desktop .ct-table td.ct-aiwo {
    background: #f2f8f0;
    font-weight: 500;
    color: #333;
  }
  .shoden-ct-desktop .ct-table td.ct-gen {
    color: #888;
    font-weight: 400;
  }
  .shoden-ct-desktop .ct-table td.ct-aiwo,
  .shoden-ct-desktop .ct-table td.ct-gen {
    text-align: center;
  }
  .shoden-ct-desktop .ct-table td.ct-aiwo span,
  .shoden-ct-desktop .ct-table td.ct-gen span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .shoden-ct-desktop .ct-table td img.ic {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
  }

  /* Desktop buy row */
  .shoden-ct-desktop .ct-buy-row td {
    padding: 24px 24px 0;
    border-bottom: none;
  }
  .shoden-ct-desktop .ct-buy-btn {
    display: block;
    background: #1a1a1a;
    color: #fff;
    text-align: center;
    padding: 16px;
    font-family: 'Outfit', sans-serif;
    font-size: 15px;
    font-weight: 600;
    border: none;
    cursor: pointer;
    text-decoration: none;
    letter-spacing: 0.5px;
    width: 100%;
  }
  .shoden-ct-desktop .ct-buy-btn:hover {
    background: #333;
    color: #fff;
  }

  /* --- MOBILE VERSION --- */
  @media (max-width: 767px) {
    .shoden-ct-desktop { display: none !important; }
    .shoden-ct-mobile  { display: block !important; }
    .shoden-compare { padding: 40px 0 50px; }
    .shoden-compare__bg-check,
    .shoden-compare__bg-wrong { display: none; }
  }

  .shoden-ct-mobile .ctm-header {
    margin-bottom: 20px;
  }
  .shoden-ct-mobile .ctm-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #f2f8f0;
    border: 1px solid #c8dfc4;
    border-radius: 20px;
    padding: 6px 16px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: #333;
    margin-bottom: 14px;
  }
  .shoden-ct-mobile .ctm-tag::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #d44;
    flex-shrink: 0;
  }
  .shoden-ct-mobile .ctm-title {
    font-size: 24px;
    font-weight: 700;
    line-height: 1.2;
    color: #1a1a1a;
    margin: 0;
    text-align: left;
  }
  .shoden-ct-mobile .ctm-title em {
    font-family: 'Newsreader', serif;
    font-style: italic;
    font-weight: 400;
  }

  /* Mobile products */
  .shoden-ct-mobile .ctm-products {
    display: flex;
    gap: 12px;
    margin-bottom: 8px;
  }
  .shoden-ct-mobile .ctm-prod-aiwo {
    flex: 1;
    border: 2px solid #d4e8d0;
    border-radius: 12px;
    padding: 12px;
    background: #fff;
    text-align: center;
    background: #f2f8f0;
  }
  .shoden-ct-mobile .ctm-prod-aiwo img {
    width: 100%;
    /*max-width: 120px;*/
    height: auto;
  }
  .shoden-ct-mobile .ctm-prod-gen {
    flex: 1;
    background: #f0ece6;
    border-radius: 12px;
    padding: 12px;
    text-align: center;
  }
  .shoden-ct-mobile .ctm-prod-gen img {
    width: 100%;
    /*max-width: 100px;*/
    height: auto;
  }

  /* Mobile comparison rows */
  .shoden-ct-mobile .ctm-row {
    margin-bottom: 0;
  }
  .shoden-ct-mobile .ctm-row-label {
    text-align: center;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 1.2px;
    color: #0C0C0D;
    font-weight: 600;
    /*padding: 16px 0 6px;*/
    border-bottom: none;
    position: absolute;
    background: #FFFFFF;
    left: 126px;
    padding:4px;
  }
  .shoden-ct-mobile .ctm-row-data {
    display: flex;
    border-bottom: 1px solid #eee;
    /*padding: 0 0 14px;*/
  }
  .shoden-ct-mobile .ctm-val-aiwo {
    flex: 1;
    font-size: 14px;
    font-weight: 500;
    color: #333;
    text-align: left;
    background: #f2f8f0;
    padding: 25px 14px;
    border-radius: 0;
    display: flex;
  }
  .shoden-ct-mobile .ctm-val-gen {
    flex: 1;
    font-size: 14px;
    color: #888;
    text-align: right;
    padding: 25px 14px;
    display: flex;
    margin-left: 33px;
  }
  .shoden-ct-mobile .ctm-val-aiwo img.ic,
  .shoden-ct-mobile .ctm-val-gen img.ic {
    width: 18px;
    height: 18px;
    vertical-align: middle;
    margin-right: 5px;
  }

  /* Mobile buy button */
  .shoden-ct-mobile .ctm-buy {
    display: block;
