    "testimonials_bPAxbw": {
      "type": "testimonials",
      "blocks": {
        "testimonial_J4KxCC": {
          "type": "testimonial",
          "settings": {
            "icon_star": "5_star",
            "custom_icon": "",
            "title": "Neha S",
            "text": "<p><strong>Exactly what I needed for a regular health check-in.</strong><em> <br/>I didn’t have time for a full-body scan, but AIWO 100 gave me a complete picture of my core health markers. The report was clean, and the doctor explained everything in detail.</em></p>",
            "author": "",
            "author_note": "",
            "product": ""
          }
        },
        "testimonial_mDNQRF": {
          "type": "testimonial",
          "settings": {
            "icon_star": "5_star",
            "custom_icon": "",
            "title": "Amit Raj",
            "text": "<p><strong>I track my health like I track my finances — precisely.<br/></strong><em>As a biohacker, I run multiple panels a year. This one was surprisingly thorough for the price. Food intolerance, thyroid, and cardiac markers all in one? Perfect.</em></p>",
            "author": "",
            "author_note": "",
            "product": ""
          }
        },
        "testimonial_BYX7YM": {
          "type": "testimonial",
          "settings": {
            "icon_star": "5_star",
            "custom_icon": "",
            "title": "Priya Menon",
            "text": "<p><strong>Helped me connect the dots behind my constant fatigue.<br/></strong><em>Turns out I had a vitamin D deficiency and borderline thyroid issues. Thanks to the test and consult, I got on a plan that’s already making a difference.</em></p>",
            "author": "",
            "author_note": "",
            "product": ""
          }
        },
        "testimonial_YqTdmw": {
          "type": "testimonial",
          "settings": {
            "icon_star": "5_star",
            "custom_icon": "",
            "title": "Rohit Bhalla",
            "text": "<p><strong>Convenient, professional, and clear.<br/></strong><em>From sample collection to the digital report, everything was smooth. I appreciated the clarity of the report and how the doctor didn’t push meds — just facts and direction.</em></p>",
            "author": "",
