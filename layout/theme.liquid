<style>
  .wa-widget {
    position: fixed;
    bottom: 120px;
    right: 20px;
    z-index: 9999;
    font-family: Arial, sans-serif;
  }
  @media (max-width: 768px) {
    .wa-widget {
        bottom: 60px;
        right: 5px;
    }
  }

  /* Round Floating Button */
  .wa-button {
    background: #1c511e; /* Dark green from screenshot */
    border: none;
    border-radius: 50%;
    width: 60px;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 4px 8px rgba(0,0,0,0.3);
    transition: transform 0.2s ease-in-out;
  }

  .wa-button:hover {
    transform: scale(1.08);
    background: #154017; /* Slightly darker hover */
  }

  .wa-button img {
    width: 28px;
    height: 28px;
   
  }

   /* Popup box */
  .wa-popup {
    display: none;
    position: absolute;
    bottom: 70px;
    right: 0;
    width: 280px;
    background: #ffffff;
    border-radius: 16px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.25);
    padding: 18px;
    animation: fadeIn 0.3s ease-in-out;
  }

  .wa-popup h4 {
    margin: 0 0 6px;
    font-size: 17px;
    font-weight: bold;
    color: #000;
  }

  .wa-popup p {
    margin: 0 0 14px;
    font-size: 13px;
    color: #444;
  }

  /* Option buttons */
  .wa-popup button {
    display: block;
    width: 100%;
    background: #ffffff;
    border: 1.5px solid #dcdcdc;
    padding: 10px;
    margin: 6px 0;
    border-radius: 10px;
    cursor: pointer;
    text-align: center;
    font-size: 14px;
    font-weight: 500;
    color: #000;
    transition: all 0.2s ease-in-out;
  }

  .wa-popup button:hover {
    background: #e6f2ef;
    border-color: #1c511e;
  }
</style>

<div class="wa-widget">
  <button class="wa-button" id="waToggle">
    <img src="https://upload.wikimedia.org/wikipedia/commons/6/6b/WhatsApp.svg" alt="WA">
  </button>

  <div class="wa-popup" id="waPopup">
    <h4>AIWO Support</h4>
    <p>Typically replies within a day</p>
    <button data-msg="Order Support Assistance">Order Support Assistance</button>
    <button data-msg="Healthcation">Healthcation</button>
    <button data-msg="Book Appointment">Book Appointment</button>
    <button data-msg="Consultation">Consultation</button>
    <button data-msg="Others">Others</button>
  </div>
</div>

<script>
  (function() {
    var phoneNumber = "918682086820"; // International format
    var popup = document.getElementById("waPopup");
    var toggle = document.getElementById("waToggle");
    var buttons = popup.querySelectorAll("button[data-msg]");

    // Toggle popup
    toggle.addEventListener("click", function() {
      popup.style.display = (popup.style.display === "block") ? "none" : "block";
    });

    // Handle option click
    buttons.forEach(function(btn) {
      btn.addEventListener("click", function() {
        var msg = encodeURIComponent("Hi AIWO, I am looking for: " + btn.getAttribute("data-msg"));
        var waLink = "https://wa.me/" + phoneNumber + "?text=" + msg;
        window.open(waLink, "_blank");
      });
    });

    // Close popup when clicking outside
    document.addEventListener("click", function(e) {
      if (!popup.contains(e.target) && !toggle.contains(e.target)) {
        popup.style.display = "none";
      }
    });
  })();
</script>
   
    {%- comment -%} Global script to change Add to Cart to Book An Appointment for Consultation products {%- endcomment -%}
    <script>
      (function() {
        const APPOINTMENT_TEXT = 'Book An Appointment';
        
        // List of consultation product IDs (populated from Liquid)
        const consultationProductIds = [
          {%- for collection in collections -%}
            {%- if collection.title contains 'Consultation' -%}
              {%- for product in collection.products -%}
                '{{ product.id }}',
              {%- endfor -%}
            {%- endif -%}
          {%- endfor -%}
        ];
        
        function updateConsultationButtons() {
          if (consultationProductIds.length === 0) return;
          
          // Find all product cards and forms
          document.querySelectorAll('.card-product, form[action*="/cart/add"], .product-form').forEach(function(container) {
            // Check if this container has a consultation product
            const productInput = container.querySelector('input[name="id"]');
            const productId = productInput ? productInput.value : null;
            
            // Also check data attributes
            const dataId = container.dataset?.id || container.querySelector('[data-id]')?.dataset?.id;
            let matchedProductId = null;
            
            if (productId && consultationProductIds.includes(productId)) {
              matchedProductId = productId;
            } else if (dataId) {
              consultationProductIds.forEach(function(id) {
                if (dataId.includes('-' + id + '-') || dataId.endsWith('-' + id)) {
                  matchedProductId = id;
                }
              });
            }
            
            if (matchedProductId) {
              // Update all button text in this container
              container.querySelectorAll('.button-text').forEach(function(btn) {
                const text = btn.textContent.trim().toLowerCase();
                if (text === 'add to cart' || text === 'choose options' || text === 'choose variants') {
                  btn.textContent = APPOINTMENT_TEXT;
                }
              });
              
              // Also update x-atc-text elements
              container.querySelectorAll('.x-atc-text').forEach(function(el) {
                const text = el.textContent.trim().toLowerCase();
                if (text === 'add to cart' || text === 'choose options') {
                  const btnText = el.querySelector('.button-text');
                  if (btnText) {
                    btnText.textContent = APPOINTMENT_TEXT;
                  }
                }
              });
            }
          });
        }
        
        // Run on various events
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', updateConsultationButtons);
        } else {
          updateConsultationButtons();
        }
        
        // Run after delays for dynamic content
        setTimeout(updateConsultationButtons, 300);
        setTimeout(updateConsultationButtons, 800);
        setTimeout(updateConsultationButtons, 1500);
        setTimeout(updateConsultationButtons, 3000);
        
        // Watch for DOM changes
        const observer = new MutationObserver(function(mutations) {
          let shouldUpdate = false;
          mutations.forEach(function(mutation) {
            if (mutation.addedNodes.length > 0) {
              shouldUpdate = true;
            }
          });
          if (shouldUpdate) {
            setTimeout(updateConsultationButtons, 100);
          }
        });
        
        observer.observe(document.body, { childList: true, subtree: true });
        
        // Also run when quick view or modals open
        document.addEventListener('click', function() {
          setTimeout(updateConsultationButtons, 300);
          setTimeout(updateConsultationButtons, 600);
        });
      })();
    </script>
