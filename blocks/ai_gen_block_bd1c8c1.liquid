{% doc %}
  @prompt
     Create 3-column testimonial grid (white background):
    
    Heading: "Real Results from Real People"
    Subtitle about customer success
    Three testimonial cards with white background, orange border, hover effects:
    
    5-star rating at top
    Italicized review quote
    Bottom: Circular initial badge + name + age/description
    Testimonials from Rajesh K. (52), Priya S. (38), Anil M. (45)
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-testimonial-grid-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding }}px 20px;
  }

  .ai-testimonial-grid__container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-testimonial-grid__header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 40px;
  }

  .ai-testimonial-grid__heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 15px;
    font-weight: 700;
  }

  .ai-testimonial-grid__subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
    margin: 0;
    line-height: 1.6;
  }

  .ai-testimonial-grid__cards-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
  }

  .ai-testimonial-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
    padding: 30px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-testimonial-card-{{ ai_gen_id }}:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(251, 133, 0, 0.15);
  }

  .ai-testimonial-card__stars-{{ ai_gen_id }} {
    display: flex;
    gap: 5px;
  }

  .ai-testimonial-card__star-{{ ai_gen_id }} {
    width: {{ block.settings.star_size }}px;
    height: {{ block.settings.star_size }}px;
    fill: {{ block.settings.star_color }};
  }

  .ai-testimonial-card__quote-{{ ai_gen_id }} {
    font-style: italic;
    font-size: {{ block.settings.quote_size }}px;
    color: {{ block.settings.quote_color }};
    line-height: 1.6;
    flex-grow: 1;
    margin: 0;
  }

  .ai-testimonial-card__author-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 15px;
  }

  .ai-testimonial-card__badge-{{ ai_gen_id }} {
    width: {{ block.settings.badge_size }}px;
    height: {{ block.settings.badge_size }}px;
    border-radius: 50%;
    background-color: {{ block.settings.badge_background }};
    color: {{ block.settings.badge_text_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: {{ block.settings.badge_size | times: 0.5 }}px;
    font-weight: 700;
    flex-shrink: 0;
  }

  .ai-testimonial-card__info-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .ai-testimonial-card__name-{{ ai_gen_id }} {
    font-size: {{ block.settings.name_size }}px;
    color: {{ block.settings.name_color }};
    font-weight: 600;
    margin: 0;
  }

  .ai-testimonial-card__description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    margin: 0;
  }

  @media screen and (max-width: 989px) {
    .ai-testimonial-grid__cards-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }

    .ai-testimonial-grid__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .ai-testimonial-grid__subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtitle_size | times: 0.9 }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-testimonial-grid__cards-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .ai-testimonial-card-{{ ai_gen_id }} {
      padding: 25px;
    }

    .ai-testimonial-grid__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
    }
  }
{% endstyle %}

<testimonial-grid-{{ ai_gen_id }} class="ai-testimonial-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-testimonial-grid__container-{{ ai_gen_id }}">
    <div class="ai-testimonial-grid__header-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h2 class="ai-testimonial-grid__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {% endif %}
      {% if block.settings.subtitle != blank %}
        <div class="ai-testimonial-grid__subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</div>
      {% endif %}
    </div>

    <div class="ai-testimonial-grid__cards-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        {% liquid
          assign name_key = 'testimonial_' | append: i | append: '_name'
          assign description_key = 'testimonial_' | append: i | append: '_description'
          assign quote_key = 'testimonial_' | append: i | append: '_quote'
          
          assign name = block.settings[name_key]
          assign description = block.settings[description_key]
          assign quote = block.settings[quote_key]
          
          assign initials = ''
          if name != blank
            assign name_parts = name | split: ' '
            if name_parts.size > 0
              assign first_initial = name_parts[0] | slice: 0
              if name_parts.size > 1
                assign last_initial = name_parts[1] | slice: 0
                assign initials = first_initial | append: last_initial
              else
                assign initials = first_initial
              endif
            endif
          endif
        %}

        <div class="ai-testimonial-card-{{ ai_gen_id }}">
          <div class="ai-testimonial-card__stars-{{ ai_gen_id }}">
            {% for star in (1..5) %}
              <svg class="ai-testimonial-card__star-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
            {% endfor %}
          </div>

          {% if quote != blank %}
            <p class="ai-testimonial-card__quote-{{ ai_gen_id }}">"{{ quote }}"</p>
          {% endif %}

          <div class="ai-testimonial-card__author-{{ ai_gen_id }}">
            <div class="ai-testimonial-card__badge-{{ ai_gen_id }}">
              {{ initials | upcase }}
            </div>
            <div class="ai-testimonial-card__info-{{ ai_gen_id }}">
              {% if name != blank %}
                <div class="ai-testimonial-card__name-{{ ai_gen_id }}">{{ name }}</div>
              {% endif %}
              {% if description != blank %}
                <div class="ai-testimonial-card__description-{{ ai_gen_id }}">{{ description }}</div>
              {% endif %}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</testimonial-grid-{{ ai_gen_id }}>

<script>
  (function() {
    class TestimonialGrid{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.cards = this.querySelectorAll('.ai-testimonial-card-{{ ai_gen_id }}');
        this.setupAccessibility();
      }

      setupAccessibility() {
        this.cards.forEach((card) => {
          card.setAttribute('role', 'article');
          card.setAttribute('aria-label', 'Customer testimonial');
        });
      }
    }

    customElements.define('testimonial-grid-{{ ai_gen_id }}', TestimonialGrid{{ ai_gen_id }});
  })();
</script>

