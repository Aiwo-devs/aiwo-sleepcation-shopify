{% doc %}
  @prompt
    Create FAQ section (peach gradient background):
    
    Heading: "Frequently Asked Questions"
    Subtitle
    Center-aligned column of FAQ cards (max-width container)
    Each card: white background, orange border, rounded, hover border darkens
    
    Bold question as heading
    Answer paragraph in gray
    
    
    6 questions covering: turmeric vs supplement, results timeline, supplement interactions, safety, vegetarian capsules, elderly use, Create FAQ as dropdown section
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-faq-accordion-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 60px 20px;
    background: linear-gradient(135deg, {{ block.settings.gradient_color_1 }} 0%, {{ block.settings.gradient_color_2 }} 100%);
  }

  .ai-faq-accordion-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_max_width }}px;
    margin: 0 auto;
  }

  .ai-faq-accordion-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 40px;
  }

  .ai-faq-accordion-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 16px 0;
    font-weight: 700;
  }

  .ai-faq-accordion-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
    margin: 0;
    line-height: 1.5;
  }

  .ai-faq-accordion-list-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ai-faq-accordion-item-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
    transition: border-color 0.3s ease;
  }

  .ai-faq-accordion-item-{{ ai_gen_id }}:hover {
    border-color: {{ block.settings.border_hover_color }};
  }

  .ai-faq-accordion-button-{{ ai_gen_id }} {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 24px;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    gap: 16px;
  }

  .ai-faq-accordion-question-{{ ai_gen_id }} {
    font-size: {{ block.settings.question_size }}px;
    color: {{ block.settings.question_color }};
    margin: 0;
    font-weight: 700;
    flex: 1;
  }

  .ai-faq-accordion-icon-{{ ai_gen_id }} {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    transition: transform 0.3s ease;
    color: {{ block.settings.icon_color }};
  }

  .ai-faq-accordion-item-{{ ai_gen_id }}.active .ai-faq-accordion-icon-{{ ai_gen_id }} {
    transform: rotate(180deg);
  }

  .ai-faq-accordion-content-{{ ai_gen_id }} {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease, padding 0.3s ease;
  }

  .ai-faq-accordion-item-{{ ai_gen_id }}.active .ai-faq-accordion-content-{{ ai_gen_id }} {
    max-height: 500px;
    padding: 0 24px 20px 24px;
  }

  .ai-faq-accordion-answer-{{ ai_gen_id }} {
    font-size: {{ block.settings.answer_size }}px;
    color: {{ block.settings.answer_color }};
    margin: 0;
    line-height: 1.6;
  }

  @media screen and (max-width: 749px) {
    .ai-faq-accordion-{{ ai_gen_id }} {
      padding: 40px 16px;
    }

    .ai-faq-accordion-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }

    .ai-faq-accordion-subtitle-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subtitle_size }}px * 0.9);
    }

    .ai-faq-accordion-button-{{ ai_gen_id }} {
      padding: 16px 20px;
    }

    .ai-faq-accordion-item-{{ ai_gen_id }}.active .ai-faq-accordion-content-{{ ai_gen_id }} {
      padding: 0 20px 16px 20px;
    }
  }
{% endstyle %}

<faq-accordion-{{ ai_gen_id }} class="ai-faq-accordion-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-faq-accordion-container-{{ ai_gen_id }}">
    <div class="ai-faq-accordion-header-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h2 class="ai-faq-accordion-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {% endif %}
      {% if block.settings.subtitle != blank %}
        <div class="ai-faq-accordion-subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</div>
      {% endif %}
    </div>

    <div class="ai-faq-accordion-list-{{ ai_gen_id }}">
      {% for i in (1..6) %}
        {% liquid
          assign question_key = 'question_' | append: i
          assign answer_key = 'answer_' | append: i
          assign question = block.settings[question_key]
          assign answer = block.settings[answer_key]
        %}
        
        {% if question != blank and answer != blank %}
          <div class="ai-faq-accordion-item-{{ ai_gen_id }}" data-faq-item>
            <button 
              class="ai-faq-accordion-button-{{ ai_gen_id }}"
              aria-expanded="false"
              aria-controls="faq-content-{{ ai_gen_id }}-{{ i }}"
            >
              <h3 class="ai-faq-accordion-question-{{ ai_gen_id }}">{{ question }}</h3>
              <svg class="ai-faq-accordion-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>
            <div 
              class="ai-faq-accordion-content-{{ ai_gen_id }}"
              id="faq-content-{{ ai_gen_id }}-{{ i }}"
            >
              <p class="ai-faq-accordion-answer-{{ ai_gen_id }}">{{ answer }}</p>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</faq-accordion-{{ ai_gen_id }}>

<script>
  (function() {
    class FaqAccordion{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.items = this.querySelectorAll('[data-faq-item]');
        this.setupAccordion();
      }

      setupAccordion() {
        this.items.forEach((item) => {
          const button = item.querySelector('.ai-faq-accordion-button-{{ ai_gen_id }}');
          
          button.addEventListener('click', () => {
            const isActive = item.classList.contains('active');
            
            if ({{ block.settings.allow_multiple | json }}) {
              item.classList.toggle('active');
              button.setAttribute('aria-expanded', !isActive);
            } else {
              this.items.forEach((otherItem) => {
                if (otherItem !== item) {
                  otherItem.classList.remove('active');
                  otherItem.querySelector('.ai-faq-accordion-button-{{ ai_gen_id }}').setAttribute('aria-expanded', 'false');
                }
              });
              
              item.classList.toggle('active');
              button.setAttribute('aria-expanded', !isActive);
            }
          });
        });

        if ({{ block.settings.open_first | json }}) {
          const firstItem = this.items[0];
          if (firstItem) {
            firstItem.classList.add('active');
            firstItem.querySelector('.ai-faq-accordion-button-{{ ai_gen_id }}').setAttribute('aria-expanded', 'true');
          }
        }
      }
    }

    customElements.define('faq-accordion-{{ ai_gen_id }}', FaqAccordion{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
