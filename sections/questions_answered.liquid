{% comment %}
  FAQ Accordion Section
  Dark Theme - Tighter Letter Spacing
  Updates: Gold color changed to #919FA8
{% endcomment %}

<style>
/* ==========================================================================
   CSS VARIABLES
   ========================================================================== */
:root {
  --faq-bg: #0C0C0D;
  --faq-accordion-bg: #1A1A1A;
  --faq-text: #FEFEFE;
  /* Updated Gold/Accent Color */
  --faq-gold: #919FA8;
  --faq-radius: 16px;
  --faq-gap: 80px;
  --faq-transition: 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

/* ==========================================================================
   SECTION
   ========================================================================== */
.section_faq {
  width: 100%;
  padding: 80px 60px;
  background-color: var(--faq-bg);
}

.faq_container {
  max-width: 1400px;
  margin: 0 auto;
}

/* ==========================================================================
   TWO COLUMN LAYOUT - 40/60 SPLIT
   ========================================================================== */
.faq_content {
  display: grid;
  grid-template-columns: 40fr 60fr;
  gap: var(--faq-gap);
  align-items: start;
}

/* ==========================================================================
   LEFT COLUMN - HEADING
   ========================================================================== */
.faq_header {
  position: sticky;
  top: 100px;
}

.faq_eyebrow {
  display: inline-block;
  font-size: 14px;
  font-weight: 600;
  line-height: 1.5;
  letter-spacing: 0;
  text-transform: uppercase;
  color: var(--faq-text);
  padding: 4px 12px;
  margin-bottom: 24px;
  /* Updated Gradient to match #919FA8 (RGB: 145, 159, 168) */
  background: linear-gradient(90deg, rgba(145, 159, 168, 0.24), rgba(145, 159, 168, 0.06));
  border-radius: 2px;
}

.faq_heading {
  font-size: 48px;
  font-weight: 600;
  line-height: 1.2;
  color: var(--faq-text);
  margin: 0;
}

.faq_heading-gold {
  color: var(--faq-gold);
}

/* ==========================================================================
   RIGHT COLUMN - ACCORDION LIST
   ========================================================================== */
.faq_list {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

/* ==========================================================================
   ACCORDION ITEM
   ========================================================================== */
.faq_item {
  background-color: var(--faq-accordion-bg);
  border-radius: var(--faq-radius);
  overflow: hidden;
  transition: background-color var(--faq-transition);
}

.faq_item:hover {
  background-color: rgba(26, 26, 26, 0.8);
}

/* Question Button - TIGHTER LETTER SPACING */
.faq_question {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
  padding: 20px 64px 20px 24px;
  background: none;
  border: none;
  text-align: left;
  cursor: pointer;
  position: relative;
  font-size: 20px;
  font-weight: 700;
  line-height: 1.2;
  letter-spacing: -0.5px;
  color: var(--faq-text);
  transition: all var(--faq-transition);
}

.faq_question:hover {
  opacity: 0.9;
}

/* Toggle Icon */
.faq_toggle {
  position: absolute;
  right: 20px;
  top: 50%;
  transform: translateY(-50%);
  width: 24px;
  height: 24px;
  flex-shrink: 0;
  transition: transform var(--faq-transition);
}

.faq_toggle svg {
  width: 100%;
  height: 100%;
  display: block;
}

.faq_item.is-open .faq_toggle {
  transform: translateY(-50%) rotate(45deg);
}

/* Answer Panel */
.faq_answer {
  max-height: 0;
  overflow: hidden;
  transition: max-height var(--faq-transition);
}

.faq_item.is-open .faq_answer {
  max-height: 1000px;
}

.faq_answer-content {
  padding: 0 24px 20px 24px;
  font-size: 18px;
  font-weight: 400;
  line-height: 1.5;
  color: var(--faq-text);
  opacity: 0;
  transform: translateY(-10px);
  transition: opacity var(--faq-transition), transform var(--faq-transition);
}

.faq_item.is-open .faq_answer-content {
  opacity: 1;
  transform: translateY(0);
  transition-delay: 0.1s;
}

/* ==========================================================================
   RESPONSIVE - TABLET
   ========================================================================== */
@media (max-width: 991px) {
  .section_faq {
    padding: 64px 40px;
  }
  
  .faq_content {
    grid-template-columns: 1fr;
    gap: 48px;
  }
  
  .faq_header {
    position: static;
  }
  
  .faq_heading {
    font-size: 40px;
  }
  
  .faq_question {
    font-size: 18px;
    letter-spacing: -0.4px;
    padding-right: 56px;
  }
  
  .faq_answer-content {
    font-size: 16px;
  }
}

/* ==========================================================================
   RESPONSIVE - MOBILE
   ========================================================================== */
@media (max-width: 767px) {
  .section_faq {
    padding: 48px 24px;
  }
  
  .faq_content {
    gap: 40px;
  }
  
  .faq_heading {
    font-size: 32px;
  }
  
  .faq_eyebrow {
    font-size: 12px;
  }
  
  .faq_list {
    gap: 12px;
  }
  
  .faq_question {
    font-size: 17px;
    letter-spacing: -0.3px;
    padding: 16px 52px 16px 20px;
  }
  
  .faq_toggle {
    right: 16px;
    width: 20px;
    height: 20px;
  }
  
  .faq_answer-content {
    padding: 0 20px 16px 20px;
    font-size: 15px;
  }
}

/* ==========================================================================
   RESPONSIVE - MOBILE PORTRAIT
   ========================================================================== */
@media (max-width: 479px) {
  .section_faq {
    padding: 40px 20px;
  }
  
  .faq_heading {
    font-size: 28px;
  }
  
  .faq_eyebrow {
    font-size: 11px;
  }
  
  .faq_question {
    font-size: 16px;
    letter-spacing: -0.3px;
  }
  
  .faq_answer-content {
    font-size: 14px;
  }
}
</style>

<div class="section_faq">
  <div class="faq_container">
    
    <div class="faq_content">
      
      <div class="faq_header">
        <span class="faq_eyebrow">{{ section.settings.eyebrow }}</span>
        <h2 class="faq_heading">
          {{ section.settings.heading_white }} <span class="faq_heading-gold">{{ section.settings.heading_gold }}</span> {{ section.settings.heading_white_2 }}
        </h2>
      </div>
      
      <div class="faq_list">
        {%- for i in (1..10) -%}
          {%- assign question = 'question_' | append: i -%}
          {%- assign answer = 'answer_' | append: i -%}
          
          {%- if section.settings[question] != blank -%}
            <div class="faq_item {% if i == 1 %}is-open{% endif %}" data-faq-item>
              <button class="faq_question" aria-expanded="{% if i == 1 %}true{% else %}false{% endif %}" data-faq-trigger>
                <span>{{ section.settings[question] }}</span>
                <span class="faq_toggle">
                  <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 5V19M5 12H19" stroke="#FEFEFE" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </button>
              <div class="faq_answer" data-faq-panel>
                <div class="faq_answer-content">
                  {{ section.settings[answer] }}
                </div>
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
      
    </div>
    
  </div>
</div>

<script>
(function() {
  'use strict';
  
  // Initialize FAQ Accordion
  function initFAQ() {
    const faqItems = document.querySelectorAll('[data-faq-item]');
    
    if (!faqItems.length) return;
    
    faqItems.forEach(function(item) {
      const trigger = item.querySelector('[data-faq-trigger]');
      
      if (!trigger) return;
      
      trigger.addEventListener('click', function() {
        const isOpen = item.classList.contains('is-open');
        
        // Close all items
        faqItems.forEach(function(otherItem) {
          if (otherItem !== item) {
            otherItem.classList.remove('is-open');
            const otherTrigger = otherItem.querySelector('[data-faq-trigger]');
            if (otherTrigger) {
              otherTrigger.setAttribute('aria-expanded', 'false');
            }
          }
        });
        
        // Toggle current item
        if (isOpen) {
          item.classList.remove('is-open');
          trigger.setAttribute('aria-expanded', 'false');
        } else {
          item.classList.add('is-open');
          trigger.setAttribute('aria-expanded', 'true');
        }
      });
      
      // Keyboard support
      trigger.addEventListener('keydown', function(e) {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          trigger.click();
        }
      });
    });
  }
  
  // Initialize on DOM ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFAQ);
  } else {
    initFAQ();
  }
})();
</script>

