                              <div class="aiwo-evoo-v3-protocol-tooltip__trigger" @mouseenter="if(!('ontouchstart' in window)) open=true" @mouseleave="if(!('ontouchstart' in window)) open=false" @click="open=!open" @touchend.prevent="open=!open">
                                {%- if block.settings.protocol_tooltip_icon != blank -%}<img src="{{ block.settings.protocol_tooltip_icon | image_url: width: 14 }}" width="14" height="14" alt="" loading="lazy">{%- else -%}<span style="display:inline-block;width:14px;height:14px;" aria-hidden="true"></span>{%- endif -%}
                                <span>Start the Protocol*</span>
                                <div class="aiwo-evoo-v3-protocol-tooltip__bubble" :class="{ 'is-active': open }">
                                  <div class="aiwo-evoo-v3-protocol-tooltip__arrow"></div>
                                  {%- if block.settings.protocol_tooltip_title != blank -%}<p class="aiwo-evoo-v3-protocol-tooltip__title">{{ block.settings.protocol_tooltip_title | escape }}</p>{%- endif -%}
                                  {%- if block.settings.protocol_tooltip_desc != blank -%}<p class="aiwo-evoo-v3-protocol-tooltip__desc">{{ block.settings.protocol_tooltip_desc | escape }}</p>{%- endif -%}
                                </div>
                              </div>
                            </div>
                            <button type="submit" name="add"
                              id="header-atc-desktop-{{ section.id }}"
                              class="add_to_cart_button x-evoo-v3-atc-btn"
                              {% if is_disabled %}disabled{% endif %}
                              @click.prevent="errorMessage == false && addToCart($event)">
                              <span class="button-text" :class="{ 'opacity-0' : loading }" style="display:inline-flex;align-items:center;justify-content:center;gap:8px;">
                                Add To Cart
                                <img src="{{ 'cart-icon-white.svg' | file_url }}" alt="" width="20" height="20" loading="lazy" style="width:20px;height:20px;flex-shrink:0;">
                              </span>
                              <span x-show="loading" x-cloak class="animate-spin absolute" style="width:16px;height:16px;">{% render 'icon-alls', icon: 'icon-loading' %}</span>
                            </button>
                          </div>
                        </div>
                      {%- endform -%}
                    </div>
                  </div>

                  <script>
                    document.addEventListener('DOMContentLoaded', () => {
                      // 1. Precise Sticky Trigger (Split Mobile/Desktop Logic)
      const priceElement = document.getElementById('price-template--19620027302070__main');
      if (priceElement && window.IntersectionObserver) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            const isMobile = window.innerWidth < 768;
            let shouldShow = false;
            
            if (isMobile) {
              // Mobile: Show when price is visible or scrolled past
              shouldShow = entry.isIntersecting || entry.boundingClientRect.top < window.innerHeight;
            } else {
              // Desktop: Show ONLY after scrolling past the header/price
              shouldShow = !entry.isIntersecting && entry.boundingClientRect.top < 0;
            }

            if (shouldShow) {
              window.dispatchEvent(new CustomEvent('evoo-sticky-reveal'));
              window.dispatchEvent(new CustomEvent('eurus:sticky-atc:show'));
            } else {
              window.dispatchEvent(new CustomEvent('evoo-sticky-hide'));
              window.dispatchEvent(new CustomEvent('eurus:sticky-atc:hide'));
            }
          });
        }, { threshold: 0 });
        observer.observe(priceElement);
      }

                      // 2. Ironclad Global Quantity Sync (Handles Native Theme & Custom Buttons)
                      document.addEventListener('click', (e) => {
                        const btn = e.target.closest('button');
                        if (!btn) return;
                        
                        const isPlus = btn.textContent.includes('+') || btn.getAttribute('name') === 'plus' || btn.classList.contains('quantity__button--plus');
                        const isMinus = btn.textContent.includes('-') || btn.textContent.includes('−') || btn.getAttribute('name') === 'minus' || btn.classList.contains('quantity__button--minus');
                        
                        if (isPlus || isMinus) {
                          const container = btn.parentElement;
                          const input = container.querySelector('input[type="number"], input.quantity__input');
                          
                          if (input) {
                            let val = parseInt(input.value) || 1;
                            
                            // If it's OUR custom Desktop button, update manually immediately
                            if (btn.classList.contains('x-evoo-v3-btn-plus') || btn.classList.contains('x-evoo-v3-btn-minus')) {
                              if (isPlus) val++;
                              if (isMinus && val > 1) val--;
                              input.value = val;
                              syncAllHidden(val);
                            } else {
                              // If it's the THEME'S Sticky button, wait 50ms for native JS to change the visible input, then grab it
                              setTimeout(() => {
                                let newVal = parseInt(input.value) || 1;
                                syncAllHidden(newVal);
                              }, 50);
                            }
                          }
                        }
                      });

                      // Helper function to actively overwrite the theme's hidden form payloads
                      function syncAllHidden(val) {
                        document.querySelectorAll('form input[type="hidden"][name="quantity"], .x-evoo-master-qty').forEach(hidden => {
                          hidden.value = val;
                          hidden.setAttribute('value', val);
                        });
                        document.querySelectorAll('input[type="number"].x-evoo-v3-input, .sticky_add_to_cart input.quantity__input').forEach(vis => {
                          vis.value = val;
                        });
                      }
                    });
                  </script>
