    "multicolumn_Hgqmgx": {
      "type": "multicolumn",
      "blocks": {
        "column_xbpqyN": {
          "type": "column",
          "settings": {
            "icon": "none",
            "another_icon": "",
            "custom_icon": "",
            "title": "Step 1 ",
            "highlight_type": "underline",
            "title_link": "",
            "open_new_window": false,
            "heading_size": 100,
            "text": "<p>Do not eat or drink anything other than water at least 4 hours before the test. This includes chewing gum at least 4 hours before the test to avoid contamination and move the test to a new date.</p>"
          }
        },
        "column_DCTAAg": {
          "type": "column",
          "disabled": true,
          "settings": {
            "icon": "none",
            "another_icon": "",
            "custom_icon": "",
            "title": "Step 2",
            "highlight_type": "underline",
            "title_link": "",
            "open_new_window": false,
            "heading_size": 100,
            "text": "<p>If you smoke, do not smoke at least 4 hours before the test.</p>"
          }
        },
        "column_jQfyW8": {
          "type": "column",
          "settings": {
            "icon": "none",
            "another_icon": "",
            "custom_icon": "",
            "title": "Step 3",
            "highlight_type": "underline",
            "title_link": "",
            "open_new_window": false,
            "heading_size": 100,
            "text": "<p>Exercise at least 24 hours before your test, avoid strenuous activities, and do not work out or go to the gym until after your assessment.</p><ul><li>Do not train high-intensity cardio</li><li>If lifting weights, do not train your legs</li></ul>"
          }
        },
        "column_9xUUMJ": {
          "type": "column",
          "settings": {
            "icon": "none",
            "another_icon": "",
            "custom_icon": "",
            "title": "Step 4",
            "highlight_type": "underline",
            "title_link": "",
            "open_new_window": false,
            "heading_size": 100,
            "text": "<p>If you over-train the day before the test, your body may be fatigued, and you will not get the maximum benefit from your test.</p>"
          }
        }
      },
