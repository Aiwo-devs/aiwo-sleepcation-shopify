{%- style -%}
  /* ========================================================
     SCOPED SECTION CSS: AIWO FAQ v3
     ======================================================== */
  .aiwo-faq-v3 {
    background: #F6F3EF;
    padding: 48px 20px; 
    font-family: 'Outfit', sans-serif;
    color: #0C0C0D;
  }

  .aiwo-faq-v3__inner {
    max-width: var(--Container-container-large, 1280px);
    margin: 0 auto;
  }

  /* --- Tagline Component CSS --- */
  .aiwo-faq-v3__tagline-wrapper {
    margin-bottom: 24px;
  }

  .aiwo-tagline {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border: 1px solid #C0C0CC;
    border-radius: 4px;
    padding: 2px 8px;
    background: linear-gradient(90deg, #FBFBFB 0%, #F3F1F1 100%);
    color: #645452;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    background-color: #645452;
    border-radius: 50%;
    animation: pulse 1.5s infinite;
  }

  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 rgba(100, 84, 82, 0.4); }
    70% { box-shadow: 0 0 0 6px rgba(100, 84, 82, 0); }
    100% { box-shadow: 0 0 0 0 rgba(100, 84, 82, 0); }
  }

  /* --- FAQ Heading & List CSS --- */
  .aiwo-faq-v3__heading {
    color: #0C0C0D;
    font-family: 'Outfit', sans-serif;
    font-size: 40px;
    font-style: normal;
    font-weight: 600;
    line-height: 120%; /* 48px */
    margin: 0 0 20px 0; 
  }

  .aiwo-faq-v3__list {
    border-bottom: 1px solid #0C0C0D; 
  }

  .aiwo-faq-v3__item {
    border-top: 1px solid #0C0C0D;
  }

  .aiwo-faq-v3__question-btn {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 0; 
    background: transparent;
    border: none;
    cursor: pointer;
    text-align: left;
    color: #0C0C0D;
    font-family: 'Outfit', sans-serif;
    font-size: 18px;
    font-style: normal;
    font-weight: 600;
    line-height: 120%;
  }

  /* Icon Wrapper to prevent rotation glitches */
  .aiwo-faq-v3__icon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    margin-left: 16px;
    transition: transform 0.3s ease-in-out;
    transform-origin: center center;
  }

  .aiwo-faq-v3__item.is-active .aiwo-faq-v3__icon-wrap {
    transform: rotate(180deg);
  }

  .aiwo-faq-v3__icon {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  /* Pure CSS Grid Accordion (No JS plugins needed) */
  .aiwo-faq-v3__answer-wrapper {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.3s ease-in-out;
  }

  .aiwo-faq-v3__item.is-active .aiwo-faq-v3__answer-wrapper {
    grid-template-rows: 1fr;
  }

  .aiwo-faq-v3__answer-inner {
    overflow: hidden;
    padding-bottom: 0;
    transition: padding-bottom 0.3s ease-in-out;
  }

  .aiwo-faq-v3__item.is-active .aiwo-faq-v3__answer-inner {
    padding-bottom: 20px;
  }

  .aiwo-faq-v3__answer {
    max-width: 768px;
    color: #666666;
    font-family: 'Outfit', sans-serif;
    font-size: 16px;
    font-style: normal;
    font-weight: 400;
    line-height: 150%; /* 24px */
  }

  /* Mobile Responsive Overrides */
  @media (max-width: 767px) {
    .aiwo-faq-v3 {
      padding: 32px 16px;
    }
    .aiwo-faq-v3__heading {
      font-size: 32px;
    }
    .aiwo-faq-v3__question-btn {
      font-size: 16px;
    }
    .aiwo-faq-v3__answer {
      font-size: 14px;
    }
  }
{%- endstyle -%}

<section class="aiwo-faq-v3">
  <div class="aiwo-faq-v3__inner" x-data="{ active: 1 }">
    
    <div class="aiwo-faq-v3__tagline-wrapper">
      {%- if section.settings.faq_tag != blank -%}
        <div class="aiwo-tagline">
          <span class="pulse-dot"></span> {{ section.settings.faq_tag | escape }}
        </div>
      {%- endif -%}
    </div>

    {%- if section.settings.heading != blank -%}
      <h2 class="aiwo-faq-v3__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="aiwo-faq-v3__list">
      {%- for block in section.blocks -%}
        <div class="aiwo-faq-v3__item" :class="{ 'is-active': active === {{ forloop.index }} }" {{ block.shopify_attributes }}>
          
          <button 
            type="button" 
            class="aiwo-faq-v3__question-btn" 
            @click="active = active === {{ forloop.index }} ? null : {{ forloop.index }}"
          >
            <span>{{ forloop.index }}. {{ block.settings.question }}</span>
            
            <div class="aiwo-faq-v3__icon-wrap">
              {%- if section.settings.dropdown_svg != blank -%}
                {{ section.settings.dropdown_svg | image_url: width: 48 | image_tag: class: 'aiwo-faq-v3__icon', alt: 'Toggle Icon' }}
              {%- else -%}
                <svg class="aiwo-faq-v3__icon" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M6 9L12 15L18 9" stroke="#0C0C0D" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              {%- endif -%}
            </div>
          </button>

          <div class="aiwo-faq-v3__answer-wrapper">
            <div class="aiwo-faq-v3__answer-inner">
              <div class="aiwo-faq-v3__answer">
                {{ block.settings.answer }}
              </div>
            </div>
          </div>

        </div>
      {%- endfor -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "EVOO v3 - FAQ",
  "settings": [
    {
      "type": "text",
      "id": "faq_tag",
      "label": "Tagline",
      "default": "QUESTIONS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Straight answers."
    },
    {
      "type": "image_picker",
      "id": "dropdown_svg",
      "label": "Dropdown Icon (SVG)",
      "info": "Upload the chevron/arrow SVG icon."
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How is this different from the cocoa powder I already buy?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Most everyday cocoa is sweetened, soy-blended, or lower grade. AIWO Dark Cocoa is Premium Grade...</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "EVOO v3 - FAQ",
      "blocks": [
        { "type": "faq_item" },
        { "type": "faq_item" },
        { "type": "faq_item" }
      ]
    }
  ]
}
{% endschema %}