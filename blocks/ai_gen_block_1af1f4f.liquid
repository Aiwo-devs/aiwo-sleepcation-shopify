{% doc %}
  @prompt
    Create a benefits showcase section with light background:
    Header (centered):
    
    Pill badge: light blue bg, "Proven Benefits" in ocean blue
    Heading: "Complete Health" + "Support" (ocean gradient)
    Subtitle: Gray text about omega-3 benefits
    
    Grid Layout:
    
    3 columns (2 on tablet, 1 on mobile)
    24-32px gap between cards
    
    Card Design:
    
    White bg, 16px rounded corners, light border
    32-40px padding
    Hover: lift 4px + shadow increase
    Scroll animation: fade-in, staggered 100ms
    
    Card Content:
    
    Colored icon container (10% opacity bg, rounded) [EDITABLE]
    Colored badge pill with text [EDITABLE]
    Bold title [EDITABLE]
    Gray description text [EDITABLE]
    
    6 Default Benefits:
    
    ❤️ Cardiovascular Health (Red) - "Cardioprotective"
    🧠 Brain Function (Ocean Blue) - "Cognitive Boost"
    ⚡ Anti-Inflammatory (Gold) - "Joint Relief"
    👁️ Eye Health (Light Blue) - "Vision Support"
    🛡️ Immune System (Green) - "Immunity Boost"
    🦴 Bone & Joint (Gold) - "Flexibility"
    
    Colors: Red #EF4444, Ocean #0EA5E9, Gold #F59E0B, Green #10B981
    All text fields, icons, and colors editable via Shopify settings., icons are selected form media library
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-benefits-showcase-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.section_background }};
    padding: {{ block.settings.section_padding_top }}px 20px {{ block.settings.section_padding_bottom }}px;
  }

  .ai-benefits-showcase-container-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
  }

  .ai-benefits-showcase-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-benefits-showcase-badge-{{ ai_gen_id }} {
    display: inline-block;
    background-color: {{ block.settings.badge_bg_color }};
    color: {{ block.settings.badge_text_color }};
    padding: 8px 20px;
    border-radius: 50px;
    font-size: 14px;
    font-weight: 500;
    margin-bottom: 16px;
  }

  .ai-benefits-showcase-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 700;
    margin: 0 0 16px;
    line-height: 1.2;
  }

  .ai-benefits-showcase-heading-part1-{{ ai_gen_id }} {
    background: linear-gradient(135deg, {{ block.settings.gradient_color_1 }} 0%, {{ block.settings.gradient_color_2 }} 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    display: inline;
  }

  .ai-benefits-showcase-heading-part2-{{ ai_gen_id }} {
    background: linear-gradient(135deg, {{ block.settings.gradient_color_1 }} 0%, {{ block.settings.gradient_color_2 }} 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    display: inline;
  }

  .ai-benefits-showcase-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
    max-width: 700px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .ai-benefits-showcase-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    margin-top: {{ block.settings.grid_spacing }}px;
  }

  .ai-benefits-showcase-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_bg_color }};
    border: 1px solid {{ block.settings.card_border_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    transition: transform 0.3s ease, box-shadow 0.3s ease, opacity 0.6s ease, transform 0.6s ease;
    opacity: 0;
    transform: translateY(20px);
  }

  .ai-benefits-showcase-card-{{ ai_gen_id }}.ai-benefits-visible-{{ ai_gen_id }} {
    opacity: 1;
    transform: translateY(0);
  }

  .ai-benefits-showcase-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
  }

  .ai-benefits-showcase-icon-container-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
    overflow: hidden;
  }

  .ai-benefits-showcase-icon-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 12px;
  }

  .ai-benefits-showcase-badge-pill-{{ ai_gen_id }} {
    display: inline-block;
    padding: 6px 14px;
    border-radius: 50px;
    font-size: 12px;
    font-weight: 600;
    margin-bottom: 12px;
    color: #ffffff;
  }

  .ai-benefits-showcase-card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_title_size }}px;
    font-weight: 700;
    margin: 0 0 12px;
    color: {{ block.settings.card_title_color }};
  }

  .ai-benefits-showcase-card-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_description_size }}px;
    color: {{ block.settings.card_description_color }};
    line-height: 1.6;
    margin: 0;
  }

  @media screen and (max-width: 989px) {
    .ai-benefits-showcase-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }

    .ai-benefits-showcase-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-benefits-showcase-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-benefits-showcase-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.7);
    }

    .ai-benefits-showcase-subtitle-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subtitle_size }}px * 0.9);
    }
  }
{% endstyle %}

