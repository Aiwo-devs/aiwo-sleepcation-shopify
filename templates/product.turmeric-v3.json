    "section_evoo_v3_faq_rRJhLR": {
      "type": "section-evoo-v3-faq",
      "blocks": {
        "faq_item_BFc6Am": {
          "type": "faq_item",
          "settings": {
            "question": "How is this different from adding turmeric to my food or milk?",
            "answer": "<p>Kitchen turmeric contains 2–5% curcuminoids - and most of that passes through your digestive system without being absorbed. AIWO Turmeric Extract uses BCM-95® - a patented water-dispersible extraction technology standardised to not less than 45% total curcuminoids. One 2.25 g serving is bioequivalent to 73 grams of kitchen turmeric. The difference isn't taste — it's what actually reaches your bloodstream.<br/></p>"
          }
        },
        "faq_item_pgG9dR": {
          "type": "faq_item",
          "settings": {
            "question": "What does \"water dispersible\" mean and why does it matter?",
            "answer": "<p>Standard curcumin is fat-soluble and poorly absorbed without a lipid vehicle (fat or piperine). BCM-95® water-dispersible format is engineered to dissolve completely in any liquid - hot milk, cold water, smoothies - without needing fat or black pepper to improve uptake. No chalky texture, no bitterness, no separate fat source required.<br/></p>"
          }
        },
        "faq_item_zet6LP": {
          "type": "faq_item",
          "settings": {
            "question": "How long before I notice a difference?",
            "answer": "<p>Research on curcumin typically uses 8–12 week supplementation windows for immune, joint, and metabolic outcomes. Expect to assess results after consistent daily use for at least 60–90 days. Some individuals report skin and energy changes earlier. Results depend on your baseline health status.<br/></p>"
          }
        },
        "faq_item_Q6TUxh": {
          "type": "faq_item",
          "settings": {
            "question": "Can I take this alongside the AIWO Curcumin Rich capsules?",
            "answer": "<p>The powder and the capsule contain the same BCM-95® extract at different concentrations and formats. They are not typically combined - use the powder as your primary delivery method, or the capsule for convenience during travel. Consult a nutritionist about daily curcuminoid load before combining both.<br/></p>"
          }
        },
        "faq_item_WyBt4K": {
          "type": "faq_item",
          "settings": {
            "question": "Is it safe for children?",
            "answer": "<p>The label states this product is for adults. Consult a paediatrician before giving any concentrated curcumin product to children. Not for medicinal use.<br/></p>"
          }
        },
        "faq_item_FD4NGR": {
          "type": "faq_item",
          "settings": {
            "question": "Why does the label say \"Exclusively for AIWO Limited\"?",
            "answer": "<p>The BCM-95® water-dispersible Turmeric Extract is manufactured to AIWO's specification and is not available under any other brand in India through the same exclusive formulation arrangement. This ensures batch consistency, quality control, and verified curcuminoid content with every jar.<br/></p>"
          }
        }
      },
