{% doc %}
  @prompt
    Create a dramatic product comparison section with centered layout:
    Header:
    
    Large serif heading: "Still Taking Regular Turmeric?"
    Second line: "You're Absorbing Less Than 1%"
    Subheading below: "Switch to BCM-95® and Get 700% More Into Your Body"
    All text center-aligned, dark color
    
    Two-Column Comparison Cards:
    Left Card (Regular Turmeric - Negative):
    
    Light red/pink background (#FFE5E5 or similar)
    Rounded corners, padding
    Bold heading with X emoji: "❌ Regular Turmeric"
    7-8 bullet points with red X marks (❌):
    
    <1% absorbed into blood
    Need 3000mg for any effect
    Works in 3+ months (or never)
    ₹30/day for minimal results
    Cheap fillers & additives
    No clinical studies
    Flushing money down toilet
    
    
    
    Right Card (AIWO BCM-95® - Positive):
    
    Light green/mint background (#E5F9F5 or similar)
    Rounded corners, padding
    Bold heading with checkmark: "✅ AIWO BCM-95® + Piperine"
    7-8 bullet points with green checkmarks (✅):
    
    7x better absorption
    Only 493mg needed
    Results in 4-8 weeks
    ₹9/day for real results
    Pure BCM-95® + Piperine
    10,000+ studies
    Actually works!
    
    
    
    Bottom Summary Box:
    
    Peach/light orange gradient background
    Rounded corners, full width below cards
    Icon: 💡 "Bottom Line"
    Bold statement: "493mg AIWO = More absorbed curcumin than 3000mg standard supplement"
    Smaller text below: "Don't waste money on cheap turmeric your body can't absorb. Invest in BCM-95® technology that actually works."
    
    Design Details:
    
    Cards side-by-side on desktop, stack on mobile
    Equal height cards with matching padding
    Subtle hover effect on cards (slight lift/shadow)
    Use contrasting colors (red vs green) to emphasize difference
    Font: Bold for headings, regular for bullet points
    Spacing: generous padding within cards, space between bullet points
    
    Sticky Bottom Bar (if adding):
    
    Fixed at bottom of viewport
    White background, shadow above
    Left: Small product image + "AIWO Curcumin Rich" + star rating
    Right: Orange CTA button "Try Risk Free Now →"
    Appears on scroll
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-comparison-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 60px 20px;
    background-color: {{ block.settings.section_background }};
  }

  .ai-comparison-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-comparison-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 50px;
  }

  .ai-comparison-main-heading-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-size: {{ block.settings.main_heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 10px;
    line-height: 1.2;
  }

  .ai-comparison-sub-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.sub_heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 20px;
    line-height: 1.3;
  }

  .ai-comparison-tagline-{{ ai_gen_id }} {
    font-size: {{ block.settings.tagline_size }}px;
    color: {{ block.settings.tagline_color }};
    font-weight: 600;
    margin: 0;
  }

  .ai-comparison-cards-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px;
    margin-bottom: 40px;
  }

  .ai-comparison-card-{{ ai_gen_id }} {
    background-color: var(--card-bg);
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: 40px 30px;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-comparison-card-{{ ai_gen_id }}:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
  }

  .ai-comparison-card--negative-{{ ai_gen_id }} {
    --card-bg: {{ block.settings.negative_card_bg }};
  }

  .ai-comparison-card--positive-{{ ai_gen_id }} {
    --card-bg: {{ block.settings.positive_card_bg }};
  }

  .ai-comparison-card-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_heading_size }}px;
    font-weight: 700;
    margin: 0 0 25px;
    color: {{ block.settings.heading_color }};
  }

  .ai-comparison-list-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .ai-comparison-list-item-{{ ai_gen_id }} {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 15px;
    font-size: {{ block.settings.bullet_text_size }}px;
    color: {{ block.settings.bullet_text_color }};
    line-height: 1.5;
  }

  .ai-comparison-list-item-{{ ai_gen_id }}:last-child {
    margin-bottom: 0;
  }

  .ai-comparison-icon-{{ ai_gen_id }} {
    font-size: 20px;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .ai-comparison-summary-{{ ai_gen_id }} {
    background: {{ block.settings.summary_bg_gradient }};
    border-radius: {{ block.settings.summary_border_radius }}px;
    padding: 35px 40px;
    text-align: center;
  }

  .ai-comparison-summary-icon-{{ ai_gen_id }} {
    font-size: 32px;
    margin-bottom: 15px;
  }

  .ai-comparison-summary-label-{{ ai_gen_id }} {
    font-size: {{ block.settings.summary_label_size }}px;
    font-weight: 700;
    color: {{ block.settings.summary_text_color }};
    margin: 0 0 15px;
  }

  .ai-comparison-summary-statement-{{ ai_gen_id }} {
    font-size: {{ block.settings.summary_statement_size }}px;
    font-weight: 700;
    color: {{ block.settings.summary_text_color }};
    margin: 0 0 12px;
    line-height: 1.4;
  }

  .ai-comparison-summary-subtext-{{ ai_gen_id }} {
    font-size: {{ block.settings.summary_subtext_size }}px;
    color: {{ block.settings.summary_text_color }};
    margin: 0;
    line-height: 1.5;
  }

  .ai-comparison-sticky-bar-{{ ai_gen_id }} {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background-color: {{ block.settings.sticky_bar_bg }};
    box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.1);
    padding: 15px 20px;
    z-index: 100;
    transform: translateY(100%);
    transition: transform 0.3s ease;
  }

  .ai-comparison-sticky-bar-{{ ai_gen_id }}.visible {
    transform: translateY(0);
  }

  .ai-comparison-sticky-content-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .ai-comparison-sticky-product-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 15px;
  }

  .ai-comparison-sticky-image-{{ ai_gen_id }} {
    width: 60px;
    height: 60px;
    border-radius: 8px;
    object-fit: cover;
  }

  .ai-comparison-sticky-info-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .ai-comparison-sticky-title-{{ ai_gen_id }} {
    font-size: 16px;
    font-weight: 600;
    color: {{ block.settings.sticky_text_color }};
    margin: 0;
  }

  .ai-comparison-sticky-rating-{{ ai_gen_id }} {
    font-size: 14px;
    color: {{ block.settings.sticky_text_color }};
  }

  .ai-comparison-sticky-cta-{{ ai_gen_id }} {
    background-color: {{ block.settings.cta_button_bg }};
    color: {{ block.settings.cta_button_text }};
    padding: 15px 35px;
    border-radius: {{ block.settings.cta_button_radius }}px;
    font-size: 16px;
    font-weight: 600;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: background-color 0.3s ease;
    white-space: nowrap;
  }

  .ai-comparison-sticky-cta-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.cta_button_hover_bg }};
  }

  @media screen and (max-width: 768px) {
    .ai-comparison-section-{{ ai_gen_id }} {
      padding: 40px 15px;
    }

    .ai-comparison-main-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.main_heading_size }}px * 0.7);
    }

    .ai-comparison-sub-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.sub_heading_size }}px * 0.8);
    }

    .ai-comparison-tagline-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.tagline_size }}px * 0.85);
    }

    .ai-comparison-cards-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .ai-comparison-card-{{ ai_gen_id }} {
      padding: 30px 20px;
    }

    .ai-comparison-card-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.card_heading_size }}px * 0.9);
    }

    .ai-comparison-summary-{{ ai_gen_id }} {
      padding: 25px 20px;
    }

    .ai-comparison-sticky-content-{{ ai_gen_id }} {
      flex-direction: column;
      gap: 15px;
    }

    .ai-comparison-sticky-cta-{{ ai_gen_id }} {
      width: 100%;
      text-align: center;
    }
  }
{% endstyle %}

