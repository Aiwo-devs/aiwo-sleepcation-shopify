          "type": "column",
          "settings": {
            "icon": "none",
            "another_icon": "",
            "custom_icon": "",
            "title": "Step 2",
            "highlight_type": "underline",
            "title_link": "",
            "open_new_window": false,
            "heading_size": 100,
            "text": "<p>Maintain normal medication intake, only delay if safe, and bring an inhaler for exercise-induced asthma patients. Seek advice from the GP if testing concerns arise.</p>"
          }
        },
        "column_N99zMD": {
          "type": "column",
          "settings": {
            "icon": "none",
            "another_icon": "",
            "custom_icon": "",
            "title": "Step 3",
            "highlight_type": "underline",
            "title_link": "",
            "open_new_window": false,
            "heading_size": 100,
            "text": "<p>To avoid hypoglycemia during a fasting pre-test, those with metabolic disorders such as thyroid or diabetes should consume quickly absorbed carbs right after the test.</p>"
          }
        },
        "column_Vr9K44": {
          "type": "column",
          "settings": {
            "icon": "none",
            "another_icon": "",
            "custom_icon": "",
            "title": "Step 4",
            "highlight_type": "underline",
            "title_link": "",
            "open_new_window": false,
            "heading_size": 100,
            "text": "<p>Exercise risks are inherent, and it's crucial to complete a health screen before your test day to avoid potential postponements or cancellations.</p>"
          }
        }
      },
      "block_order": [
        "column_eRpR8f",
        "column_hYafjM",
        "column_N99zMD",
        "column_Vr9K44"
      ],
