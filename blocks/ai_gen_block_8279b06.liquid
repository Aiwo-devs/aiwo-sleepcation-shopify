{% doc %}
  @prompt
    Create technology section with ocean blue gradient background and white text:
    Layout: 2 columns (stack on mobile)
    Left Column - Content:
    
    White pill badge: "Advanced Technology" (10% opacity bg)
    Large heading: "Why Aiwo Omega 3" + "Stands Apart" (gold text) [EDITABLE]
    White/light gray description paragraph [EDITABLE]
    3 feature cards (semi-transparent white bg, blur effect):
    
    Gold icon container (square, rounded) [EDITABLE ICON]
    Bold title [EDITABLE]
    Small description text [EDITABLE]
    
    
    
    Default Features:
    
    🛡️ Shield - "Enteric Coating" - "Eliminates fishy burps..."
    🧪 Beaker - "Molecularly Distilled" - "Removes heavy metals..."
    💧 Droplets - "Maximum Absorption" - "100% absorption..."
    
    Right Column - Differentiators Card:
    
    Semi-transparent white card with blur, rounded
    Heading: "The Aiwo Difference"
    2-column grid of 6 checkmark items (gold checkmarks in circles) [EDITABLE, repeatable]
    
    Default: "No fishy burps", "Complete absorption", "Mercury free", "Double strength", "Pharmaceutical grade", "Sustained release"
    
    
    Bottom: 3 stat boxes with border separator:
    
    "36%" - EPA Content [EDITABLE]
    "24%" - DHA Content [EDITABLE]
    "100%" - Absorption [EDITABLE]
    
    
    
    Decorative: Gold and blue blur circles positioned around right card
    Responsive: Stack vertically on mobile
    All text, icons, stats, and checkmark items editable via Shopify settings., Right section is horizondal center alignment & icons are imported form media libraray, and items icons also editable
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-tech-section-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    background: linear-gradient(135deg, {{ block.settings.gradient_color_1 }} 0%, {{ block.settings.gradient_color_2 }} 100%);
    padding: {{ block.settings.section_padding_top }}px 20px {{ block.settings.section_padding_bottom }}px;
    overflow: hidden;
    display: block;
  }

  .ai-tech-container-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }

  .ai-tech-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }

  .ai-tech-badge-{{ ai_gen_id }} {
    display: inline-block;
    padding: 8px 20px;
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 50px;
    color: {{ block.settings.text_color }};
    font-size: 14px;
    font-weight: 500;
    margin-bottom: 24px;
  }

  .ai-tech-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.2;
    color: {{ block.settings.text_color }};
    margin: 0 0 24px;
    font-weight: 700;
  }

  .ai-tech-heading-highlight-{{ ai_gen_id }} {
    color: {{ block.settings.highlight_color }};
  }

  .ai-tech-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    line-height: 1.6;
    color: {{ block.settings.description_color }};
    margin: 0 0 40px;
  }

  .ai-tech-features-{{ ai_gen_id }} {
    display: grid;
    gap: 20px;
  }

  .ai-tech-feature-card-{{ ai_gen_id }} {
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    border-radius: 16px;
    padding: 24px;
    display: flex;
    gap: 20px;
    align-items: flex-start;
  }

  .ai-tech-feature-icon-{{ ai_gen_id }} {
    width: 48px;
    height: 48px;
    background-color: {{ block.settings.icon_bg_color }};
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    overflow: hidden;
  }

  .ai-tech-feature-icon-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 8px;
  }

  .ai-tech-feature-icon-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-tech-feature-icon-placeholder-{{ ai_gen_id }} svg {
    width: 24px;
    height: 24px;
    opacity: 0.5;
  }

  .ai-tech-feature-content-{{ ai_gen_id }} {
    flex: 1;
  }

  .ai-tech-feature-title-{{ ai_gen_id }} {
    font-size: 18px;
    font-weight: 700;
    color: {{ block.settings.text_color }};
    margin: 0 0 8px;
  }

  .ai-tech-feature-text-{{ ai_gen_id }} {
    font-size: 14px;
    line-height: 1.5;
    color: {{ block.settings.description_color }};
    margin: 0;
  }

  .ai-tech-diff-card-{{ ai_gen_id }} {
    position: relative;
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(20px);
    border-radius: 24px;
    padding: 40px;
  }

  .ai-tech-diff-heading-{{ ai_gen_id }} {
    font-size: 28px;
    font-weight: 700;
    color: {{ block.settings.text_color }};
    margin: 0 0 32px;
    text-align: center;
  }

  .ai-tech-checks-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 32px;
  }

  .ai-tech-check-item-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .ai-tech-check-icon-{{ ai_gen_id }} {
    width: 24px;
    height: 24px;
    background-color: {{ block.settings.icon_bg_color }};
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    overflow: hidden;
  }

  .ai-tech-check-icon-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 4px;
  }

  .ai-tech-check-icon-{{ ai_gen_id }} svg {
    width: 14px;
    height: 14px;
    stroke: {{ block.settings.text_color }};
  }

  .ai-tech-check-icon-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-tech-check-text-{{ ai_gen_id }} {
    font-size: 15px;
    color: {{ block.settings.text_color }};
    font-weight: 500;
  }

  .ai-tech-stats-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    padding-top: 24px;
  }

  .ai-tech-stat-{{ ai_gen_id }} {
    text-align: center;
    position: relative;
  }

  .ai-tech-stat-{{ ai_gen_id }}:not(:last-child)::after {
    content: '';
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 1px;
    height: 40px;
    background: rgba(255, 255, 255, 0.2);
  }

  .ai-tech-stat-value-{{ ai_gen_id }} {
    font-size: 32px;
    font-weight: 700;
    color: {{ block.settings.highlight_color }};
    margin: 0 0 4px;
  }

  .ai-tech-stat-label-{{ ai_gen_id }} {
    font-size: 13px;
    color: {{ block.settings.description_color }};
    margin: 0;
  }

  .ai-tech-decor-{{ ai_gen_id }} {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.3;
    pointer-events: none;
  }

  .ai-tech-decor-1-{{ ai_gen_id }} {
    width: 200px;
    height: 200px;
    background-color: {{ block.settings.highlight_color }};
    top: -50px;
    right: -50px;
  }

  .ai-tech-decor-2-{{ ai_gen_id }} {
    width: 150px;
    height: 150px;
    background-color: {{ block.settings.gradient_color_1 }};
    bottom: -30px;
    right: 100px;
  }

  @media screen and (max-width: 989px) {
    .ai-tech-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .ai-tech-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.7);
    }

    .ai-tech-diff-card-{{ ai_gen_id }} {
      padding: 30px 24px;
    }

    .ai-tech-checks-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .ai-tech-stats-{{ ai_gen_id }} {
      gap: 16px;
    }

    .ai-tech-stat-value-{{ ai_gen_id }} {
      font-size: 24px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-tech-section-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top | times: 0.6 }}px 16px {{ block.settings.section_padding_bottom | times: 0.6 }}px;
    }

    .ai-tech-feature-card-{{ ai_gen_id }} {
      padding: 20px;
    }

    .ai-tech-diff-heading-{{ ai_gen_id }} {
      font-size: 24px;
    }
  }
{% endstyle %}

<div class="ai-tech-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-tech-container-{{ ai_gen_id }}">
    <div class="ai-tech-grid-{{ ai_gen_id }}">
      
      <div class="ai-tech-left-{{ ai_gen_id }}">
        {% if block.settings.badge_text != blank %}
          <div class="ai-tech-badge-{{ ai_gen_id }}">
            {{ block.settings.badge_text }}
          </div>
        {% endif %}

        <h2 class="ai-tech-heading-{{ ai_gen_id }}">
          {{ block.settings.heading_part_1 }}
          {% if block.settings.heading_part_2 != blank %}
            <span class="ai-tech-heading-highlight-{{ ai_gen_id }}">{{ block.settings.heading_part_2 }}</span>
          {% endif %}
        </h2>

        {% if block.settings.description != blank %}
          <div class="ai-tech-description-{{ ai_gen_id }}">
            {{ block.settings.description }}
          </div>
        {% endif %}

        <div class="ai-tech-features-{{ ai_gen_id }}">
          {% for i in (1..3) %}
            {% assign feature_enabled_key = 'feature_' | append: i | append: '_enabled' %}
            {% assign feature_icon_key = 'feature_' | append: i | append: '_icon' %}
            {% assign feature_title_key = 'feature_' | append: i | append: '_title' %}
            {% assign feature_text_key = 'feature_' | append: i | append: '_text' %}

            {% if block.settings[feature_enabled_key] %}
              <div class="ai-tech-feature-card-{{ ai_gen_id }}">
                <div class="ai-tech-feature-icon-{{ ai_gen_id }}">
                  {% if block.settings[feature_icon_key] %}
                    <img
                      src="{{ block.settings[feature_icon_key] | image_url: width: 100 }}"
                      alt="{{ block.settings[feature_title_key] }}"
                      loading="lazy"
                      width="48"
                      height="48"
                    >
                  {% else %}
                    <div class="ai-tech-feature-icon-placeholder-{{ ai_gen_id }}">
                      {{ 'image' | placeholder_svg_tag }}
                    </div>
                  {% endif %}
                </div>
                <div class="ai-tech-feature-content-{{ ai_gen_id }}">
                  <h3 class="ai-tech-feature-title-{{ ai_gen_id }}">
                    {{ block.settings[feature_title_key] }}
                  </h3>
                  <p class="ai-tech-feature-text-{{ ai_gen_id }}">
                    {{ block.settings[feature_text_key] }}
                  </p>
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>

      <div class="ai-tech-right-{{ ai_gen_id }}">
        <div class="ai-tech-diff-card-{{ ai_gen_id }}">
          <div class="ai-tech-decor-1-{{ ai_gen_id }} ai-tech-decor-{{ ai_gen_id }}"></div>
          <div class="ai-tech-decor-2-{{ ai_gen_id }} ai-tech-decor-{{ ai_gen_id }}"></div>

          <h3 class="ai-tech-diff-heading-{{ ai_gen_id }}">
            {{ block.settings.diff_heading }}
          </h3>

          <div class="ai-tech-checks-grid-{{ ai_gen_id }}">
            {% for i in (1..6) %}
              {% assign check_enabled_key = 'check_' | append: i | append: '_enabled' %}
              {% assign check_icon_key = 'check_' | append: i | append: '_icon' %}
              {% assign check_text_key = 'check_' | append: i | append: '_text' %}

              {% if block.settings[check_enabled_key] %}
                <div class="ai-tech-check-item-{{ ai_gen_id }}">
                  <div class="ai-tech-check-icon-{{ ai_gen_id }}">
                    {% if block.settings[check_icon_key] %}
                      <img
                        src="{{ block.settings[check_icon_key] | image_url: width: 50 }}"
                        alt="{{ block.settings[check_text_key] }}"
                        loading="lazy"
                        width="24"
                        height="24"
                      >
                    {% else %}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="20 6 9 17 4 12"></polyline>
                      </svg>
                    {% endif %}
                  </div>
                  <span class="ai-tech-check-text-{{ ai_gen_id }}">
                    {{ block.settings[check_text_key] }}
                  </span>
                </div>
              {% endif %}
            {% endfor %}
          </div>

          <div class="ai-tech-stats-{{ ai_gen_id }}">
            <div class="ai-tech-stat-{{ ai_gen_id }}">
              <div class="ai-tech-stat-value-{{ ai_gen_id }}">{{ block.settings.stat_1_value }}</div>
              <div class="ai-tech-stat-label-{{ ai_gen_id }}">{{ block.settings.stat_1_label }}</div>
            </div>
            <div class="ai-tech-stat-{{ ai_gen_id }}">
              <div class="ai-tech-stat-value-{{ ai_gen_id }}">{{ block.settings.stat_2_value }}</div>
              <div class="ai-tech-stat-label-{{ ai_gen_id }}">{{ block.settings.stat_2_label }}</div>
            </div>
            <div class="ai-tech-stat-{{ ai_gen_id }}">
              <div class="ai-tech-stat-value-{{ ai_gen_id }}">{{ block.settings.stat_3_value }}</div>
              <div class="ai-tech-stat-label-{{ ai_gen_id }}">{{ block.settings.stat_3_label }}</div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>

