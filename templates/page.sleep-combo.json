    "faq_4JhpGN": {
      "type": "faq",
      "blocks": {
        "frequently_asked_question_EP64mk": {
          "type": "frequently_asked_question",
          "settings": {
            "icon": "heart",
            "another_icon": "",
            "custom_icon": "",
            "heading": "Is the AIWO Pillow good for neck and shoulder pain?",
            "row_content": "<p>Yes! It's clinically designed to relieve pressure on your cervical spine and muscles.</p>"
          }
        },
        "frequently_asked_question_mK4jQW": {
          "type": "frequently_asked_question",
          "settings": {
            "icon": "heart",
            "another_icon": "",
            "custom_icon": "",
            "heading": "How heavy is the weighted blanket? Will it be too hot?",
            "row_content": "<p>It weighs around 5–6 kg and is made with breathable bamboo fabric, perfect for year-round comfort.</p>"
          }
        },
        "frequently_asked_question_6d9PWy": {
          "type": "frequently_asked_question",
          "settings": {
            "icon": "heart",
            "another_icon": "",
            "custom_icon": "",
            "heading": "Can I use the breathing kit daily?",
            "row_content": "<p>Absolutely!!! Practicing 120 deep breaths daily helps improve lung function, reduce snoring, and strengthen your immune system.</p>"
          }
        },
        "frequently_asked_question_q6cWXm": {
          "type": "frequently_asked_question",
          "settings": {
            "icon": "heart",
            "another_icon": "",
            "custom_icon": "",
            "heading": "Are these products safe for kids or elderly people?",
            "row_content": "<p>Yes, they're designed to support wellness for every age group with the highest safety standards.</p>"
          }
        },
        "frequently_asked_question_xrTpVV": {
          "type": "frequently_asked_question",
          "settings": {
            "icon": "heart",
            "another_icon": "",
            "custom_icon": "",
            "heading": "Can children use the AIWO Weighted Blanket?",
            "row_content": "<p>Yes, but always ensure the weight is appropriate for the child's body weight (ideally 8–12%).</p>"
          }
        },
        "frequently_asked_question_WGBEQg": {
          "type": "frequently_asked_question",
          "settings": {
            "icon": "heart",
            "another_icon": "",
            "custom_icon": "",
            "heading": "Can I use the AIWO Pillow if I sleep on my side or back?",
            "row_content": "<p>Yes, it's ergonomically designed to support all major sleep positions — back, side, or combination sleepers.</p>"
          }
        },
        "frequently_asked_question_PwHBUR": {
          "type": "frequently_asked_question",
          "settings": {
            "icon": "heart",
            "another_icon": "",
            "custom_icon": "",
            "heading": "How is the AIWO Weighted Blanket different from regular heavy blankets?",
            "row_content": "<p>It uses clinical deep-pressure therapy principles, helping to relax your nervous system — not just add weight.</p>"
          }
        },
        "frequently_asked_question_yB7neN": {
          "type": "frequently_asked_question",
          "settings": {
            "icon": "heart",
            "another_icon": "",
            "custom_icon": "",
            "heading": "How does a weighted blanket help with sleep and anxiety?",
            "row_content": "<p>Weighted blankets work through \"deep pressure stimulation,\" a proven method that activates the parasympathetic nervous system, reduces cortisol (stress hormone), boosts serotonin and melatonin production, and promotes a sense of calm for better sleep.</p>"
          }
        },
        "frequently_asked_question_MWAViy": {
          "type": "frequently_asked_question",
          "settings": {
            "icon": "heart",
            "another_icon": "",
            "custom_icon": "",
            "heading": "Is the AIWO Pillow good for neck pain from working at a desk?",
            "row_content": "<p>Yes. It relieves tension caused by poor posture and long hours at a desk.</p>"
          }
        }
      },
