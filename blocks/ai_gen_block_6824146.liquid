{% doc %}
  @prompt
    Design a process journey section titled “From Our Australian Groves to Your Table” for a luxury extra virgin olive oil brand. The section should visually walk the viewer through each stage of production, emphasizing transparency, craftsmanship, and purity.
    
    Layout:
    
    Vertical or stacked layout of 10 clean, numbered process cards.
    
    Each card should contain:
    
    A small number badge (1–10) inside a golden or pale-yellow circle.
    
    A title in bold olive-green text.
    
    A short one-line description in muted gray text.
    
    Cards have white backgrounds with subtle shadows and rounded corners.
    
    Alternating subtle accent tones (optional) to improve rhythm when scrolling.
    
    Background: soft beige (#FAF8F3) to maintain the premium, organic look.
    
    Content:
    
    Sustainably Grown, Non-GMO Groves
    Pruned for health; soil and water managed for flavor-rich fruit.
    
    Selective Harvest
    Hand precision-picked at optimal ripeness; early morning to protect aromatics.
    
    Quick Transfer to Mill
    Crates, not sacks—ventilated and shaded; no fruit piling.
    
    Wash & Sort
    Leaves removed, olives rinsed; only sound fruit proceeds.
    
    Cold Extraction (<27°C)
    Gentle crush → short malaxation → immediate separation to lock in aroma and polyphenols.
    
    Clarify & Polish
    Decant/centrifuge to reduce moisture and solids; bright, clean profile.
    
    Independent Lab Verification
    Pesticides: Not Detected; freshness numbers recorded per lot (acidity, peroxide, PPP/DAGs).
    
    Bottled in Dark-Tinted Glass
    Shields from light; preserves vitality to the last drop.
    
    Lot Coding & COA QR
    Radical transparency—scan to view the independent report for your bottle.
    
    Cool-Chain Storage & Ship
    Stored away from heat and light; delivered ready to enjoy.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-process-journey-{{ ai_gen_id }} {
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding_top }}px 20px {{ block.settings.section_padding_bottom }}px;
  }

  .ai-process-journey-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
  }

  .ai-process-journey-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-process-journey-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 16px;
    font-weight: 600;
    line-height: 1.2;
  }

  .ai-process-journey-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
    margin: 0;
    line-height: 1.6;
  }

  .ai-process-journey-cards-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.card_spacing }}px;
  }

  .ai-process-journey-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    box-shadow: {{ block.settings.card_shadow_x }}px {{ block.settings.card_shadow_y }}px {{ block.settings.card_shadow_blur }}px {{ block.settings.card_shadow_color }};
    display: flex;
    align-items: flex-start;
    gap: 20px;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-process-journey-card-{{ ai_gen_id }}:hover {
    transform: translateY(-2px);
    box-shadow: {{ block.settings.card_shadow_x }}px {{ block.settings.card_shadow_y | plus: 4 }}px {{ block.settings.card_shadow_blur | plus: 8 }}px {{ block.settings.card_shadow_color }};
  }

  .ai-process-journey-card-{{ ai_gen_id }}:nth-child(even) {
    background-color: {{ block.settings.card_alternate_background }};
  }

  .ai-process-journey-badge-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.badge_size }}px;
    height: {{ block.settings.badge_size }}px;
    border-radius: 50%;
    background-color: {{ block.settings.badge_background }};
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: {{ block.settings.badge_number_size }}px;
    font-weight: 700;
    color: {{ block.settings.badge_text_color }};
  }

  .ai-process-journey-content-{{ ai_gen_id }} {
    flex: 1;
    min-width: 0;
  }

  .ai-process-journey-card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_title_size }}px;
    color: {{ block.settings.card_title_color }};
    margin: 0 0 8px;
    font-weight: 700;
    line-height: 1.3;
  }

  .ai-process-journey-card-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_description_size }}px;
    color: {{ block.settings.card_description_color }};
    margin: 0;
    line-height: 1.6;
  }

  @media screen and (max-width: 749px) {
    .ai-process-journey-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top | times: 0.6 }}px 16px {{ block.settings.section_padding_bottom | times: 0.6 }}px;
    }

    .ai-process-journey-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.7 }}px;
    }

    .ai-process-journey-subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtitle_size | times: 0.85 }}px;
    }

    .ai-process-journey-card-{{ ai_gen_id }} {
      padding: {{ block.settings.card_padding | times: 0.75 }}px;
      gap: 16px;
    }

    .ai-process-journey-badge-{{ ai_gen_id }} {
      width: {{ block.settings.badge_size | times: 0.8 }}px;
      height: {{ block.settings.badge_size | times: 0.8 }}px;
      font-size: {{ block.settings.badge_number_size | times: 0.8 }}px;
    }

    .ai-process-journey-card-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.card_title_size | times: 0.85 }}px;
    }

    .ai-process-journey-card-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.card_description_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

