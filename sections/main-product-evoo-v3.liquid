<script>
  document.addEventListener('DOMContentLoaded', function() {
    var sectionId = '{{ section.id }}';
    var thumbContainer = document.getElementById('x-product-thumbnail-' + sectionId);
    var stackedContainer = document.getElementById('stacked-' + sectionId);
    if (!thumbContainer || !stackedContainer) return;

    // Click thumbnail → scroll to image
    thumbContainer.querySelectorAll('.x-thumbnail').forEach(function(thumb) {
      thumb.addEventListener('click', function(e) {
        e.preventDefault();
        var mediaId = thumb.getAttribute('data-media-id');
        var target = document.getElementById('postion-image-' + mediaId);
        if (target) {
          var headerH = parseInt(getComputedStyle(document.documentElement).getPropertyValue('--height-header')) || 60;
          var top = target.getBoundingClientRect().top + window.scrollY - headerH - 30;
          window.scrollTo({ top: top, behavior: 'smooth' });
        }
      });
    });

    // Scroll → highlight active thumbnail
    var images = stackedContainer.querySelectorAll('.product-media-item');
    var thumbs = thumbContainer.querySelectorAll('.x-thumbnail');
    if (images.length === 0 || thumbs.length === 0) return;

    function updateActiveThumbnail() {
      var scrollY = window.scrollY;
      var headerH = parseInt(getComputedStyle(document.documentElement).getPropertyValue('--height-header')) || 60;
      var activeId = null;
      images.forEach(function(img) {
        var rect = img.getBoundingClientRect();
        if (rect.top < window.innerHeight * 0.5 && rect.bottom > headerH + 40) {
          activeId = img.getAttribute('data-media-id');
        }
      });
      thumbs.forEach(function(t) {
        if (t.getAttribute('data-media-id') === activeId) {
          t.classList.add('is-active');
        } else {
          t.classList.remove('is-active');
        }
      });
    }

    var ticking = false;
    window.addEventListener('scroll', function() {
      if (!ticking) {
        requestAnimationFrame(function() { updateActiveThumbnail(); ticking = false; });
        ticking = true;
      }
    });
    updateActiveThumbnail();
  });

  function updateButtonTextAiwo() {

    let checked = document.querySelector("input.sls-option:checked");
    let btnText = document.querySelector(".x-atc-text");

    if (!checked || !btnText) return;

    if (checked.value === "subscription") {
        btnText.textContent = "Start the Protocol";
    } else {
        btnText.textContent = "Add to cart";
    }
}


// run on load (SealSubs loads late → use interval)
let sealCheck = setInterval(function () {

    let radios = document.querySelectorAll(".sls-option");

    if (radios.length) {

        updateButtonTextAiwo();

        radios.forEach(r => {
            r.addEventListener("change", updateButtonTextAiwo);
        });

        clearInterval(sealCheck);
    }

}, 300);
</script>

