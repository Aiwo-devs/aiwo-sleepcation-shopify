            "custom_image": "shopify://shop_images/stress-management.png",
            "custom_icon": "",
            "title": "Deep Pressure Therapy Proven to Reduce Anxiety by 63%",
            "highlight_type": "underline",
            "title_link": "",
            "open_new_window": false,
            "heading_size": 100,
            "text": "<p>The gentle weight of <strong>5kg </strong>of glass beads, combined with intricate 5cms of stitching gaps in each layer, stimulates deep pressure touch (DPT), which has been shown in clinical studies to <strong>reduce stress hormones like cortisol </strong>and <strong>lower anxiety levels.</strong></p>"
          }
        },
        "column_dDYdxc": {
          "type": "column",
          "settings": {
            "icon": "truck",
