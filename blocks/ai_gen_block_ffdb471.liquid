{% doc %}
  @prompt
    Create alternating 2-column ingredients showcase section.
    
    SECTION HEADER (centered, full-width):
    "Premium Ingredients. Complete Transparency."
    - Font: Poppins SemiBold, 42px desktop / 28px mobile
    - Color: #211E1E
    - IMPORTANT: Style "Premium Ingredients" in italic + #D68641
    - Margin bottom: 64px
    
    BACKGROUND: #FFFFFF
    PADDING: 64px vertical
    MAX-WIDTH: 1200px centered
    
    PART A - FAST BAR INGREDIENTS:
    Layout: 2 columns (Image left, Content right)
    
    Left: Product image with ingredient callouts (400x400px)
    Right Content:
    - Heading: "What's Inside Every Bar" - Poppins SemiBold 24px #211E1E
    - Checklist (Lato Regular 16px, #545252):
      ✓ Grass-fed Ghee
      ✓ Organic Coconut Oil  
      ✓ Premium Cocoa
      ✓ Probiotic Chicory Fiber
      ✓ Monk Fruit Sweetener
      ✓ Pink Himalayan Salt
    - Checkmarks: #5B2E28, bold
    - Footer text: "Zero artificial sweeteners, colors, or preservatives" - Poppins SemiBold, #211E1E
    
    PART B - EVOO SPECIFICATIONS:
    Layout: 2 columns (Content left, Image right) - REVERSE of Part A
    
    Left Content:
    - Heading: "Cold-Pressed, Single-Origin Excellence" - Poppins SemiBold 24px
    - Quality specs checklist:
      ✓ Cold-pressed within 24 hours
      ✓ Single-origin Mediterranean olives
      ✓ Rich in polyphenols & antioxidants
      ✓ FSSAI certified pure & natural
      ✓ Dark glass bottle for freshness
    
    Right: EVOO bottle image (400x400px)
    
    SPACING: 64px gap between Part A and Part B
    
    MOBILE:
    - Stack vertically
    - Image always on top, content below
    - Image: 300x300px
    - Reduce heading to 20px
    
    AESTHETIC: Clean ingredient label style, scientific transparency, premium natural product feel, health-conscious brand positioning
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-ingredients-showcase-{{ ai_gen_id }} {
    display: block;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding }}px 20px;
    width: 100%;
  }

  .ai-ingredients-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-ingredients-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: {{ block.settings.header_margin_bottom }}px;
  }

  .ai-ingredients-title-{{ ai_gen_id }} {
    font-family: 'Poppins', sans-serif;
    font-weight: 600;
    font-size: {{ block.settings.title_size_desktop }}px;
    color: {{ block.settings.title_color }};
    margin: 0;
    line-height: 1.2;
  }

  .ai-ingredients-title-highlight-{{ ai_gen_id }} {
    font-style: italic;
    color: {{ block.settings.title_highlight_color }};
  }

  .ai-ingredients-row-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: center;
    margin-bottom: {{ block.settings.row_spacing }}px;
  }

  .ai-ingredients-row-{{ ai_gen_id }}:last-child {
    margin-bottom: 0;
  }

  .ai-ingredients-row-reverse-{{ ai_gen_id }} {
    direction: rtl;
  }

  .ai-ingredients-row-reverse-{{ ai_gen_id }} > * {
    direction: ltr;
  }

  .ai-ingredients-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .ai-ingredients-image-{{ ai_gen_id }} {
    width: {{ block.settings.image_size }}px;
    height: {{ block.settings.image_size }}px;
    object-fit: contain;
  }

  .ai-ingredients-image-placeholder-{{ ai_gen_id }} {
    width: {{ block.settings.image_size }}px;
    height: {{ block.settings.image_size }}px;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
  }

  .ai-ingredients-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-ingredients-content-{{ ai_gen_id }} {
    width: 100%;
  }

  .ai-ingredients-heading-{{ ai_gen_id }} {
    font-family: 'Poppins', sans-serif;
    font-weight: 600;
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 20px 0;
    line-height: 1.3;
  }

  .ai-ingredients-list-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 0 0 20px 0;
  }

  .ai-ingredients-list-item-{{ ai_gen_id }} {
    font-family: 'Lato', sans-serif;
    font-size: {{ block.settings.list_text_size }}px;
    color: {{ block.settings.list_text_color }};
    margin-bottom: 12px;
    display: flex;
    align-items: flex-start;
    line-height: 1.5;
  }

  .ai-ingredients-checkmark-{{ ai_gen_id }} {
    color: {{ block.settings.checkmark_color }};
    font-weight: bold;
    margin-right: 10px;
    flex-shrink: 0;
  }

  .ai-ingredients-footer-{{ ai_gen_id }} {
    font-family: 'Poppins', sans-serif;
    font-weight: 600;
    font-size: {{ block.settings.list_text_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-ingredients-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size_mobile }}px;
    }

    .ai-ingredients-row-{{ ai_gen_id }},
    .ai-ingredients-row-reverse-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 24px;
      direction: ltr;
    }

    .ai-ingredients-image-wrapper-{{ ai_gen_id }} {
      order: -1;
    }

    .ai-ingredients-image-{{ ai_gen_id }} {
      width: {{ block.settings.image_size_mobile }}px;
      height: {{ block.settings.image_size_mobile }}px;
    }

    .ai-ingredients-image-placeholder-{{ ai_gen_id }} {
      width: {{ block.settings.image_size_mobile }}px;
      height: {{ block.settings.image_size_mobile }}px;
    }

    .ai-ingredients-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_mobile }}px;
    }
  }
{% endstyle %}

<div class="ai-ingredients-showcase-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-ingredients-container-{{ ai_gen_id }}">
    <div class="ai-ingredients-header-{{ ai_gen_id }}">
      <h2 class="ai-ingredients-title-{{ ai_gen_id }}">
        <span class="ai-ingredients-title-highlight-{{ ai_gen_id }}">{{ block.settings.title_part1 }}</span> {{ block.settings.title_part2 }}
      </h2>
    </div>

    <div class="ai-ingredients-row-{{ ai_gen_id }}">
      <div class="ai-ingredients-image-wrapper-{{ ai_gen_id }}">
        {% if block.settings.fastbar_image %}
          <img
            src="{{ block.settings.fastbar_image | image_url: width: 800 }}"
            alt="{{ block.settings.fastbar_image.alt | escape }}"
            class="ai-ingredients-image-{{ ai_gen_id }}"
            loading="lazy"
            width="400"
            height="400"
          >
        {% else %}
          <div class="ai-ingredients-image-placeholder-{{ ai_gen_id }}">
            {{ 'product-1' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>

      <div class="ai-ingredients-content-{{ ai_gen_id }}">
        <h3 class="ai-ingredients-heading-{{ ai_gen_id }}">{{ block.settings.fastbar_heading }}</h3>
        <ul class="ai-ingredients-list-{{ ai_gen_id }}">
          {% if block.settings.fastbar_item1 != blank %}
            <li class="ai-ingredients-list-item-{{ ai_gen_id }}">
              <span class="ai-ingredients-checkmark-{{ ai_gen_id }}">✓</span>
              <span>{{ block.settings.fastbar_item1 }}</span>
            </li>
          {% endif %}
          {% if block.settings.fastbar_item2 != blank %}
            <li class="ai-ingredients-list-item-{{ ai_gen_id }}">
              <span class="ai-ingredients-checkmark-{{ ai_gen_id }}">✓</span>
              <span>{{ block.settings.fastbar_item2 }}</span>
            </li>
          {% endif %}
          {% if block.settings.fastbar_item3 != blank %}
            <li class="ai-ingredients-list-item-{{ ai_gen_id }}">
              <span class="ai-ingredients-checkmark-{{ ai_gen_id }}">✓</span>
              <span>{{ block.settings.fastbar_item3 }}</span>
            </li>
          {% endif %}
          {% if block.settings.fastbar_item4 != blank %}
            <li class="ai-ingredients-list-item-{{ ai_gen_id }}">
              <span class="ai-ingredients-checkmark-{{ ai_gen_id }}">✓</span>
              <span>{{ block.settings.fastbar_item4 }}</span>
            </li>
          {% endif %}
          {% if block.settings.fastbar_item5 != blank %}
            <li class="ai-ingredients-list-item-{{ ai_gen_id }}">
              <span class="ai-ingredients-checkmark-{{ ai_gen_id }}">✓</span>
              <span>{{ block.settings.fastbar_item5 }}</span>
            </li>
          {% endif %}
          {% if block.settings.fastbar_item6 != blank %}
            <li class="ai-ingredients-list-item-{{ ai_gen_id }}">
              <span class="ai-ingredients-checkmark-{{ ai_gen_id }}">✓</span>
              <span>{{ block.settings.fastbar_item6 }}</span>
            </li>
          {% endif %}
        </ul>
        {% if block.settings.fastbar_footer != blank %}
          <p class="ai-ingredients-footer-{{ ai_gen_id }}">{{ block.settings.fastbar_footer }}</p>
        {% endif %}
      </div>
    </div>

    <div class="ai-ingredients-row-{{ ai_gen_id }} ai-ingredients-row-reverse-{{ ai_gen_id }}">
      <div class="ai-ingredients-image-wrapper-{{ ai_gen_id }}">
        {% if block.settings.evoo_image %}
          <img
            src="{{ block.settings.evoo_image | image_url: width: 800 }}"
            alt="{{ block.settings.evoo_image.alt | escape }}"
            class="ai-ingredients-image-{{ ai_gen_id }}"
            loading="lazy"
            width="400"
            height="400"
          >
        {% else %}
          <div class="ai-ingredients-image-placeholder-{{ ai_gen_id }}">
            {{ 'product-1' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>

      <div class="ai-ingredients-content-{{ ai_gen_id }}">
        <h3 class="ai-ingredients-heading-{{ ai_gen_id }}">{{ block.settings.evoo_heading }}</h3>
        <ul class="ai-ingredients-list-{{ ai_gen_id }}">
          {% if block.settings.evoo_item1 != blank %}
            <li class="ai-ingredients-list-item-{{ ai_gen_id }}">
              <span class="ai-ingredients-checkmark-{{ ai_gen_id }}">✓</span>
              <span>{{ block.settings.evoo_item1 }}</span>
            </li>
          {% endif %}
          {% if block.settings.evoo_item2 != blank %}
            <li class="ai-ingredients-list-item-{{ ai_gen_id }}">
              <span class="ai-ingredients-checkmark-{{ ai_gen_id }}">✓</span>
              <span>{{ block.settings.evoo_item2 }}</span>
            </li>
          {% endif %}
          {% if block.settings.evoo_item3 != blank %}
            <li class="ai-ingredients-list-item-{{ ai_gen_id }}">
              <span class="ai-ingredients-checkmark-{{ ai_gen_id }}">✓</span>
              <span>{{ block.settings.evoo_item3 }}</span>
            </li>
          {% endif %}
          {% if block.settings.evoo_item4 != blank %}
            <li class="ai-ingredients-list-item-{{ ai_gen_id }}">
              <span class="ai-ingredients-checkmark-{{ ai_gen_id }}">✓</span>
              <span>{{ block.settings.evoo_item4 }}</span>
            </li>
          {% endif %}
          {% if block.settings.evoo_item5 != blank %}
            <li class="ai-ingredients-list-item-{{ ai_gen_id }}">
              <span class="ai-ingredients-checkmark-{{ ai_gen_id }}">✓</span>
              <span>{{ block.settings.evoo_item5 }}</span>
            </li>
          {% endif %}
        </ul>
        {% if block.settings.evoo_footer != blank %}
          <p class="ai-ingredients-footer-{{ ai_gen_id }}">{{ block.settings.evoo_footer }}</p>
        {% endif %}
      </div>
    </div>
  </div>
</div>

