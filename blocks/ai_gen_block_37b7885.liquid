{% doc %}
  @prompt
    Design a "How to Use" instructions section for AIWO Ultimate Omega 3.
    Layout:
    Full-width section, light gray/white background, centered content, generous padding.
    Header:
    
    Yellow pill badge at top: "Usage Instructions"
    Main heading (bold, large black): "How to Use AIWO ULTIMATE OMEGA 3"
    Subheading (gray, centered): "Follow these simple guidelines to get the maximum benefits from your premium omega-3 supplement."
    
    Instruction Cards (4 columns, equal width):
    Card 1 - Best Time to Take
    
    Deep navy circular icon with white clock symbol
    Bold heading: "Best Time to Take"
    Gray description: "Take with meals to enhance absorption and reduce any potential stomach upset."
    Checkmark bullets:
    
    ✅ Morning with breakfast
    ✅ Evening with dinner
    ✅ Consistent daily timing recommended
    
    
    
    Card 2 - Recommended Dosage
    
    Deep navy circular icon with white capsule/pill symbol
    Bold heading: "Recommended Dosage"
    Gray description: "Take 1-2 soft gel capsules daily with water for optimal omega-3 benefits."
    Checkmark bullets:
    
    ✅ 1 capsule = 1000mg Omega-3
    ✅ Maximum 2 capsules per day
    ✅ Do not exceed recommended dose
    
    
    
    Card 3 - With Food
    
    Deep navy circular icon with white fork & knife symbol
    Bold heading: "With Food"
    Gray description: "Always take with food containing some fat to maximize omega-3 absorption."
    Checkmark bullets:
    
    ✅ Best with fatty meals
    ✅ Avoid taking on empty stomach
    ✅ Enhances bioavailability
    
    
    
    Card 4 - Consistency is Key
    
    Deep navy circular icon with white calendar symbol
    Bold heading: "Consistency is Key"
    Gray description: "Take daily for at least 8-12 weeks to experience full cardio protective benefits."
    Checkmark bullets:
    
    ✅ Daily consumption recommended
    ✅ Results visible in 8-12 weeks
    ✅ Long-term use is safe
    
    
    
    Card Styling:
    
    White background with subtle border/shadow
    Rounded corners
    Centered icon at top
    Centered heading below icon
    Left-aligned description text and bullets
    Green checkmark icons for bullets
    Equal height cards with proper padding
    Hover effect (slight lift/sha, make a icon as  changeable option 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-how-to-use-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding_desktop }}px 40px;
  }

  @media screen and (max-width: 749px) {
    .ai-how-to-use-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_mobile }}px 20px;
    }
  }

  .ai-how-to-use-container-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
  }

  .ai-how-to-use-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 60px;
  }

  .ai-how-to-use-badge-{{ ai_gen_id }} {
    display: inline-block;
    background-color: {{ block.settings.badge_color }};
    color: {{ block.settings.badge_text_color }};
    padding: 8px 20px;
    border-radius: 20px;
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 20px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .ai-how-to-use-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 700;
    color: {{ block.settings.title_color }};
    margin: 0 0 16px 0;
    line-height: 1.2;
  }

  @media screen and (max-width: 749px) {
    .ai-how-to-use-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.7);
    }
  }

  .ai-how-to-use-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
    margin: 0;
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.6;
  }

  @media screen and (max-width: 749px) {
    .ai-how-to-use-subtitle-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subtitle_size }}px * 0.9);
    }
  }

  .ai-how-to-use-cards-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 30px;
  }

  @media screen and (max-width: 989px) {
    .ai-how-to-use-cards-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-how-to-use-cards-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }

  .ai-how-to-use-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border: 1px solid {{ block.settings.card_border_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: 30px 20px;
    text-align: center;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-how-to-use-card-{{ ai_gen_id }}:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
  }

  .ai-how-to-use-icon-wrapper-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    background-color: {{ block.settings.icon_background }};
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 20px;
  }

  .ai-how-to-use-icon-wrapper-{{ ai_gen_id }} svg {
    width: calc({{ block.settings.icon_size }}px * 0.5);
    height: calc({{ block.settings.icon_size }}px * 0.5);
    stroke: {{ block.settings.icon_color }};
  }

  .ai-how-to-use-icon-wrapper-{{ ai_gen_id }} img {
    width: calc({{ block.settings.icon_size }}px * 0.6);
    height: calc({{ block.settings.icon_size }}px * 0.6);
    object-fit: contain;
  }

  .ai-how-to-use-card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_title_size }}px;
    font-weight: 700;
    color: {{ block.settings.card_title_color }};
    margin: 0 0 12px 0;
  }

  .ai-how-to-use-card-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_text_size }}px;
    color: {{ block.settings.card_text_color }};
    margin: 0 0 16px 0;
    line-height: 1.6;
    text-align: center;
  }

  .ai-how-to-use-card-list-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 0;
    text-align: left;
  }

  .ai-how-to-use-card-list-{{ ai_gen_id }} li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin-bottom: 8px;
    font-size: {{ block.settings.card_text_size }}px;
    color: {{ block.settings.card_text_color }};
    line-height: 1.5;
  }

  .ai-how-to-use-card-list-{{ ai_gen_id }} li:last-child {
    margin-bottom: 0;
  }

  .ai-how-to-use-checkmark-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    margin-top: 2px;
  }

  .ai-how-to-use-checkmark-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    fill: {{ block.settings.checkmark_color }};
  }
{% endstyle %}

