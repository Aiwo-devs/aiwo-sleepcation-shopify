{% comment %}
  ============================================================
  Section  : Lab-Verified Purity Stats Banner
  Brand    : AIWO EVOO
  Version  : 1.3.1
  ============================================================
  Layout   : 4-col desktop/tablet → 2×2 mobile
  Border   : Top + Left + Right only (no bottom), 1px, rgba(82,106,122,0.48)
  Radius   : 24px top corners, 0px bottom corners for all cards
  Updates  : All fonts set to Poppins, Mobile row-gap changed to 12px
  ============================================================
{% endcomment %}

{%- comment %} Load Poppins if not already loaded by theme {%- endcomment %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600;1,700&display=swap" rel="stylesheet">

<section
  class="lvp"
  id="lvp-{{ section.id }}"
  aria-label="{{ section.settings.heading }}"
>
  <div class="lvp__container">

    {%- comment %} ── HEADING ── {%- endcomment %}
    {%- if section.settings.heading != blank -%}
      <h2 class="lvp__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- comment %} ── STATS GRID ── {%- endcomment %}
    {%- if section.blocks.size > 0 -%}
      <div class="lvp__frame">
        {%- for block in section.blocks -%}
          <div class="lvp__card" {{ block.shopify_attributes }}>
            {%- if block.settings.stat != blank -%}
              <h3 class="lvp__stat">{{ block.settings.stat }}</h3>
            {%- endif -%}
            {%- if block.settings.label != blank -%}
              <p class="lvp__label">{{ block.settings.label }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</section>

<style>
  /* ─────────────────────────────────────────────────────
     Design Tokens
  ───────────────────────────────────────────────────── */
  #lvp-{{ section.id }} {
    --lvp-bg:                #EEF7FD;
    --lvp-container-max:     1400px;
    --lvp-font-family:       'Poppins', sans-serif;
    
    --lvp-heading-size:      32px;
    --lvp-heading-color:     #211E1E;
    --lvp-heading-mb:        32px;
    --lvp-stat-size:         40px;
    --lvp-stat-color:        #211E1E;
    --lvp-stat-mb:           32px;
    --lvp-label-size:        18px;
    --lvp-label-color:       #545252;
    --lvp-border:            1px solid rgba(82, 106, 122, 0.48);
    --lvp-card-radius:       24px;
    --lvp-card-pad-top:      24px;
    --lvp-card-pad-x:        32px;
    --lvp-card-pad-bottom:   32px;
  }

  /* ─────────────────────────────────────────────────────
     Section Wrapper 
  ───────────────────────────────────────────────────── */
  #lvp-{{ section.id }} {
    background-color: var(--lvp-bg);
    padding: 48px 60px;
    width: 100%;
    font-family: var(--lvp-font-family); /* Applied globally to section */
  }

  /* ─────────────────────────────────────────────────────
     Container
  ───────────────────────────────────────────────────── */
  #lvp-{{ section.id }} .lvp__container {
    max-width: var(--lvp-container-max);
    margin: 0 auto;
    padding: 0;
  }

  /* ─────────────────────────────────────────────────────
     Heading
  ───────────────────────────────────────────────────── */
  #lvp-{{ section.id }} .lvp__heading {
    font-family: var(--lvp-font-family);
    font-size: var(--lvp-heading-size);
    font-weight: 600;
    font-style: italic;
    line-height: 120%;
    color: var(--lvp-heading-color);
    text-align: center;
    margin: 0 0 var(--lvp-heading-mb);
  }

  /* ─────────────────────────────────────────────────────
     Grid Frame
  ───────────────────────────────────────────────────── */
  #lvp-{{ section.id }} .lvp__frame {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
  }

  /* ─────────────────────────────────────────────────────
     Stat Card 
  ───────────────────────────────────────────────────── */
  #lvp-{{ section.id }} .lvp__card {
    display: flex;
    flex-direction: column;
    align-items: center; 
    text-align: center;  
    padding: var(--lvp-card-pad-top) var(--lvp-card-pad-x) var(--lvp-card-pad-bottom);
    /* Format: top-left | top-right | bottom-right | bottom-left */
    border-radius: var(--lvp-card-radius) var(--lvp-card-radius) 0px 0px; 
    border-top:    var(--lvp-border);      
    border-bottom: none;                   
    border-left:   none;                   
    border-right:  none;                   
  }

  /* ──────────────────────────────────────────────────────
     Desktop border rules 
  ────────────────────────────────────────────────────── */

  /* Card 1 — top only */
  #lvp-{{ section.id }} .lvp__card:nth-child(1) {
    border-left:  none;
    border-right: none;
  }

  /* Cards 2, 3, 4 — top + left */
  #lvp-{{ section.id }} .lvp__card:nth-child(2),
  #lvp-{{ section.id }} .lvp__card:nth-child(3),
  #lvp-{{ section.id }} .lvp__card:nth-child(4) {
    border-left:  var(--lvp-border);
    border-right: none;
  }

  /* ─────────────────────────────────────────────────────
     Stat Value (40px bold)
  ───────────────────────────────────────────────────── */
  #lvp-{{ section.id }} .lvp__stat {
    font-family: var(--lvp-font-family);
    font-size: var(--lvp-stat-size);
    font-weight: 700;
    line-height: 110%;
    color: var(--lvp-stat-color);
    margin: 0 0 var(--lvp-stat-mb);
  }

  /* ─────────────────────────────────────────────────────
     Stat Label (18px medium)
  ───────────────────────────────────────────────────── */
  #lvp-{{ section.id }} .lvp__label {
    font-family: var(--lvp-font-family);
    font-size: var(--lvp-label-size);
    font-weight: 500;
    line-height: 140%;
    color: var(--lvp-label-color);
    margin: 0;
  }

  /* ─────────────────────────────────────────────────────
     RESPONSIVE — Tablet (max-width: 991px)
  ───────────────────────────────────────────────────── */
  @media screen and (max-width: 991px) {
    #lvp-{{ section.id }} {
      padding: 56px 40px; 
      --lvp-heading-size:    26px;
      --lvp-stat-size:       32px;
      --lvp-label-size:      16px;
      --lvp-card-pad-x:      20px;
      --lvp-stat-mb:         20px;
    }
  }

  /* ─────────────────────────────────────────────────────
     RESPONSIVE — Mobile Landscape (max-width: 767px)
  ───────────────────────────────────────────────────── */
  @media screen and (max-width: 767px) {
    #lvp-{{ section.id }} {
      padding: 40px 24px; 
      --lvp-heading-size:    22px;
      --lvp-heading-mb:      24px;
      --lvp-stat-size:       28px;
      --lvp-label-size:      15px;
      --lvp-card-pad-x:      20px;
      --lvp-card-pad-top:    20px;
      --lvp-card-pad-bottom: 20px;
      --lvp-stat-mb:         12px;
    }

    #lvp-{{ section.id }} .lvp__frame {
      grid-template-columns: repeat(2, 1fr);
      row-gap: 12px; /* UPDATED: Changed from 24px to 12px */
    }

    /* Card Borders for 2x2 grid */
    #lvp-{{ section.id }} .lvp__card:nth-child(1) { border-left: none; }
    #lvp-{{ section.id }} .lvp__card:nth-child(2) { border-left: var(--lvp-border); }
    #lvp-{{ section.id }} .lvp__card:nth-child(3) { border-left: none; }
    #lvp-{{ section.id }} .lvp__card:nth-child(4) { border-left: var(--lvp-border); }
  }

  /* ─────────────────────────────────────────────────────
     RESPONSIVE — Mobile Portrait (max-width: 479px)
  ───────────────────────────────────────────────────── */
  @media screen and (max-width: 479px) {
    #lvp-{{ section.id }} {
      padding: 32px 20px; 
      --lvp-heading-size:    20px;
      --lvp-stat-size:       24px;
      --lvp-label-size:      13px;
      --lvp-card-pad-x:      16px;
      --lvp-card-pad-top:    16px;
      --lvp-card-pad-bottom: 16px;
      --lvp-stat-mb:         8px;
    }
  }
</style>

{% schema %}
{
  "name": "Lab-Verified Purity Stats",
  "tag": "section",
  "class": "section-lab-verified-purity",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "info": "Displays in semibold italic. Include * or formatting as needed.",
      "default": "*Lab-Verified Purity"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "text",
          "id": "stat",
          "label": "Stat Value",
          "info": "E.g. 'Ultra Low', '< 15 meq/kg', '250+', '23 Months'",
          "default": "Ultra Low"
        },
        {
          "type": "textarea",
          "id": "label",
          "label": "Stat Label",
          "info": "Supporting description below the stat. Line breaks allowed.",
          "default": "Acidity\n(80% below limit)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lab-Verified Purity Stats",
      "blocks": [
        {
          "type": "stat",
          "settings": {
            "stat": "Ultra Low",
            "label": "Acidity\n(80% below limit)"
          }
        },
        {
          "type": "stat",
          "settings": {
            "stat": "< 15 meq/kg",
            "label": "Peroxide\n(70% below limit)"
          }
        },
        {
          "type": "stat",
          "settings": {
            "stat": "250+",
            "label": "Pesticides tested:\nNone detected"
          }
        },
        {
          "type": "stat",
          "settings": {
            "stat": "23 Months",
            "label": "Shelf life\n(lab-verified)"
          }
        }
      ]
    }
  ]
}
{% endschema %}