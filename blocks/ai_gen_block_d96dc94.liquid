{% doc %}
  @prompt
    Create 3-column grid section (peach to cream gradient background):
    
    Heading: "Why Absorption Matters"
    Subtitle about standard curcumin absorption
    Three cards with white background, orange border, hover lift effect:
    
    Card 1: Trophy emoji 🏆, "Patented Formula" heading, description of BCM-95®
    Card 2: Orange circle badge with "7×", "Better Absorption" heading, clinical study description
    Card 3: Shield emoji 🛡️, "Clinically Tested" heading, trial validation description
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-absorption-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 60px 20px;
    background: linear-gradient(135deg, {{ block.settings.gradient_start }} 0%, {{ block.settings.gradient_end }} 100%);
  }

  .ai-absorption-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-absorption-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 50px;
  }

  .ai-absorption-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 15px 0;
    font-weight: 700;
  }

  .ai-absorption-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
    margin: 0;
    line-height: 1.6;
  }

  .ai-absorption-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
  }

  .ai-absorption-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: 40px 30px;
    text-align: center;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-absorption-card-{{ ai_gen_id }}:hover {
    transform: translateY(-{{ block.settings.hover_lift }}px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
  }

  .ai-absorption-icon-{{ ai_gen_id }} {
    font-size: {{ block.settings.icon_size }}px;
    margin-bottom: 20px;
    display: block;
  }

  .ai-absorption-badge-{{ ai_gen_id }} {
    width: {{ block.settings.badge_size }}px;
    height: {{ block.settings.badge_size }}px;
    background-color: {{ block.settings.badge_background }};
    color: {{ block.settings.badge_text_color }};
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 20px;
    font-size: {{ block.settings.badge_text_size }}px;
    font-weight: 700;
  }

  .ai-absorption-card-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_heading_size }}px;
    color: {{ block.settings.card_heading_color }};
    margin: 0 0 15px 0;
    font-weight: 600;
  }

  .ai-absorption-card-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_text_size }}px;
    color: {{ block.settings.card_text_color }};
    line-height: 1.6;
    margin: 0;
  }

  @media screen and (max-width: 989px) {
    .ai-absorption-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: 25px;
    }

    .ai-absorption-card-{{ ai_gen_id }} {
      padding: 30px 20px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-absorption-section-{{ ai_gen_id }} {
      padding: 40px 15px;
    }

    .ai-absorption-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .ai-absorption-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }

    .ai-absorption-subtitle-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subtitle_size }}px * 0.9);
    }

    .ai-absorption-card-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.card_heading_size }}px * 0.9);
    }
  }
{% endstyle %}

<div class="ai-absorption-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-absorption-container-{{ ai_gen_id }}">
    <div class="ai-absorption-header-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h2 class="ai-absorption-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {% endif %}
      {% if block.settings.subtitle != blank %}
        <div class="ai-absorption-subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</div>
      {% endif %}
    </div>

    <div class="ai-absorption-grid-{{ ai_gen_id }}">
      <div class="ai-absorption-card-{{ ai_gen_id }}">
        {% if block.settings.card_1_icon != blank %}
          <span class="ai-absorption-icon-{{ ai_gen_id }}">{{ block.settings.card_1_icon }}</span>
        {% endif %}
        {% if block.settings.card_1_heading != blank %}
          <h3 class="ai-absorption-card-heading-{{ ai_gen_id }}">{{ block.settings.card_1_heading }}</h3>
        {% endif %}
        {% if block.settings.card_1_text != blank %}
          <div class="ai-absorption-card-text-{{ ai_gen_id }}">{{ block.settings.card_1_text }}</div>
        {% endif %}
      </div>

      <div class="ai-absorption-card-{{ ai_gen_id }}">
        {% if block.settings.show_badge %}
          <div class="ai-absorption-badge-{{ ai_gen_id }}">{{ block.settings.badge_text }}</div>
        {% else %}
          {% if block.settings.card_2_icon != blank %}
            <span class="ai-absorption-icon-{{ ai_gen_id }}">{{ block.settings.card_2_icon }}</span>
          {% endif %}
        {% endif %}
        {% if block.settings.card_2_heading != blank %}
          <h3 class="ai-absorption-card-heading-{{ ai_gen_id }}">{{ block.settings.card_2_heading }}</h3>
        {% endif %}
        {% if block.settings.card_2_text != blank %}
          <div class="ai-absorption-card-text-{{ ai_gen_id }}">{{ block.settings.card_2_text }}</div>
        {% endif %}
      </div>

      <div class="ai-absorption-card-{{ ai_gen_id }}">
        {% if block.settings.card_3_icon != blank %}
          <span class="ai-absorption-icon-{{ ai_gen_id }}">{{ block.settings.card_3_icon }}</span>
        {% endif %}
        {% if block.settings.card_3_heading != blank %}
          <h3 class="ai-absorption-card-heading-{{ ai_gen_id }}">{{ block.settings.card_3_heading }}</h3>
        {% endif %}
        {% if block.settings.card_3_text != blank %}
          <div class="ai-absorption-card-text-{{ ai_gen_id }}">{{ block.settings.card_3_text }}</div>
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
