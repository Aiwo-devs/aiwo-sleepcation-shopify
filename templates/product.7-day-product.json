        "heading_h9PMdB": {
          "type": "heading",
          "settings": {
            "subheading": "",
            "heading": "Healthcare Services",
            "highlight_type": "underline",
            "heading_base_size": 100,
            "heading_tag": "h2",
            "text": "<p><strong>Comprehensive Blood Test and Analysis</strong> for a deep understanding of your health.</p><p><strong>Advanced Cardiac Health Assessments</strong> including ECG, ECHO, and CT-CAC Score Tests, provide detailed insights into heart health.</p><p><strong>Complete Cardiovascular Fitness Evaluation</strong> with Treadmill Test and VO2 Max Test.</p><p><strong>Full Abdomen Ultrasound</strong> for thorough internal health check.</p><p><strong>Nutritional and Inflammatory Profile Analysis</strong> through Omega3 / Omega6 tests</p><p><strong>Gut Health Examination</strong> with Gut Microbiome and Food Intolerance Testing.</p><p><strong>Bone Health and Body Composition Analysis</strong> with a Detailed DEXA Scan.</p><p><strong>Posture Screening Assessment and Correction</strong> for optimal physical alignment.</p><p><strong>Comprehensive Radiological Assessments</strong> including Chest X-ray.</p><p><strong>Expert Consultations:</strong> Doctor, Psychologist, Dietitian, Physiotherapist, and Dentist.</p><p><strong>Dental Scaling</strong> for enhanced oral health.</p><p><strong>Optional Fitness Analysis</strong> for enthusiasts with RMR test.</p><p><strong>Supplements for 30 days.</strong></p>",
            "number_of_lines_shown": "none",
            "read_more_label": "Read more",
            "see_less_label": "See less",
