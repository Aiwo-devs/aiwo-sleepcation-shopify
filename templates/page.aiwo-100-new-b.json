ment.style.color = '#3C763D'; // Green text\n            widgetContainer.style.display = 'block'; // Show the widget container\n        } else {\n            messageElement.style.display = 'block';\n            messageElement.textContent = 'Service not available at your pincode';\n            messageElement.style.color = '#A94442'; // Red text\n            widgetContainer.style.display = 'none'; // Hide the widget container\n        }\n    }\n\n    // Event listener for the Enter key on the pincode input\n    document.getElementById('pincode-input').addEventListener('keyup', function(event) {\n        // Number 13 is the \"Enter\" key on the keyboard\n        if (event.keyCode === 13) {\n            // Cancel the default action if needed\n            event.preventDefault();\n            // Trigger the button element with a click\n            validatePincode();\n        }\n    });\n\n    // Adding focus and blur event listeners to handle the box-shadow\n    var pincodeInput = document.getElementById('pincode-input');\n    pincodeInput.addEventListener('focus', function() {\n        this.style.boxShadow = '0 0 5px 1px rgba(0,0,0,0.2)';\n    });\n    pincodeInput.addEventListener('blur', function() {\n        this.style.boxShadow = '0 0 0 0 rgba(0,0,0,0.2)';\n    });\n</script>",
