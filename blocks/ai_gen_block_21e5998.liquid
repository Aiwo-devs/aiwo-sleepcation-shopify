{% doc %}
  @prompt
    Create a multi-column section with 4 icon blocks in a grid: Column 1 - Heart icon, 'Heart Health', 'Supports cardiovascular function'; Column 2 - Brain icon, 'Mental Clarity', 'Enhances cognitive performance'; Column 3 - Joint icon, 'Joint Support', 'Reduces inflammation'; Column 4 - Shield icon, 'Purity Guaranteed', 'Third-party tested'. Each block should have icon at top, bold heading, short description, light background, equal height cards, 2-column mobile layout.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-icon-grid-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 40px 20px;
  }

  .ai-icon-grid__container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: {{ block.settings.gap }}px;
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-icon-grid__card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    height: 100%;
  }

  .ai-icon-grid__icon-wrapper-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    margin-bottom: {{ block.settings.icon_spacing }}px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-icon-grid__icon-wrapper-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    stroke: {{ block.settings.icon_color }};
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .ai-icon-grid__heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 700;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.heading_spacing }}px 0;
    line-height: 1.3;
  }

  .ai-icon-grid__description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    margin: 0;
    line-height: 1.5;
  }

  @media screen and (max-width: 749px) {
    .ai-icon-grid__container-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: {{ block.settings.gap_mobile }}px;
    }

    .ai-icon-grid__icon-wrapper-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size | times: 0.8 }}px;
      height: {{ block.settings.icon_size | times: 0.8 }}px;
    }

    .ai-icon-grid__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.9 }}px;
    }

    .ai-icon-grid__description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="ai-icon-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-icon-grid__container-{{ ai_gen_id }}">
    <div class="ai-icon-grid__card-{{ ai_gen_id }}">
      <div class="ai-icon-grid__icon-wrapper-{{ ai_gen_id }}">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
        </svg>
      </div>
      <h3 class="ai-icon-grid__heading-{{ ai_gen_id }}">{{ block.settings.heading_1 }}</h3>
      <p class="ai-icon-grid__description-{{ ai_gen_id }}">{{ block.settings.description_1 }}</p>
    </div>

    <div class="ai-icon-grid__card-{{ ai_gen_id }}">
      <div class="ai-icon-grid__icon-wrapper-{{ ai_gen_id }}">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
          <path d="M12 2a9 9 0 0 0-9 9v4a9 9 0 0 0 18 0v-4a9 9 0 0 0-9-9z"></path>
          <path d="M12 18a6 6 0 0 0 6-6V9a6 6 0 0 0-12 0v3a6 6 0 0 0 6 6z"></path>
          <circle cx="12" cy="12" r="2"></circle>
        </svg>
      </div>
      <h3 class="ai-icon-grid__heading-{{ ai_gen_id }}">{{ block.settings.heading_2 }}</h3>
      <p class="ai-icon-grid__description-{{ ai_gen_id }}">{{ block.settings.description_2 }}</p>
    </div>

    <div class="ai-icon-grid__card-{{ ai_gen_id }}">
      <div class="ai-icon-grid__icon-wrapper-{{ ai_gen_id }}">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
          <circle cx="12" cy="8" r="3"></circle>
          <path d="M12 14c-4 0-8 2-8 6v2h16v-2c0-4-4-6-8-6z"></path>
          <path d="M6 8a6 6 0 0 1 12 0"></path>
          <path d="M8 14l-2 8"></path>
          <path d="M16 14l2 8"></path>
        </svg>
      </div>
      <h3 class="ai-icon-grid__heading-{{ ai_gen_id }}">{{ block.settings.heading_3 }}</h3>
      <p class="ai-icon-grid__description-{{ ai_gen_id }}">{{ block.settings.description_3 }}</p>
    </div>

    <div class="ai-icon-grid__card-{{ ai_gen_id }}">
      <div class="ai-icon-grid__icon-wrapper-{{ ai_gen_id }}">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          <path d="M9 12l2 2 4-4"></path>
        </svg>
      </div>
      <h3 class="ai-icon-grid__heading-{{ ai_gen_id }}">{{ block.settings.heading_4 }}</h3>
      <p class="ai-icon-grid__description-{{ ai_gen_id }}">{{ block.settings.description_4 }}</p>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Icon grid",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 800,
      "max": 1600,
      "step": 100,
      "unit": "px",
      "label": "Maximum width",
      "default": 1200
    },
    {
      "type": "range",
      "id": "gap",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "Gap between cards",
      "default": 30
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "min": 10,
      "max": 40,
      "step": 5,
      "unit": "px",
      "label": "Gap on mobile",
      "default": 20
    },
    {
      "type": "header",
      "content": "Card style"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Background",
      "default": "#f8f8f8"
    },
    {
      "type": "range",
      "id": "card_padding",
      "min": 20,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "Padding",
      "default": 30
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Border radius",
      "default": 8
    },
    {
      "type": "header",
      "content": "Icon"
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 30,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Size",
      "default": 50
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Color",
      "default": "#FB8500"
    },
    {
      "type": "range",
      "id": "icon_spacing",
      "min": 10,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Spacing below icon",
      "default": 20
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "label": "Heading size",
      "default": 18
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "min": 5,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Heading spacing",
      "default": 10
    },
    {
      "type": "range",
      "id": "description_size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Description size",
      "default": 14
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description color",
      "default": "#525151"
    },
    {
      "type": "header",
      "content": "Column 1"
    },
    {
      "type": "text",
      "id": "heading_1",
      "label": "Heading",
      "default": "Heart Health"
    },
    {
      "type": "text",
      "id": "description_1",
      "label": "Description",
      "default": "Supports cardiovascular function"
    },
    {
      "type": "header",
      "content": "Column 2"
    },
    {
      "type": "text",
      "id": "heading_2",
      "label": "Heading",
      "default": "Mental Clarity"
    },
    {
      "type": "text",
      "id": "description_2",
      "label": "Description",
      "default": "Enhances cognitive performance"
    },
    {
      "type": "header",
      "content": "Column 3"
    },
    {
      "type": "text",
      "id": "heading_3",
      "label": "Heading",
      "default": "Joint Support"
    },
    {
      "type": "text",
      "id": "description_3",
      "label": "Description",
      "default": "Reduces inflammation"
    },
    {
      "type": "header",
      "content": "Column 4"
    },
    {
      "type": "text",
      "id": "heading_4",
      "label": "Heading",
      "default": "Purity Guaranteed"
