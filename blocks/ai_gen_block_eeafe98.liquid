{% doc %}
  @prompt
    Design a "Benefit Timeline" and "Important Guidelines" sections for AIWO Ultimate Omega 3.
    Section 1 - What to Expect: Benefit Timeline
    Layout:
    Full-width section, white background, centered content, padding top and bottom.
    Header:
    
    Centered bold heading (large black): "What to Expect: Benefit Timeline"
    
    Timeline Cards (4 columns, equal width):
    Card 1:
    
    Navy pill badge at top: "Week 1-2"
    Bold heading: "Improved omega-3 levels in blood"
    Gray description text: "Initial absorption and circulation"
    White card with border, rounded corners
    
    Card 2:
    
    Navy pill badge at top: "Week 4-6"
    Bold heading: "Enhanced heart rhythm support"
    Gray description text: "Anti-arrhythmic effects begin"
    White card with border, rounded corners
    
    Card 3:
    
    Navy pill badge at top: "Week 8-12"
    Bold heading: "Cardio protective benefits"
    Gray description text: "Full vasodilation and anti-inflammatory effects"
    White card with border, rounded corners
    
    Card 4:
    
    Navy pill badge at top: "Week 12+"
    Bold heading: "Long-term wellness support"
    Gray description text: "Sustained heart, brain, and joint health"
    White card with border, rounded corners
    
    Card Styling: Equal height, centered text, subtle shadow, hover effect.
    Responsive: 4 columns desktop, 2 columns tablet, 1 column mobile.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-benefit-timeline-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_top }}px 20px {{ block.settings.padding_bottom }}px;
  }

  .ai-benefit-timeline__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
  }

  .ai-benefit-timeline__heading-{{ ai_gen_id }} {
    text-align: center;
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 700;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.heading_spacing }}px;
  }

  .ai-benefit-timeline__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: {{ block.settings.card_gap }}px;
  }

  .ai-benefit-timeline__card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    text-align: center;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    box-shadow: {{ block.settings.card_shadow_x }}px {{ block.settings.card_shadow_y }}px {{ block.settings.card_shadow_blur }}px {{ block.settings.card_shadow_color }};
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .ai-benefit-timeline__card-{{ ai_gen_id }}:hover {
    transform: translateY(-{{ block.settings.hover_lift }}px);
    box-shadow: {{ block.settings.card_shadow_x }}px {{ block.settings.card_shadow_y | plus: 4 }}px {{ block.settings.card_shadow_blur | plus: 8 }}px {{ block.settings.card_shadow_color }};
  }

  .ai-benefit-timeline__badge-{{ ai_gen_id }} {
    display: inline-block;
    background-color: {{ block.settings.badge_background }};
    color: {{ block.settings.badge_text_color }};
    padding: {{ block.settings.badge_padding_vertical }}px {{ block.settings.badge_padding_horizontal }}px;
    border-radius: {{ block.settings.badge_border_radius }}px;
    font-size: {{ block.settings.badge_font_size }}px;
    font-weight: 600;
    margin-bottom: {{ block.settings.badge_spacing }}px;
  }

  .ai-benefit-timeline__card-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_heading_size }}px;
    font-weight: 700;
    color: {{ block.settings.card_heading_color }};
    margin: 0 0 {{ block.settings.card_heading_spacing }}px;
  }

  .ai-benefit-timeline__card-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_description_size }}px;
    color: {{ block.settings.card_description_color }};
    margin: 0;
    line-height: 1.5;
  }

  @media screen and (max-width: 989px) {
    .ai-benefit-timeline__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-benefit-timeline__grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-benefit-timeline__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .ai-benefit-timeline-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top | times: 0.7 }}px 16px {{ block.settings.padding_bottom | times: 0.7 }}px;
    }
  }
{% endstyle %}

<benefit-timeline-{{ ai_gen_id }} class="ai-benefit-timeline-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-benefit-timeline__container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-benefit-timeline__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    <div class="ai-benefit-timeline__grid-{{ ai_gen_id }}">
      {% for i in (1..4) %}
        {% liquid
          assign badge_key = 'card_' | append: i | append: '_badge'
          assign heading_key = 'card_' | append: i | append: '_heading'
          assign description_key = 'card_' | append: i | append: '_description'
          
          assign badge = block.settings[badge_key]
          assign heading = block.settings[heading_key]
          assign description = block.settings[description_key]
        %}

        <div class="ai-benefit-timeline__card-{{ ai_gen_id }}">
          {% if badge != blank %}
            <span class="ai-benefit-timeline__badge-{{ ai_gen_id }}">{{ badge }}</span>
          {% endif %}

          {% if heading != blank %}
            <h3 class="ai-benefit-timeline__card-heading-{{ ai_gen_id }}">{{ heading }}</h3>
          {% endif %}

          {% if description != blank %}
            <p class="ai-benefit-timeline__card-description-{{ ai_gen_id }}">{{ description }}</p>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</benefit-timeline-{{ ai_gen_id }}>

<script>
  (function() {
    class BenefitTimeline{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.cards = this.querySelectorAll('.ai-benefit-timeline__card-{{ ai_gen_id }}');
        this.equalizeCardHeights();
        window.addEventListener('resize', () => this.equalizeCardHeights());
      }

      equalizeCardHeights() {
        if (window.innerWidth > 749) {
          let maxHeight = 0;
          this.cards.forEach(card => {
            card.style.height = 'auto';
            const height = card.offsetHeight;
            if (height > maxHeight) {
              maxHeight = height;
            }
          });
          this.cards.forEach(card => {
            card.style.height = maxHeight + 'px';
          });
        } else {
          this.cards.forEach(card => {
            card.style.height = 'auto';
          });
        }
      }
    }

    customElements.define('benefit-timeline-{{ ai_gen_id }}', BenefitTimeline{{ ai_gen_id }});
  })();
</script>

