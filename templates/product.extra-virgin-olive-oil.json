            "title_size": 14,
            "location_size": 13,
            "testimonial_1_enabled": true,
            "testimonial_1_quote": "I've tried every premium EVOO in Delhi's gourmet stores. AIWO is the first that actually tastes fresh—that peppery bite at the back of your throat? That's real polyphenols, not marketing. The QR code with lab results sealed the deal for me.",
            "testimonial_1_name": "Priya Malhotra",
