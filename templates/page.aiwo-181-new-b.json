    "faq_4JhpGN": {
      "type": "faq",
      "blocks": {
        "frequently_asked_question_EP64mk": {
          "type": "frequently_asked_question",
          "settings": {
            "icon": "heart",
            "another_icon": "",
            "custom_icon": "",
            "heading": "Who is the AIWO 181 test for?",
            "row_content": "<p>It's for anyone serious about their health. Whether you're an athlete optimizing performance, an individual managing a chronic condition, or simply someone who wants to move from feeling \"fine\" to \"fantastic\" through preventive health.</p>"
          }
        },
        "frequently_asked_question_mK4jQW": {
          "type": "frequently_asked_question",
          "settings": {
            "icon": "heart",
            "another_icon": "",
            "custom_icon": "",
            "heading": "Do I need to fast for the test?",
            "row_content": "<p>Yes. A 10-12 hour fast is required for accurate results for markers like fasting blood sugar and lipids. We will provide detailed instructions before your appointment.</p>"
          }
        },
        "frequently_asked_question_6d9PWy": {
          "type": "frequently_asked_question",
          "settings": {
            "icon": "heart",
            "another_icon": "",
            "custom_icon": "",
            "heading": "How is the sample collected?",
            "row_content": "<p>Sample collection is done conveniently at your home or office by a certified phlebotomist</p>"
          }
        },
        "frequently_asked_question_q6cWXm": {
          "type": "frequently_asked_question",
          "settings": {
            "icon": "heart",
            "another_icon": "",
            "custom_icon": "",
            "heading": "What do the expert consultations include?",
            "row_content": "<p>Your AIWO 181 package includes two separate consultations. First, a qualified doctor will explain your medical results and risk factors. Second, an expert nutritionist will help you build a practical, effective diet plan based on your unique biomarker data to help you achieve your health goals.</p>"
          }
        }
      },
