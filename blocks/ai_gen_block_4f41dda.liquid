{% doc %}
  @prompt
    Create ingredients section with light muted background:
    Layout: 2 columns (stack on mobile)
    Left Column - Nutritional Card:
    
    Large white rounded card with shadow/border
    Heading: "Nutritional Information"
    Subtext: "Each enteric coated soft gelatin capsule contains (approx.)"
    5 ingredient rows, each showing:
    
    Name [EDITABLE]
    Amount (large, bold, right-aligned) [EDITABLE]
    Description (small, gray) [EDITABLE]
    
    
    First row highlighted: light blue bg, blue text, blue border
    EPA row: gold colored amount
    Bottom: Certification tags in green pills [EDITABLE, repeatable]
    
    Default: "Gelatin Food Grade", "Gluten Free", "HALAL", "GMP", "ISO"
    
    
    
    Right Column - Content:
    
    Gold pill badge: "Premium Ingredients"
    Large heading: "What's Inside" + "Every Capsule" (gold gradient)
    Gray description paragraph [EDITABLE]
    3 feature bullets with colored dot indicators:
    
    Ocean blue dot - "High Potency" + description [EDITABLE]
    Gold dot - "Optimal Ratio" + description [EDITABLE]
    Green dot - "Pure & Safe" + description [EDITABLE]
    
    
    
    Default 5 Ingredients:
    
    Fish Oil - 1000mg - "Premium quality molecularly distilled"
    Total Omega-3 - 660mg - "High concentration of essential fatty acids"
    EPA - 360mg - "Eicosapentaenoic Acid (36%)" (Gold amount)
    DHA - 240mg - "Docosahexaenoic Acid (24%)"
    Other Omega-3 - 60mg - "Additional beneficial fatty acids"
    
    Responsive: Stack vertically on mobile (content first, card second)
    All ingredient rows, amounts, descriptions, bullets, and tags editable via Shopify settings., Every row has a light gray   background with outer line expect first highlighted one and right scetion should be Vertical centered align
    
    Font size should be editable
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-ingredients-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.section_background }};
    padding: 60px 20px;
  }

  .ai-ingredients-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: center;
  }

  .ai-ingredients-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: 40px;
    box-shadow: {{ block.settings.card_shadow }};
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
  }

  .ai-ingredients-card-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_heading_size }}px;
    font-weight: 700;
    color: {{ block.settings.card_heading_color }};
    margin: 0 0 8px 0;
  }

  .ai-ingredients-card-subtext-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_subtext_size }}px;
    color: {{ block.settings.card_subtext_color }};
    margin: 0 0 24px 0;
  }

  .ai-ingredients-row-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: 16px;
    margin-bottom: 12px;
    background-color: {{ block.settings.row_background }};
    border: 1px solid {{ block.settings.row_border_color }};
    border-radius: 8px;
  }

  .ai-ingredients-row-{{ ai_gen_id }}:last-of-type {
    margin-bottom: 24px;
  }

  .ai-ingredients-row-highlighted-{{ ai_gen_id }} {
    background-color: {{ block.settings.highlight_background }};
    border-color: {{ block.settings.highlight_border }};
  }

  .ai-ingredients-row-left-{{ ai_gen_id }} {
    flex: 1;
  }

  .ai-ingredients-name-{{ ai_gen_id }} {
    font-size: {{ block.settings.ingredient_name_size }}px;
    font-weight: 600;
    color: {{ block.settings.ingredient_name_color }};
    margin: 0 0 4px 0;
  }

  .ai-ingredients-row-highlighted-{{ ai_gen_id }} .ai-ingredients-name-{{ ai_gen_id }} {
    color: {{ block.settings.highlight_text_color }};
  }

  .ai-ingredients-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.ingredient_description_size }}px;
    color: {{ block.settings.ingredient_description_color }};
    margin: 0;
  }

  .ai-ingredients-amount-{{ ai_gen_id }} {
    font-size: {{ block.settings.ingredient_amount_size }}px;
    font-weight: 700;
    color: {{ block.settings.ingredient_amount_color }};
    text-align: right;
    white-space: nowrap;
    margin-left: 16px;
  }

  .ai-ingredients-amount-gold-{{ ai_gen_id }} {
    color: {{ block.settings.gold_color }};
  }

  .ai-ingredients-certifications-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .ai-ingredients-cert-tag-{{ ai_gen_id }} {
    display: inline-block;
    padding: 6px 14px;
    background-color: {{ block.settings.cert_background }};
    color: {{ block.settings.cert_text_color }};
    border-radius: 20px;
    font-size: {{ block.settings.cert_text_size }}px;
    font-weight: 500;
  }

  .ai-ingredients-content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .ai-ingredients-badge-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    background: {{ block.settings.badge_background }};
    color: {{ block.settings.badge_text_color }};
    border-radius: 20px;
    font-size: {{ block.settings.badge_text_size }}px;
    font-weight: 600;
    margin-bottom: 16px;
    width: fit-content;
  }

  .ai-ingredients-badge-icon-{{ ai_gen_id }} {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background-color: {{ block.settings.gold_color }};
  }

  .ai-ingredients-content-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.content_heading_size }}px;
    font-weight: 700;
    color: {{ block.settings.content_heading_color }};
    margin: 0 0 8px 0;
    line-height: 1.2;
  }

  .ai-ingredients-content-heading-gold-{{ ai_gen_id }} {
    background: {{ block.settings.gold_gradient }};
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .ai-ingredients-content-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.content_description_size }}px;
    color: {{ block.settings.content_description_color }};
    margin: 0 0 24px 0;
    line-height: 1.6;
  }

  .ai-ingredients-features-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .ai-ingredients-feature-{{ ai_gen_id }} {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }

  .ai-ingredients-feature-dot-{{ ai_gen_id }} {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    flex-shrink: 0;
    margin-top: 4px;
  }

  .ai-ingredients-feature-dot-blue-{{ ai_gen_id }} {
    background-color: {{ block.settings.dot_blue_color }};
  }

  .ai-ingredients-feature-dot-gold-{{ ai_gen_id }} {
    background-color: {{ block.settings.gold_color }};
  }

  .ai-ingredients-feature-dot-green-{{ ai_gen_id }} {
    background-color: {{ block.settings.dot_green_color }};
  }

  .ai-ingredients-feature-content-{{ ai_gen_id }} {
    flex: 1;
  }

  .ai-ingredients-feature-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.feature_title_size }}px;
    font-weight: 600;
    color: {{ block.settings.feature_title_color }};
    margin: 0 0 4px 0;
  }

  .ai-ingredients-feature-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.feature_description_size }}px;
    color: {{ block.settings.feature_description_color }};
    margin: 0;
    line-height: 1.5;
  }

  @media screen and (max-width: 768px) {
    .ai-ingredients-container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .ai-ingredients-content-{{ ai_gen_id }} {
      order: -1;
    }

    .ai-ingredients-card-{{ ai_gen_id }} {
      padding: 24px;
    }

    .ai-ingredients-section-{{ ai_gen_id }} {
      padding: 40px 16px;
    }
  }
{% endstyle %}

<div class="ai-ingredients-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-ingredients-container-{{ ai_gen_id }}">
    <div class="ai-ingredients-card-{{ ai_gen_id }}">
      <h2 class="ai-ingredients-card-heading-{{ ai_gen_id }}">{{ block.settings.card_heading }}</h2>
      <p class="ai-ingredients-card-subtext-{{ ai_gen_id }}">{{ block.settings.card_subtext }}</p>

      {% for i in (1..5) %}
        {% liquid
          assign name_key = 'ingredient_' | append: i | append: '_name'
          assign amount_key = 'ingredient_' | append: i | append: '_amount'
          assign description_key = 'ingredient_' | append: i | append: '_description'
          assign is_gold_key = 'ingredient_' | append: i | append: '_gold'
          
          assign ingredient_name = block.settings[name_key]
          assign ingredient_amount = block.settings[amount_key]
          assign ingredient_description = block.settings[description_key]
          assign is_gold = block.settings[is_gold_key]
        %}

        {% if i == 1 %}
          <div class="ai-ingredients-row-{{ ai_gen_id }} ai-ingredients-row-highlighted-{{ ai_gen_id }}">
        {% else %}
          <div class="ai-ingredients-row-{{ ai_gen_id }}">
        {% endif %}
          <div class="ai-ingredients-row-left-{{ ai_gen_id }}">
            <h3 class="ai-ingredients-name-{{ ai_gen_id }}">{{ ingredient_name }}</h3>
            <p class="ai-ingredients-description-{{ ai_gen_id }}">{{ ingredient_description }}</p>
          </div>
          {% if is_gold %}
            <div class="ai-ingredients-amount-{{ ai_gen_id }} ai-ingredients-amount-gold-{{ ai_gen_id }}">{{ ingredient_amount }}</div>
          {% else %}
            <div class="ai-ingredients-amount-{{ ai_gen_id }}">{{ ingredient_amount }}</div>
          {% endif %}
        </div>
      {% endfor %}

      <div class="ai-ingredients-certifications-{{ ai_gen_id }}">
        {% if block.settings.cert_1 != blank %}
          <span class="ai-ingredients-cert-tag-{{ ai_gen_id }}">{{ block.settings.cert_1 }}</span>
        {% endif %}
        {% if block.settings.cert_2 != blank %}
          <span class="ai-ingredients-cert-tag-{{ ai_gen_id }}">{{ block.settings.cert_2 }}</span>
        {% endif %}
        {% if block.settings.cert_3 != blank %}
          <span class="ai-ingredients-cert-tag-{{ ai_gen_id }}">{{ block.settings.cert_3 }}</span>
        {% endif %}
        {% if block.settings.cert_4 != blank %}
          <span class="ai-ingredients-cert-tag-{{ ai_gen_id }}">{{ block.settings.cert_4 }}</span>
        {% endif %}
        {% if block.settings.cert_5 != blank %}
          <span class="ai-ingredients-cert-tag-{{ ai_gen_id }}">{{ block.settings.cert_5 }}</span>
        {% endif %}
      </div>
    </div>

    <div class="ai-ingredients-content-{{ ai_gen_id }}">
      <div class="ai-ingredients-badge-{{ ai_gen_id }}">
        <span class="ai-ingredients-badge-icon-{{ ai_gen_id }}"></span>
        {{ block.settings.badge_text }}
      </div>

      <h2 class="ai-ingredients-content-heading-{{ ai_gen_id }}">
        {{ block.settings.content_heading_1 }}
        <span class="ai-ingredients-content-heading-gold-{{ ai_gen_id }}">{{ block.settings.content_heading_2 }}</span>
      </h2>

      <p class="ai-ingredients-content-description-{{ ai_gen_id }}">{{ block.settings.content_description }}</p>

      <div class="ai-ingredients-features-{{ ai_gen_id }}">
        <div class="ai-ingredients-feature-{{ ai_gen_id }}">
          <div class="ai-ingredients-feature-dot-{{ ai_gen_id }} ai-ingredients-feature-dot-blue-{{ ai_gen_id }}"></div>
          <div class="ai-ingredients-feature-content-{{ ai_gen_id }}">
            <h3 class="ai-ingredients-feature-title-{{ ai_gen_id }}">{{ block.settings.feature_1_title }}</h3>
            <p class="ai-ingredients-feature-description-{{ ai_gen_id }}">{{ block.settings.feature_1_description }}</p>
          </div>
        </div>

        <div class="ai-ingredients-feature-{{ ai_gen_id }}">
          <div class="ai-ingredients-feature-dot-{{ ai_gen_id }} ai-ingredients-feature-dot-gold-{{ ai_gen_id }}"></div>
          <div class="ai-ingredients-feature-content-{{ ai_gen_id }}">
            <h3 class="ai-ingredients-feature-title-{{ ai_gen_id }}">{{ block.settings.feature_2_title }}</h3>
            <p class="ai-ingredients-feature-description-{{ ai_gen_id }}">{{ block.settings.feature_2_description }}</p>
          </div>
        </div>

        <div class="ai-ingredients-feature-{{ ai_gen_id }}">
          <div class="ai-ingredients-feature-dot-{{ ai_gen_id }} ai-ingredients-feature-dot-green-{{ ai_gen_id }}"></div>
          <div class="ai-ingredients-feature-content-{{ ai_gen_id }}">
            <h3 class="ai-ingredients-feature-title-{{ ai_gen_id }}">{{ block.settings.feature_3_title }}</h3>
            <p class="ai-ingredients-feature-description-{{ ai_gen_id }}">{{ block.settings.feature_3_description }}</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

