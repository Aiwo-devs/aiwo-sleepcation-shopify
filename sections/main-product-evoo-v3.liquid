  }
  .aiwo-v1-faq__question-text {
    font-family: 'Outfit', sans-serif;
    font-size: 16px;
    font-weight: 600;
    color: #1a1a1a;
    flex: 1;
  }
  .aiwo-v1-faq__icon {
    flex-shrink: 0;
    width: 24px;
    height: 24px;
  }
  .aiwo-v1-faq__icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .aiwo-v1-faq__icon--close { display: none; }
  .aiwo-v1-faq__item.active .aiwo-v1-faq__icon--open { display: none; }
  .aiwo-v1-faq__item.active .aiwo-v1-faq__icon--close { display: block; }
  .aiwo-v1-faq__answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }
  .aiwo-v1-faq__item.active .aiwo-v1-faq__answer {
    max-height: 600px;
  }
  .aiwo-v1-faq__answer-inner {
    font-family: 'Outfit', sans-serif;
    font-size: 14px;
    color: #555;
