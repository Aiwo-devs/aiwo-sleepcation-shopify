{% doc %}
  @prompt
    Design a "Quick Reference Guide" banner section for AIWO Ultimate Omega 3.
    Layout:
    Full-width banner with deep navy blue background (#0A1F5C), white text, rounded corners, generous padding (40px vertical, 60px horizontal).
    Header:
    
    Centered bold white heading (large): "Quick Reference Guide"
    Positioned at top of banner with spacing below
    
    Quick Reference Stats (3 columns, equal width):
    Column 1:
    
    Large bold white number: "1-2"
    Label below in white: "Capsules Daily"
    
    Column 2:
    
    Large bold white text: "With Food"
    Label below in white: "For Best Absorption"
    
    Column 3:
    
    Large bold white number: "8-12"
    Label below in white: "Weeks for Full Benefits"
    
    Styling:
    
    All content centered within columns
    Numbers/main text in extra-large bold font (48-56px)
    Labels in regular weight, smaller font (16-18px)
    Equal spacing between columns
    Adequate vertical spacing between main text and labels (12px)
    White text with high contrast against navy background
    
    Responsive: 3 columns on desktop, 3 columns on tablet, 1 column (stacked vertically) on mobile. Padding reduces on smaller screens (24px vertical).
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-quick-reference-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
    box-sizing: border-box;
  }

  .ai-quick-reference-heading-{{ ai_gen_id }} {
    text-align: center;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 700;
    margin: 0 0 {{ block.settings.heading_spacing }}px 0;
  }

  .ai-quick-reference-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.column_gap }}px;
    max-width: 100%;
  }

  .ai-quick-reference-column-{{ ai_gen_id }} {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
  }

  .ai-quick-reference-value-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.value_size }}px;
    font-weight: 700;
    margin: 0 0 {{ block.settings.label_spacing }}px 0;
    line-height: 1.2;
  }

  .ai-quick-reference-label-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.label_size }}px;
    font-weight: 400;
    margin: 0;
    line-height: 1.4;
  }

  @media screen and (max-width: 749px) {
    .ai-quick-reference-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_vertical_mobile }}px {{ block.settings.padding_horizontal_mobile }}px;
    }

    .ai-quick-reference-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.column_gap_mobile }}px;
    }

    .ai-quick-reference-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .ai-quick-reference-value-{{ ai_gen_id }} {
      font-size: {{ block.settings.value_size | times: 0.7 }}px;
    }

    .ai-quick-reference-label-{{ ai_gen_id }} {
      font-size: {{ block.settings.label_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<quick-reference-guide-{{ ai_gen_id }} class="ai-quick-reference-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <h2 class="ai-quick-reference-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
  {% endif %}

  <div class="ai-quick-reference-grid-{{ ai_gen_id }}">
    <div class="ai-quick-reference-column-{{ ai_gen_id }}">
      {% if block.settings.column_1_value != blank %}
        <div class="ai-quick-reference-value-{{ ai_gen_id }}">{{ block.settings.column_1_value }}</div>
      {% endif %}
      {% if block.settings.column_1_label != blank %}
        <div class="ai-quick-reference-label-{{ ai_gen_id }}">{{ block.settings.column_1_label }}</div>
      {% endif %}
    </div>

    <div class="ai-quick-reference-column-{{ ai_gen_id }}">
      {% if block.settings.column_2_value != blank %}
        <div class="ai-quick-reference-value-{{ ai_gen_id }}">{{ block.settings.column_2_value }}</div>
      {% endif %}
      {% if block.settings.column_2_label != blank %}
        <div class="ai-quick-reference-label-{{ ai_gen_id }}">{{ block.settings.column_2_label }}</div>
      {% endif %}
    </div>

    <div class="ai-quick-reference-column-{{ ai_gen_id }}">
      {% if block.settings.column_3_value != blank %}
        <div class="ai-quick-reference-value-{{ ai_gen_id }}">{{ block.settings.column_3_value }}</div>
      {% endif %}
      {% if block.settings.column_3_label != blank %}
        <div class="ai-quick-reference-label-{{ ai_gen_id }}">{{ block.settings.column_3_label }}</div>
      {% endif %}
    </div>
  </div>
</quick-reference-guide-{{ ai_gen_id }}>

<script>
  (function() {
    class QuickReferenceGuide{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }
    }

    customElements.define('quick-reference-guide-{{ ai_gen_id }}', QuickReferenceGuide{{ ai_gen_id }});
  })();
</script>

