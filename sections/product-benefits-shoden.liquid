                    method: 'POST',
                    headers: {'Content-Type':'application/json'},
                    body: JSON.stringify({items:[{id: parseInt(id), quantity:1}]})
                  }).then(function(r){ return r.json(); }).then(function(){
                    window.location.href = '/cart';
                  });
