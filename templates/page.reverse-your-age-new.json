    "faq_4JhpGN": {
      "type": "faq",
      "blocks": {
        "frequently_asked_question_EP64mk": {
          "type": "frequently_asked_question",
          "settings": {
            "icon": "heart",
            "another_icon": "",
            "custom_icon": "",
            "heading": "What is Epigenetic Age Testing?",
            "row_content": "<p>Epigenetic Age Testing is a groundbreaking approach to assess your biological age, which may differ from your chronological age. This test analyses DNA methylation patterns to provide insights into your overall health and wellness.</p>"
          }
        },
        "frequently_asked_question_mK4jQW": {
          "type": "frequently_asked_question",
          "settings": {
            "icon": "heart",
            "another_icon": "",
            "custom_icon": "",
            "heading": "How is this test different from other health tests?",
            "row_content": "<p>Unlike traditional tests that focus on specific health markers or conditions, Epigenetic Age Testing offers a comprehensive view of your overall health and ageing process. It helps in understanding the impact of lifestyle choices on your biological age.</p>"
          }
        },
        "frequently_asked_question_6d9PWy": {
          "type": "frequently_asked_question",
          "settings": {
            "icon": "heart",
            "another_icon": "",
            "custom_icon": "",
            "heading": "How do I prepare for the test?",
            "row_content": "<p>There are no special preparations required for the test. It involves a simple collection of blood, depending on the testing method used.</p>"
          }
        },
        "frequently_asked_question_q6cWXm": {
          "type": "frequently_asked_question",
          "settings": {
            "icon": "heart",
            "another_icon": "",
            "custom_icon": "",
            "heading": "Is the test painful or invasive?",
            "row_content": "<p>No, the test is non-invasive and painless. It typically involves providing a simple blood draw.</p>"
          }
        },
        "frequently_asked_question_xrTpVV": {
          "type": "frequently_asked_question",
          "settings": {
            "icon": "heart",
            "another_icon": "",
            "custom_icon": "",
            "heading": "How long does it take to get the results?",
            "row_content": "<p>Results are typically available within 3-6 weeks after your sample is received in the laboratory.</p>"
          }
        },
        "frequently_asked_question_PwHBUR": {
          "type": "frequently_asked_question",
          "settings": {
            "icon": "heart",
            "another_icon": "",
            "custom_icon": "",
            "heading": "How can I use the results of this test?",
            "row_content": "<p>The results can guide you in making informed decisions about your lifestyle, diet, and wellness routines. They can also be integrated with AIWO's personalised health programs for a holistic approach to your well-being.</p>"
          }
        },
        "frequently_asked_question_WGBEQg": {
          "type": "frequently_asked_question",
          "settings": {
            "icon": "heart",
            "another_icon": "",
            "custom_icon": "",
            "heading": "Is my genetic information kept confidential?",
            "row_content": "<p>Absolutely. We adhere to strict privacy policies and ensure that your genetic information is kept confidential and used only for the purposes of your health assessment.</p>"
          }
        },
        "frequently_asked_question_9cG6Qd": {
          "type": "frequently_asked_question",
          "settings": {
            "icon": "heart",
            "another_icon": "",
            "custom_icon": "",
            "heading": "Can this test predict future health conditions?",
            "row_content": "<p>While the test provides valuable insights into your current health and biological age, it is not designed to predict specific future health conditions. Instead, it helps in understanding potential risk factors and guiding lifestyle choices.</p>"
          }
        },
        "frequently_asked_question_EehnCp": {
          "type": "frequently_asked_question",
          "settings": {
            "icon": "heart",
            "another_icon": "",
            "custom_icon": "",
            "heading": "Who should consider taking this test?",
            "row_content": "<p>Anyone interested in gaining a deeper understanding of their health and ageing process can benefit from this test. It is particularly useful for individuals looking to tailor their health and wellness strategies based on their biological age.</p>"
          }
        },
        "frequently_asked_question_mDpRa7": {
          "type": "frequently_asked_question",
          "settings": {
            "icon": "heart",
            "another_icon": "",
            "custom_icon": "",
            "heading": "How often should I repeat this test?",
            "row_content": "<p>The frequency of testing can vary depending on individual health goals and circumstances. It is generally recommended to repeat the test annually or biennially to track changes and progress.</p>"
          }
        }
      },
