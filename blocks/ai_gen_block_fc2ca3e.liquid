{% doc %}
  @prompt
    Design a two-part closing section for a premium olive oil landing page that reinforces provenance, authenticity, and trust — while offering a clear call to action.
    
    Layout:
    
    Two stacked sections:
    
    Top: “Proudly Crafted in Australia” — dark olive background with white text.
    
    Bottom: “Experience the Difference” — light cream background with CTA.
    
    Both sections centered horizontally and vertically with generous padding.
    
    Top Section (Brand Provenance):
    
    
    
    Heading:
    “Proudly Crafted in Australia” (white, bold, 22–26 px).
    
    Body text:
    
    “Not imported and relabeled. Not blended with mystery oils from unknown sources.
    AIWO Olive Aura is grown, pressed, and bottled on Australian soil—where quality standards are among the world's strictest and our commitment to transparency is uncompromising.
    Choosing Australian-made means traceability, accountability, and a guarantee that every drop meets the standards we’d serve our own families.”
    
    Alignment: centered, max-width 800 px.
    
    Bottom Section (Call to Action):
    
    
    
    Heading:
    “Experience the Difference” in dark olive-green.
    
    Subtext:
    
    “Taste what happens when freshness is measured, purity is proven, and every step is designed to protect what matters.”
    
    CTA Button:
    
    Text: “Shop AIWO Olive Aura”
    
    Style: rounded corners, medium shadow.
    
    Small reassurance text below (italic, muted gray-green):
    “🛡 Every bottle backed by independent lab certification.”
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-closing-section-{{ ai_gen_id }} {
    width: 100%;
  }

  .ai-closing-provenance-{{ ai_gen_id }} {
    background-color: {{ block.settings.provenance_bg_color }};
    padding: {{ block.settings.provenance_padding_desktop }}px 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .ai-closing-provenance-content-{{ ai_gen_id }} {
    max-width: {{ block.settings.content_max_width }}px;
    width: 100%;
  }

  .ai-closing-provenance-heading-{{ ai_gen_id }} {
    color: {{ block.settings.provenance_heading_color }};
    font-size: {{ block.settings.provenance_heading_size }}px;
    font-weight: 700;
    margin: 0 0 {{ block.settings.text_spacing }}px 0;
    line-height: 1.3;
  }

  .ai-closing-provenance-text-{{ ai_gen_id }} {
    color: {{ block.settings.provenance_text_color }};
    font-size: {{ block.settings.provenance_text_size }}px;
    line-height: 1.7;
    margin: 0;
  }

  .ai-closing-cta-{{ ai_gen_id }} {
    background-color: {{ block.settings.cta_bg_color }};
    padding: {{ block.settings.cta_padding_desktop }}px 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .ai-closing-cta-content-{{ ai_gen_id }} {
    max-width: {{ block.settings.content_max_width }}px;
    width: 100%;
  }

  .ai-closing-cta-heading-{{ ai_gen_id }} {
    color: {{ block.settings.cta_heading_color }};
    font-size: {{ block.settings.cta_heading_size }}px;
    font-weight: 700;
    margin: 0 0 {{ block.settings.text_spacing }}px 0;
    line-height: 1.3;
  }

  .ai-closing-cta-subtext-{{ ai_gen_id }} {
    color: {{ block.settings.cta_text_color }};
    font-size: {{ block.settings.cta_text_size }}px;
    line-height: 1.7;
    margin: 0 0 {{ block.settings.button_spacing }}px 0;
  }

  .ai-closing-cta-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    font-size: {{ block.settings.button_text_size }}px;
    font-weight: 600;
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    transition: all 0.3s ease;
    box-shadow: 0 {{ block.settings.button_shadow_size }}px {{ block.settings.button_shadow_size | times: 2 }}px rgba(0, 0, 0, {{ block.settings.button_shadow_opacity }});
    border: none;
    cursor: pointer;
  }

  .ai-closing-cta-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    color: {{ block.settings.button_hover_text_color }};
    transform: translateY(-2px);
    box-shadow: 0 {{ block.settings.button_shadow_size | plus: 2 }}px {{ block.settings.button_shadow_size | times: 2 | plus: 4 }}px rgba(0, 0, 0, {{ block.settings.button_shadow_opacity | plus: 0.1 }});
  }

  .ai-closing-cta-reassurance-{{ ai_gen_id }} {
    color: {{ block.settings.reassurance_text_color }};
    font-size: {{ block.settings.reassurance_text_size }}px;
    font-style: italic;
    margin: {{ block.settings.reassurance_spacing }}px 0 0 0;
    line-height: 1.5;
  }

  @media screen and (max-width: 749px) {
    .ai-closing-provenance-{{ ai_gen_id }} {
      padding: {{ block.settings.provenance_padding_mobile }}px 20px;
    }

    .ai-closing-provenance-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.provenance_heading_size | times: 0.8 }}px;
    }

    .ai-closing-provenance-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.provenance_text_size | times: 0.9 }}px;
    }

    .ai-closing-cta-{{ ai_gen_id }} {
      padding: {{ block.settings.cta_padding_mobile }}px 20px;
    }

    .ai-closing-cta-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.cta_heading_size | times: 0.8 }}px;
    }

    .ai-closing-cta-subtext-{{ ai_gen_id }} {
      font-size: {{ block.settings.cta_text_size | times: 0.9 }}px;
    }

    .ai-closing-cta-button-{{ ai_gen_id }} {
      font-size: {{ block.settings.button_text_size | times: 0.9 }}px;
      padding: {{ block.settings.button_padding_vertical | times: 0.9 }}px {{ block.settings.button_padding_horizontal | times: 0.9 }}px;
    }

    .ai-closing-cta-reassurance-{{ ai_gen_id }} {
      font-size: {{ block.settings.reassurance_text_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="ai-closing-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-closing-provenance-{{ ai_gen_id }}">
    <div class="ai-closing-provenance-content-{{ ai_gen_id }}">
      {% if block.settings.provenance_heading != blank %}
        <h2 class="ai-closing-provenance-heading-{{ ai_gen_id }}">
          {{ block.settings.provenance_heading }}
        </h2>
      {% endif %}
      {% if block.settings.provenance_text != blank %}
        <div class="ai-closing-provenance-text-{{ ai_gen_id }}">
          {{ block.settings.provenance_text }}
        </div>
      {% endif %}
    </div>
  </div>

  <div class="ai-closing-cta-{{ ai_gen_id }}">
    <div class="ai-closing-cta-content-{{ ai_gen_id }}">
      {% if block.settings.cta_heading != blank %}
        <h2 class="ai-closing-cta-heading-{{ ai_gen_id }}">
          {{ block.settings.cta_heading }}
        </h2>
      {% endif %}
      {% if block.settings.cta_subtext != blank %}
        <div class="ai-closing-cta-subtext-{{ ai_gen_id }}">
          {{ block.settings.cta_subtext }}
        </div>
      {% endif %}
      {% if block.settings.button_text != blank %}
        <a
          href="{{ block.settings.button_link }}"
          class="ai-closing-cta-button-{{ ai_gen_id }}"
        >
          {{ block.settings.button_text }}
        </a>
      {% endif %}
      {% if block.settings.reassurance_text != blank %}
        <div class="ai-closing-cta-reassurance-{{ ai_gen_id }}">
          {{ block.settings.reassurance_text }}
        </div>
      {% endif %}
    </div>
  </div>
</div>

