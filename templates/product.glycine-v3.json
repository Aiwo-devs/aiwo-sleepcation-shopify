    "section_evoo_v3_faq_rRJhLR": {
      "type": "section-evoo-v3-faq",
      "blocks": {
        "faq_item_BFc6Am": {
          "type": "faq_item",
          "settings": {
            "question": "I struggle to fall asleep but don't want something that sedates me.    Is AIWO Glycine right for me?",
            "answer": "<p>Glycine works by supporting the body's natural temperature drop at sleep onset a physiological signal that helps initiate rest. It does not sedate or alter sleep architecture. No grogginess. No dependence. Suitable for daily use.<br/><br/></p>"
          }
        },
        "faq_item_pgG9dR": {
          "type": "faq_item",
          "settings": {
            "question": "When and how should I take it?",
            "answer": "<p>Dissolve one serving (5g) in water 30–60 minutes before bedtime for sleep support.<br/>Can also be taken post-workout to support muscle recovery. Mix into water, juice, or a protein shake it dissolves easily and is tasteless.<br/><br/></p>"
          }
        },
        "faq_item_zet6LP": {
          "type": "faq_item",
          "settings": {
            "question": "Can I take this alongside Melatonin SR or Ashwagandha?",
            "answer": "<p>Yes. Glycine, melatonin, and ashwagandha each work through different pathways temperature regulation, circadian signalling, and cortisol support respectively. Many people use them as part of a broader sleep and recovery routine. Consult a healthcare professional if you are on medication.<br/><br/></p>"
          }
        },
        "faq_item_Q6TUxh": {
          "type": "faq_item",
          "settings": {
            "question": "Is AIWO Glycine suitable for vegetarians?",
            "answer": "<p>Yes. AIWO Glycine carries the green vegetarian dot on its label. The product contains a single ingredient Glycine with no animal-derived additives declared. Vegan certification has not been confirmed check with our team if this matters to you.<br/><br/><br/></p>"
          }
        },
        "faq_item_WyBt4K": {
          "type": "faq_item",
          "settings": {
            "question": "How long before I notice results?",
            "answer": "<p>Some people notice easier sleep onset and reduced next-day fatigue within 1–2 weeks, as observed in published glycine research. Muscle recovery and antioxidant support build with consistent use over 30–90 days. Individual results vary. If you're pregnant, nursing, or on medication, check with your doctor before use.<br/><br/></p>"
          }
        }
      },
