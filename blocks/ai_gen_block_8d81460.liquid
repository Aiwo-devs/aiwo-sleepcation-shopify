{% doc %}
  @prompt
    Create a dark, impactful problem-awareness section that agitates the pain point.
    
    BACKGROUND: #2B2B2B (dark charcoal)
    CONTENT: Centered, max-width 1200px
    PADDING: 64px vertical, 20px horizontal
    
    Main Heading:
    "What You Could Eat During Your Fast Without Breaking It?"
    - Font: Poppins SemiBold, 42px desktop / 28px mobile
    - Color: #FFFFFF
    - IMPORTANT: Style "During Your Fast" in italic with #D68641
    - Center aligned
    - Margin bottom: 20px
    
    Body Copy:
    "Most fast-friendly options break your autophagy, spike insulin, or contain hidden sugars. We engineered a better way."
    - Font: Lato Regular, 16px
    - Color: #E0E0E0
    - Line height: 1.7
    - Center aligned
    - Max width: 800px, center
    - Margin bottom: 48px
    
    4-Column Feature Grid (center aligned):
    Column 1: 5g Protein
    Column 2: Rich in MCTs
    Column 3: Premium Ingredients
    Column 4: Autophagy Compatible
    
    Each column:
    - White line icon (40x40px, minimal, clean)
    - Text below: Lato Regular 14px, #FFFFFF
    - Spacing: Even distribution
    
    Optional Enhancement:
    Product image on right side with subtle glow effect overlay
    
    MOBILE:
    - Heading: 28px
    - Grid: 2x2 layout
    - Reduce padding to 48px vertical
    
    AESTHETIC: Dark sophistication, scientific authority, high contrast for readability, premium supplement brand feel, Apple-like product page vibe
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-problem-section-{{ ai_gen_id }} {
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
    width: 100%;
    display: block;
  }

  .ai-problem-section__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    text-align: center;
  }

  .ai-problem-section__heading-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-size: {{ block.settings.heading_size_desktop }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.heading_margin_bottom }}px 0;
    line-height: 1.2;
  }

  .ai-problem-section__heading-highlight-{{ ai_gen_id }} {
    font-style: italic;
    color: {{ block.settings.highlight_color }};
  }

  .ai-problem-section__body-{{ ai_gen_id }} {
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    font-weight: {{ block.settings.body_font.weight }};
    font-size: {{ block.settings.body_size }}px;
    color: {{ block.settings.body_color }};
    line-height: {{ block.settings.line_height }};
    max-width: {{ block.settings.body_max_width }}px;
    margin: 0 auto {{ block.settings.body_margin_bottom }}px;
  }

  .ai-problem-section__features-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: {{ block.settings.feature_gap }}px;
    justify-items: center;
    align-items: start;
  }

  .ai-problem-section__feature-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: {{ block.settings.feature_icon_text_gap }}px;
  }

  .ai-problem-section__icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    color: {{ block.settings.icon_color }};
    stroke-width: 2;
  }

  .ai-problem-section__feature-text-{{ ai_gen_id }} {
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    font-weight: {{ block.settings.body_font.weight }};
    font-size: {{ block.settings.feature_text_size }}px;
    color: {{ block.settings.feature_text_color }};
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-problem-section-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_vertical_mobile }}px {{ block.settings.padding_horizontal }}px;
    }

    .ai-problem-section__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_mobile }}px;
    }

    .ai-problem-section__features-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: {{ block.settings.feature_gap_mobile }}px;
    }
  }
{% endstyle %}

<div class="ai-problem-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-problem-section__container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-problem-section__heading-{{ ai_gen_id }}">
        {{ block.settings.heading_part_1 }}
        {% if block.settings.heading_part_2 != blank %}
          <span class="ai-problem-section__heading-highlight-{{ ai_gen_id }}">{{ block.settings.heading_part_2 }}</span>
        {% endif %}
        {{ block.settings.heading_part_3 }}
      </h2>
    {% endif %}

    {% if block.settings.body_text != blank %}
      <p class="ai-problem-section__body-{{ ai_gen_id }}">
        {{ block.settings.body_text }}
      </p>
    {% endif %}

    <div class="ai-problem-section__features-{{ ai_gen_id }}">
      {% if block.settings.feature_1_enabled %}
        <div class="ai-problem-section__feature-{{ ai_gen_id }}">
          <svg class="ai-problem-section__icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <p class="ai-problem-section__feature-text-{{ ai_gen_id }}">{{ block.settings.feature_1_text }}</p>
        </div>
      {% endif %}

      {% if block.settings.feature_2_enabled %}
        <div class="ai-problem-section__feature-{{ ai_gen_id }}">
          <svg class="ai-problem-section__icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <circle cx="12" cy="12" r="10" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M12 6v6l4 2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <p class="ai-problem-section__feature-text-{{ ai_gen_id }}">{{ block.settings.feature_2_text }}</p>
        </div>
      {% endif %}

      {% if block.settings.feature_3_enabled %}
        <div class="ai-problem-section__feature-{{ ai_gen_id }}">
          <svg class="ai-problem-section__icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" stroke-linecap="round" stroke-linejoin="round"/>
            <circle cx="12" cy="7" r="4" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M22 12h-4M20 10v4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <p class="ai-problem-section__feature-text-{{ ai_gen_id }}">{{ block.settings.feature_3_text }}</p>
        </div>
      {% endif %}

      {% if block.settings.feature_4_enabled %}
        <div class="ai-problem-section__feature-{{ ai_gen_id }}">
          <svg class="ai-problem-section__icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" stroke-linecap="round" stroke-linejoin="round"/>
            <polyline points="22 4 12 14.01 9 11.01" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <p class="ai-problem-section__feature-text-{{ ai_gen_id }}">{{ block.settings.feature_4_text }}</p>
        </div>
      {% endif %}
    </div>
  </div>
</div>

