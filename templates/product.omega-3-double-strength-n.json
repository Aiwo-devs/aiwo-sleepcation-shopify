    "176656470035b79b01": {
      "type": "_blocks",
      "blocks": {
        "ai_gen_block_2b60f35_zHMGKi": {
          "type": "ai_gen_block_2b60f35",
          "settings": {
            "background_color": "#f9fafb",
            "section_padding_top": 60,
            "section_padding_bottom": 60,
            "badge_text": "FAQ",
            "badge_bg_color": "#0a2c5c",
            "badge_text_color": "#ffffff",
            "heading_part1": "Frequently Asked",
            "heading_part2": "Questions",
            "heading_size": 48,
            "heading_color": "#1f2937",
            "gradient_start": "#0061d1",
            "gradient_end": "#0a2c5c",
            "description": "Find answers to common questions about our products and services.",
            "description_size": 16,
            "description_color": "#6b7280",
            "card_bg_color": "#ffffff",
            "card_border_color": "#e5e7eb",
            "card_border_radius": 12,
            "question_size": 18,
            "question_color": "#1f2937",
            "question_hover_color": "#0a2c5c",
            "answer_size": 16,
            "answer_color": "#6b7280",
            "faq_1_question": "What makes AIWO Omega-3 different from other fish oil supplements?",
            "faq_1_answer": "AIWO Omega 3 features advanced Enteric Coating and Molecular Distillation technology. The enteric coating ensures the capsule doesn't dissolve in stomach acid, eliminating fishy burps and aftertaste. Our molecular distillation process removes toxins and heavy metals while concentrating beneficial omega-3 fatty acids for maximum purity and potency.",
            "faq_2_question": "What is the recommended dosage?",
            "faq_2_answer": "The recommended dosage is 1-2 soft gel capsules daily, preferably with meals. Each capsule contains 1000mg of fish oil with 660mg of omega-3 fatty acids (360mg EPA + 240mg DHA). Consult your healthcare provider for personalized recommendations.",
            "faq_3_question": "Will I experience fishy burps?",
            "faq_3_answer": "No. Our enteric-coated capsules are specifically designed to pass through the stomach intact and dissolve only in the small intestine. This DR (Delayed Release) coating completely eliminates the fishy burps and foul taste commonly associated with fish oil supplements.",
            "faq_4_question": "Is AIWO Omega-3 suitable for vegetarians?",
            "faq_4_answer": "AIWO Omega 3 is derived from fish oil and uses food-grade gelatin capsules, so it is not suitable for vegetarians or vegans. However, it is Halal certified and gluten-free.",
