{% doc %}
  @prompt
    Design a "Premium Quality Features" section for AIWO Ultimate Omega 3.
    Layout:
    Full-width section, white background, centered content with max-width container, generous padding.
    Header:
    
    Centered heading (bold, large black): "Premium Quality Features"
    
    Features Grid (3 columns):
    Column 1:
    
    ✅ Blends with Benefits - Premium formulation
    ✅ Hypoallergenic formula
    ✅ 1000mg Omega-3 fatty acids per serving
    ✅ Enteric Coating prevents burping & foul taste
    ✅ HALAL certified
    ✅ Gluten-free formula
    
    Column 2:
    
    ✅ Globally Sourced Ingredients
    ✅ 100% Pesticide/Herbicide Free
    ✅ 46% EPA (Eicosapentaenoic Acid)
    ✅ Molecularly Distilled for purity
    ✅ GMP & FSSAI certified
    
    Column 3:
    
    ✅ Clinically Proven Ingredients
    ✅ No Added Sugar & Preservatives
    ✅ 38% DHA (Docosahexaenoic Acid)
    ✅ 60 soft gel capsules per bottle
    ✅ ISO certified facility
    
    Styling:
    
    Each feature has green circle checkmark icon on left
    Feature text in medium-weight black font, aligned left
    Equal spacing between features (vertical gap)
    Columns have equal width with proper spacing
    Clean, minimal design with breathing room
    
    Responsive: 3 columns on desktop, 2 columns on tablet, 1 column on mobile. Features maintain left alignment with icons.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-premium-features-{{ ai_gen_id }} {
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_top }}px 20px {{ block.settings.padding_bottom }}px;
    display: block;
  }

  .ai-premium-features__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_max_width }}px;
    margin: 0 auto;
  }

  .ai-premium-features__heading-{{ ai_gen_id }} {
    text-align: center;
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 700;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.heading_spacing }}px;
  }

  .ai-premium-features__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.column_gap }}px;
  }

  .ai-premium-features__column-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.feature_gap }}px;
  }

  .ai-premium-features__feature-{{ ai_gen_id }} {
    display: flex;
    align-items: flex-start;
    gap: {{ block.settings.icon_text_gap }}px;
  }

  .ai-premium-features__icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    border-radius: 50%;
    background-color: {{ block.settings.icon_bg_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 2px;
  }

  .ai-premium-features__icon-{{ ai_gen_id }} svg {
    width: calc({{ block.settings.icon_size }}px * 0.6);
    height: calc({{ block.settings.icon_size }}px * 0.6);
    stroke: {{ block.settings.icon_color }};
  }

  .ai-premium-features__text-{{ ai_gen_id }} {
    flex: 1;
    font-size: {{ block.settings.text_size }}px;
    font-weight: {{ block.settings.text_weight }};
    color: {{ block.settings.text_color }};
    line-height: 1.5;
  }

  @media screen and (max-width: 989px) {
    .ai-premium-features__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-premium-features-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top | times: 0.7 }}px 16px {{ block.settings.padding_bottom | times: 0.7 }}px;
    }

    .ai-premium-features__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
      margin-bottom: {{ block.settings.heading_spacing | times: 0.8 }}px;
    }

    .ai-premium-features__grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.column_gap | times: 0.7 }}px;
    }

    .ai-premium-features__text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="ai-premium-features-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
