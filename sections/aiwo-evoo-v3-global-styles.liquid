{% comment %}
  ============================================================
  Section  : AIWO EVOO v3 — Global Styles
  Template : product.extra-virgin-olive-oil-v3 ONLY
  ============================================================
  All typography values are driven by {% schema %} settings
  and surfaced in the Shopify theme editor customizer panel
  under "EVOO v3 Typography".

  CSS strategy:
  · Font families  → override theme's --font-*-family vars
  · Heading colour → override theme's --colors-heading var
                     (stored as R,G,B to match rgba(var()) usage)
  · Body colour    → override theme's --colors-text var
  · Sizes / weights / line-heights → new --evoo-* custom props,
    applied directly to element selectors so both the vars
    and the element styles stay in sync.

  Section-specific overrides (e.g. #kb-<id> in EVOO-key-benefits)
  carry ID-level specificity and naturally win over these rules.
  ============================================================
{% endcomment %}

<script>
  /* Inject Outfit only if no existing <link> already requests it */
  (function () {
    if (document.querySelector('link[href*="Outfit"]')) return;

    var pc1 = document.createElement('link');
    pc1.rel  = 'preconnect';
    pc1.href = 'https://fonts.googleapis.com';
    document.head.appendChild(pc1);

    var pc2 = document.createElement('link');
    pc2.rel         = 'preconnect';
    pc2.href        = 'https://fonts.gstatic.com';
    pc2.crossOrigin = 'anonymous';
    document.head.appendChild(pc2);

    var sheet = document.createElement('link');
    sheet.rel  = 'stylesheet';
    sheet.href = 'https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap';
    document.head.appendChild(sheet);
  })();
</script>

<style>
  :root {
    /* ── Font families ───────────────────────────────────────
       Overrides the theme's Shopify-CDN font vars so every
       component using var(--font-*-family) picks up Outfit.   */
    --font-body-family:    'Outfit', sans-serif;
    --font-heading-family: 'Outfit', sans-serif;
    --font-button:         'Outfit', sans-serif;
    --font-menu:           'Outfit', sans-serif;

    /* ── Heading tokens ──────────────────────────────────────
       --colors-heading uses raw R,G,B (no rgb() wrapper)
       to match the theme's  rgba(var(--colors-heading))  usage. */
    --evoo-heading-size:        {{ section.settings.heading_font_size }}px;
    --evoo-heading-weight:      {{ section.settings.heading_font_weight }};
    --evoo-heading-line-height: {{ section.settings.heading_line_height }};
    --colors-heading:           {{ section.settings.heading_color.red }}, {{ section.settings.heading_color.green }}, {{ section.settings.heading_color.blue }};

    /* ── Body tokens ─────────────────────────────────────────
       --colors-text uses raw R,G,B for the same reason.        */
    --evoo-body-size:        {{ section.settings.body_font_size }}px;
    --evoo-body-weight:      {{ section.settings.body_font_weight }};
    --evoo-body-line-height: {{ section.settings.body_line_height }};
    --colors-text:           {{ section.settings.body_color.red }}, {{ section.settings.body_color.green }}, {{ section.settings.body_color.blue }};

    /* ── Button tokens ───────────────────────────────────────  */
    --evoo-button-size:   {{ section.settings.button_font_size }}px;
    --evoo-button-weight: {{ section.settings.button_font_weight }};
  }

  /* Scoped to this template only via #MainContent class */

  /* Outfit on all text inside the template content area */
  #MainContent.theme-template-suffix-extra-virgin-olive-oil-v3,
  #MainContent.theme-template-suffix-extra-virgin-olive-oil-v3 * {
    font-family: 'Outfit', sans-serif;
  }

  /* Heading tokens */
  #MainContent.theme-template-suffix-extra-virgin-olive-oil-v3 h1,
  #MainContent.theme-template-suffix-extra-virgin-olive-oil-v3 h2:not(.ai-hero-heading-aennftkttl0jowunywaigenblock009ce11pnkbhh),
  #MainContent.theme-template-suffix-extra-virgin-olive-oil-v3 h3,
  #MainContent.theme-template-suffix-extra-virgin-olive-oil-v3 h4,
  #MainContent.theme-template-suffix-extra-virgin-olive-oil-v3 h5,
  #MainContent.theme-template-suffix-extra-virgin-olive-oil-v3 h6,
  #MainContent.theme-template-suffix-extra-virgin-olive-oil-v3 .h1,
  #MainContent.theme-template-suffix-extra-virgin-olive-oil-v3 .h2,
  #MainContent.theme-template-suffix-extra-virgin-olive-oil-v3 .h3,
  #MainContent.theme-template-suffix-extra-virgin-olive-oil-v3 .h4,
  #MainContent.theme-template-suffix-extra-virgin-olive-oil-v3 .h5,
  #MainContent.theme-template-suffix-extra-virgin-olive-oil-v3 .h6 {
    font-size:   var(--evoo-heading-size);
    font-weight: var(--evoo-heading-weight);
    line-height: var(--evoo-heading-line-height);
  }

  /* Body tokens */
  #MainContent.theme-template-suffix-extra-virgin-olive-oil-v3 {
    font-size:   var(--evoo-body-size);
    font-weight: var(--evoo-body-weight);
    line-height: var(--evoo-body-line-height);
  }

  /* Button tokens */
  #MainContent.theme-template-suffix-extra-virgin-olive-oil-v3 button,
  #MainContent.theme-template-suffix-extra-virgin-olive-oil-v3 .button,
  #MainContent.theme-template-suffix-extra-virgin-olive-oil-v3 [type="button"],
  #MainContent.theme-template-suffix-extra-virgin-olive-oil-v3 [type="submit"] {
    font-size:   var(--evoo-button-size);
    font-weight: var(--evoo-button-weight);
  }
</style>

