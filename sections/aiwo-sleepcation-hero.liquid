{{ 'aiwo-sleepcation.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign image_sizes = '(min-width: 1440px) 798px, (min-width: 900px) 56vw, 100vw'
  assign svg_attrs = '<svg aria-hidden="true" focusable="false" '
-%}

<section class="aiwo-sleepcation-hero">
  <div class="aiwo-sleepcation-hero__card">
    <div class="aiwo-sleepcation-hero__content">
      <div class="aiwo-sleepcation-hero__intro">
        <div class="aiwo-sleepcation-hero__heading">
          {%- if section.settings.eyebrow != blank -%}
            <p class="aiwo-sleepcation-hero__eyebrow">
              <span class="aiwo-sleepcation-hero__eyebrow-label">{{ section.settings.eyebrow | escape }}</span>
            </p>
          {%- endif -%}
          <h1 class="aiwo-sleepcation-hero__title">
            <span class="aiwo-sleepcation-hero__title-line">{{ section.settings.heading_line_1 | escape }}</span>
            <span class="aiwo-sleepcation-hero__title-accent">{{ section.settings.heading_line_2 | strip | escape }}</span>
          </h1>
          {{ 'aiwo-sleepcation-hero-divider.svg' | inline_asset_content | replace: '<svg ', svg_attrs }}
        </div>
        {%- if section.settings.text != blank -%}
          <p class="aiwo-sleepcation-hero__text">{{ section.settings.text | escape }}</p>
        {%- endif -%}
      </div>

      {%- if section.settings.button_label != blank -%}
        {%- comment -%} No URL yet: render a placeholder link (no href) — visually identical, not a dead link. {%- endcomment -%}
        <a class="aiwo-sleepcation-button"{% if section.settings.button_link != blank %} href="{{ section.settings.button_link }}"{% endif %}>
          {{- section.settings.button_label | escape -}}
          {{- 'aiwo-sleepcation-icon-arrow-up-right.svg' | inline_asset_content | replace: '<svg ', svg_attrs -}}
        </a>
      {%- endif -%}
    </div>

    {%- comment -%}
      Mobile (< 900px): image_mobile → image_desktop → bundled photo. Desktop: image_desktop → bundled photo.
      The <source> is only emitted for image_mobile; otherwise the <img> srcset already covers mobile.
    {%- endcomment -%}
    {%- liquid
      assign image_desktop = section.settings.image_desktop
      assign image_mobile = section.settings.image_mobile
    -%}
    <picture>
      {%- if image_mobile != blank -%}
        <source
          media="(max-width: 899px)"
          srcset="{{ image_mobile | image_url: width: 768 }} 768w, {{ image_mobile | image_url: width: 1152 }} 1152w, {{ image_mobile | image_url: width: 1536 }} 1536w"
          sizes="100vw"
          width="{{ image_mobile.width }}"
          height="{{ image_mobile.height }}"
        >
      {%- endif -%}
      {%- if image_desktop != blank -%}
        {{
          image_desktop
          | image_url: width: 1536
          | image_tag:
            class: 'aiwo-sleepcation-hero__image',
            widths: '768, 1152, 1536',
            sizes: image_sizes,
            alt: section.settings.image_alt,
            loading: 'eager',
            fetchpriority: 'high'
        }}
      {%- else -%}
        <img
          class="aiwo-sleepcation-hero__image"
          src="{{ 'aiwo-sleepcation-hero-sleep-timeline-1536.webp' | asset_url }}"
          srcset="{{ 'aiwo-sleepcation-hero-sleep-timeline-768.webp' | asset_url }} 768w, {{ 'aiwo-sleepcation-hero-sleep-timeline-1536.webp' | asset_url }} 1536w"
          sizes="{{ image_sizes }}"
          width="1536"
          height="1024"
          alt="{{ section.settings.image_alt | escape }}"
          fetchpriority="high"
        >
      {%- endif -%}
    </picture>
  </div>
</section>

{% schema %}
{
  "name": "AIWO Sleepcation – Hero",
  "tag": "div",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow / tagline"
    },
    {
      "type": "text",
      "id": "heading_line_1",
      "label": "Heading line 1"
    },
    {
      "type": "text",
      "id": "heading_line_2",
      "label": "Heading line 2 (italic)"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "CTA label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "CTA URL"
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Desktop hero image",
      "info": "Optional. Leave empty to use the built-in Sleepcation timeline photo."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile hero image",
      "info": "Optional. Used below 900px; falls back to the desktop image."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text"
    }
  ]
}
{% endschema %}
