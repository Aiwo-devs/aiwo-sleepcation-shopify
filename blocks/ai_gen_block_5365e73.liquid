<script>
  (function() {
    class ProductComparison{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.stickyBar = this.querySelector('[data-sticky-bar]');
        this.scrollThreshold = 300;
      }

      connectedCallback() {
        if (this.stickyBar) {
          this.handleScroll = this.handleScroll.bind(this);
          window.addEventListener('scroll', this.handleScroll);
          this.handleScroll();
        }
      }

      disconnectedCallback() {
        if (this.stickyBar) {
          window.removeEventListener('scroll', this.handleScroll);
        }
      }

      handleScroll() {
        const scrollPosition = window.scrollY;
        if (scrollPosition > this.scrollThreshold) {
          this.stickyBar.classList.add('visible');
        } else {
          this.stickyBar.classList.remove('visible');
        }
      }
    }

    customElements.define('product-comparison-{{ ai_gen_id }}', ProductComparison{{ ai_gen_id }});
  })();
</script>

