  .main-product-{{ section.id }} .product-form__quantity {
    display: inline-flex !important;
    width: auto !important;
    margin-bottom: 12px !important;
    margin-right: 12px !important;
    vertical-align: top;
    flex-shrink: 0;
  }
  /* Hide "Quantity (x in cart)" label */
  .main-product-{{ section.id }} .product-form__quantity > label {
    display: none !important;
  }
  .main-product-{{ section.id }} .product-form__quantity .flex {
    margin-bottom: 0 !important;
  }
  .main-product-{{ section.id }} .x-variant-picker {
    display: inline-block !important;
    width: auto !important;
    margin-bottom: 12px !important;
    vertical-align: top;
  }
  .main-product-{{ section.id }} .x-variant-picker .options-container {
    margin-bottom: 0 !important;
  }
  .main-product-{{ section.id }} .x-variant-picker fieldset {
    padding-bottom: 0 !important;
    margin-bottom: 0 !important;
    gap: 8px !important;
    flex-wrap: nowrap;
    align-items: center;
    display: flex;
  }
  .main-product-{{ section.id }} .x-variant-picker fieldset legend {
    display: none !important;
  }
  .main-product-{{ section.id }} .x-variant-picker .variant-selects label.cursor-pointer {
    border: 1.5px solid #ccc !important;
    border-radius: 4px !important;
    padding: 9px 18px !important;
    font-size: 13px !important;
    font-weight: 500 !important;
    white-space: nowrap;
    transition: border-color 0.15s;
  }
  .main-product-{{ section.id }} .x-variant-picker .variant-selects label.cursor-pointer:has(input:checked) {
    border-color: #333 !important;
    background: transparent !important;
    font-weight: 600 !important;
  }

  /* --- Buy Buttons: Add To Cart + Buy Now side by side --- */
  .main-product-{{ section.id }} .x-block-buy-buttons .button-product > div {
    display: grid !important;
    grid-template-columns: 1fr 1fr !important;
    gap: 12px !important;
    align-items: start !important;
  }
  .main-product-{{ section.id }} .x-block-buy-buttons form.form {
    display: grid !important;
    grid-template-columns: 1fr 1fr !important;
    gap: 12px !important;
  }
  .main-product-{{ section.id }} .x-block-buy-buttons form.form > input[type="hidden"] {
    display: none !important;
  }
  .main-product-{{ section.id }} .x-block-buy-buttons .add_to_cart_button {
    background: #1a1a1a !important;
    color: #fff !important;
    border: 1.5px solid #1a1a1a !important;
    font-weight: 600 !important;
    font-size: 14px !important;
    border-radius: 4px !important;
    padding: 14px 20px !important;
    text-transform: none !important;
    letter-spacing: 0 !important;
    width: 100% !important;
    margin-bottom: 0 !important;
  }
  .main-product-{{ section.id }} .x-block-buy-buttons .add_to_cart_button:hover {
    background: #1a1a1a !important;
    color: #fff !important;
  }
  .main-product-{{ section.id }} .x-block-buy-buttons .payment-button-container {
    margin-bottom: 0 !important;
    display:none;
  }
  .main-product-{{ section.id }} .x-block-buy-buttons .shopify-payment-button,
  .main-product-{{ section.id }} .x-block-buy-buttons .payment-button {
    height: 100% !important;
  }
  .main-product-{{ section.id }} .x-block-buy-buttons .shopify-payment-button button,
  .main-product-{{ section.id }} .x-block-buy-buttons .shopify-payment-button .shopify-payment-button__button {
    background: #1a1a1a !important;
    color: #fff !important;
    font-weight: 600 !important;
    font-size: 14px !important;
    border-radius: 4px !important;
    padding: 14px 20px !important;
    text-transform: none !important;
    min-height: auto !important;
    letter-spacing: 0 !important;
  }

  /* --- Estimate Delivery --- */
  .main-product-{{ section.id }} .x-block-estimate-delivery {
    text-align: center;
    font-size: 13px;
    color: #3d5a3e;
  }

  /* --- Gift Banner --- */
  .aiwo-v1-gift__bar {
    background: #fdf0ec;
    border-radius: 6px;
    padding: 10px 16px;
    text-align: center;
    font-size: 13px;
    color: #333;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
  }
  .aiwo-v1-gift__icon {
    font-size: 16px;
  }
  .aiwo-v1-gift__text {
    font-weight: 500;
  }
  .aiwo-v1-gift__text strong {
    color: #c0392b;
  }

  /* --- Complementary "works better as a system" --- */
  .main-product-{{ section.id }} .x-block-complementary .heading-text {
    font-family: 'Outfit', sans-serif !important;
    font-weight: 600 !important;
    font-size: 20px !important;
  }
  .main-product-{{ section.id }} .x-block-complementary .heading-text em,
  .main-product-{{ section.id }} .x-block-complementary .heading-text i {
    font-family: 'Newsreader', serif !important;
    font-style: italic !important;
    font-weight: 400 !important;
  }

  l#x-quantity-template--{{ section.id }}__main {
    display:none;
  }

  /* --- Seael ubscription Area Design" --- */
  .sealsubs-target-element {
    width: 100%;
    grid-column: 1 / -1;
  }

  .sealsubs-container {
    width: 100%;

  }

   .sealsubs-container .sls-option-container {
    width: 100%;
  }

