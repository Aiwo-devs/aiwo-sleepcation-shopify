{%- liquid
  assign base_size_heading = settings.heading_base_size | times: 0.0225 
  assign font_size_heading = section.settings.title_size | times: 0.01 | times: base_size_heading
  assign thumbnail_desktop = false
  if section.settings.desktop_media_layout == 'thumbnail_slider'
    assign thumbnail_desktop = true
  endif 
  assign mobile_media_full = true
  if section.settings.mobile_media_size == '75%'
    assign mobile_media_full = false
  endif 
  assign product_form_id = 'product-form-' | append: section.id
-%}
{%- style -%}
  .content-{{ section.id }} {
    background: {{ settings.colors_background }};
  }
  .dark .content-{{ section.id }} {
    background: {{ settings.colors_dark_background }};
  }
  .title-size--{{ section.id }} {
    font-size: {{ font_size_heading | times: 0.60 }}rem;
  }
  @media (min-width: 767px){
    .title-size--{{ section.id }} {
      font-size: {{ font_size_heading }}rem;
    }
  }
  @keyframes cartShake {
  0% { transform: translateX(0); }
  20% { transform: translateX(-4px); }
  40% { transform: translateX(4px); }
  60% { transform: translateX(-4px); }
  80% { transform: translateX(4px); }
  100% { transform: translateX(0); }
}

.add_to_cart_button.shake-cart {
  animation: cartShake 0.5s ease-in-out;
}
 

{%- endstyle -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,wght@0,300;0,400;0,600;1,300;1,400;1,600&family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>
  /* =============================================
     AIWO V1 Product Template — Figma Match
     ============================================= */

  /* --- Stacked + Left Thumbnails + Sticky Info --- */
  @media (min-width: 768px) {
    .main-product-{{ section.id }} .product-media-container #x-product-thumbnail-{{ section.id }} {
      display: block !important;
      width: 15%;
      min-width: 60px;
      max-width: 85px;
      position: sticky;
      top: calc(var(--height-header, 60px) + 20px);
      align-self: flex-start;
      height: fit-content;
      max-height: 80vh;
      overflow-y: auto;
      margin-right: 10px;
      flex-shrink: 0;
    }
    .main-product-{{ section.id }} .product-media-container #x-product-thumbnail-{{ section.id }} > div {
      position: relative !important;
    }
    .main-product-{{ section.id }} .product-media-container .splide-image {
      display: flex !important;
      flex-direction: row !important;
      flex-wrap: nowrap !important;
    }
    /* Hide the splide slider in stacked mode */
    .main-product-{{ section.id }} .product-media-container .x-splide {
      display: none !important;
    }
    .main-product-{{ section.id }} #stacked-{{ section.id }} {
      display: flex !important;
      flex-direction: column !important;
      gap: 8px !important;
      flex: 1;
      flex-wrap: nowrap !important;
    }
    .main-product-{{ section.id }} #stacked-{{ section.id }} .product-media-item {
      width: 100% !important;
    }
    .main-product-{{ section.id }} .product-info {
      position: sticky !important;
      top: calc(var(--height-header, 60px) + 20px) !important;
      align-self: flex-start !important;
    }
    /* Thumbnail active state */
    .main-product-{{ section.id }} .x-thumbnail {
      opacity: 0.4 !important;
      transition: opacity 0.2s;
      cursor: pointer;
    }
    .main-product-{{ section.id }} .x-thumbnail.is-active {
      opacity: 1 !important;
    }
  }

  .main-product-{{ section.id }},
  .main-product-{{ section.id }} * {
    font-family: 'Outfit', sans-serif;
  }

  /* --- Mobile Slider Dots --- */
  @media (max-width: 767px) {
    .main-product-{{ section.id }} .splide__arrows {
      display: none !important;
    }
    .main-product-{{ section.id }} .splide__pagination {
      display: flex !important;
      justify-content: center;
      gap: 6px;
      padding: 12px 0 4px;
      list-style: none;
      margin: 0;
    }
    .main-product-{{ section.id }} .splide__pagination__page {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #d1d1d1;
      border: none;
      padding: 0;
      cursor: pointer;
      transition: background 0.2s;
    }
    .main-product-{{ section.id }} .splide__pagination__page.is-active {
      background: #1a1a1a;
    }
  }

  /* --- Tag Line --- */
  .aiwo-v1-tagline__label {
    display: inline-block;
    padding: 5px 14px;
    border: 1px solid #888;
    font-size: 10px;
    letter-spacing: 2px;
    text-transform: uppercase;
    font-weight: 400;
    color: #555;
  }

  /* --- Product Title --- */
  .main-product-{{ section.id }} .product-title {
    font-family: 'Outfit', sans-serif !important;
    font-size: 30px !important;
    font-weight: 700 !important;
    line-height: 1.15 !important;
    color: #1a1a1a !important;
    letter-spacing: -0.02em;
  }
  @media (min-width: 768px) {
    .main-product-{{ section.id }} .product-title {
      font-size: 38px !important;
    }
  }

  /* --- Purchase Stats --- */
  .aiwo-v1-stats__row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .aiwo-v1-stats__purchased {
    color: #666666;
    font-size: 13px;
    font-weight: 400;
    /*text-decoration: underline;*/
    text-underline-offset: 2px;
  }
  .aiwo-v1-stats__weight {
    font-size: 14px;
    font-weight: 500;
    color: #222;
  }

  /* --- Description --- */
  .main-product-{{ section.id }} .x-block-description {
    font-size: 14px;
    line-height: 1.65;
    color: #444;
  }

  /* --- Trust Badges --- */
  .aiwo-v1-badges__grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 10px;
    text-align: center;
    padding: 8px 0;
   
  }
  .aiwo-v1-badges__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }
  .aiwo-v1-badges__icon {
    width: 36px;
    height: 36px;
    object-fit: contain;
  }
  .aiwo-v1-badges__svg {
    width: 36px;
    height: 36px;
  }
  .aiwo-v1-badges__label {
    font-size: 10px;
    font-weight: 500;
    color: #333;
    line-height: 1.3;
    letter-spacing: 0.01em;
  }
  .aiwo-v1-badges__dots {
    display: none;
  }
  @media (max-width: 480px) {
    .aiwo-v1-badges__slider {
      position: relative;
      overflow: hidden;
    }
    .aiwo-v1-badges__grid {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      gap: 0;
      scrollbar-width: none;
      padding: 8px 0;
    }
    .aiwo-v1-badges__grid::-webkit-scrollbar { display: none; }
    .aiwo-v1-badges__item {
      flex: 0 0 calc(100% / 3);
      scroll-snap-align: start;
      padding: 0 8px;
      box-sizing: border-box;
    }
    .aiwo-v1-badges__dots {
      display: flex;
      justify-content: center;
      gap: 6px;
      padding: 8px 0 0;
    }
    .aiwo-v1-badges__dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #ccc;
      border: none;
      padding: 0;
      cursor: pointer;
      transition: background 0.3s;
    }
    .aiwo-v1-badges__dot.active {
      background: #555;
    }
  }

  /* --- Marquee --- */
  .aiwo-v1-marquee {
    overflow: hidden;
    white-space: nowrap;
    padding: 10px 0;
    position: relative;
  }
  .aiwo-v1-marquee::before,
  .aiwo-v1-marquee::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 60px;
    z-index: 2;
    pointer-events: none;
  }
  .aiwo-v1-marquee::before {
    left: 0;
    background: linear-gradient(to right, var(--marquee-bg, #2c2416), transparent);
  }
  .aiwo-v1-marquee::after {
    right: 0;
    background: linear-gradient(to left, var(--marquee-bg, #2c2416), transparent);
  }
  .aiwo-v1-marquee__track {
    display: inline-flex;
    animation: aiwo-marquee 20s linear infinite;
  }
  .aiwo-v1-marquee__item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0 14px;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.5px;
  }
  .aiwo-v1-marquee__item img {
    width: 16px;
    height: 16px;
    object-fit: contain;
  }
  .aiwo-v1-marquee__sep {
    font-size: 8px;
    opacity: 0.5;
  }
  @keyframes aiwo-marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  /* --- Health Stats --- */
  .aiwo-v1-hstats {
    display: flex;
    justify-content: center;
    gap: 24px;
    padding: 24px 0;
    flex-wrap: wrap;
  }
  .aiwo-v1-hstats__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 6px;
  }
  .aiwo-v1-hstats__circle {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: #E3D9C4;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .aiwo-v1-hstats__num {
    font-size: 18px;
    font-weight: 700;
    color: #A1895E;
  }
  .aiwo-v1-hstats__label {
    font-size: 11px;
    color: #666;
    line-height: 1.3;
    max-width: 100px;
  }
  @media (max-width: 480px) {
    .aiwo-v1-hstats { gap: 16px; }
    .aiwo-v1-hstats__circle { width: 60px; height: 60px; }
    .aiwo-v1-hstats__num { font-size: 15px; }
  }

  /* --- Promo Banner V1 --- */
  .aiwo-v1-promo-banner {
    width: 100%;
    border-radius: 10px;
    overflow: hidden;
  }
  .aiwo-v1-promo-banner img {
    width: 100%;
    height: auto;
    display: block;
  }
  .aiwo-v1-promo-banner__desktop { display: block; }
  .aiwo-v1-promo-banner__mobile { display: none; }
  @media (max-width: 767px) {
    .aiwo-v1-promo-banner__desktop { display: none; }
    .aiwo-v1-promo-banner__mobile { display: block; }
  }

  /* --- Key Component Banner --- */
  .aiwo-v1-keybanner__bar {
    background: linear-gradient(90deg, #413825 0%, #201C13 50%, #413825 100%);
    color: #F6F3EF;
    padding: 10px 20px;
    border-radius: 6px;
    display: flex;
    align-items: baseline;
    gap: 6px;
    justify-content: center;   /* horizontal center */
    align-items: center;       /* vertical center */
    text-align: center;
  }
  .aiwo-v1-keybanner__pct {
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .aiwo-v1-keybanner__name {
    font-size: 14px;
    font-weight: 600;
  }
  .aiwo-v1-keybanner__sub {
    font-size: 12px;
    font-weight: 400;
    opacity: 0.75;
  }

  /* --- Benefits Grid --- */
  .aiwo-v1-benefits__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    background: #F6F3EF;
    border-radius: 8px;
    overflow: hidden;
  }
  .aiwo-v1-benefits__item {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    padding: 14px 16px;
    border-bottom: 1px solid #eeece8;
  }
  .aiwo-v1-benefits__item:nth-child(odd) {
    border-right: 1px solid #eeece8;
  }
  .aiwo-v1-benefits__item:nth-last-child(-n+2) {
    border-bottom: none;
  }
  .aiwo-v1-benefits__icon-wrap {
    flex-shrink: 0;
    width: 35px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .aiwo-v1-benefits__icon-wrap img {
    width: 28px;
    height: 28px;
    object-fit: contain;
  }
  .aiwo-v1-benefits__emoji {
    font-size: 22px;
    line-height: 1;
  }
  .aiwo-v1-benefits__title {
    font-size: 16px;
    font-weight: 600;
    margin: 0 0 1px;
    color: #333333;
  }
  .aiwo-v1-benefits__desc {
    font-size: 13px;
    color: #333333;
    margin: 0;
    line-height: 1.4;
  }
  .product-form__input .input-radio:checked+label {
    background-color: #C0622A;
    border-radius: 4px;
    border-color: #C0622A;
    padding: 2px 10px;
    margin-top: 18px;
  }
  @media (max-width: 480px) {
    .aiwo-v1-benefits__grid {
      grid-template-columns: 1fr 1fr;
    }
    .aiwo-v1-benefits__item:nth-child(odd) {
      border-right: 1px solid #eeece8;
    }
    .aiwo-v1-benefits__item {
      border-bottom: 1px solid #eeece8;
      display: block;
    }
    .aiwo-v1-benefits__item:nth-child(n+3) {
      border-bottom: none;
    }
     

  }

  /* --- Proven Health Benefits --- */
  .aiwo-v1-phb {
    padding: 24px 0;
  }
  .aiwo-v1-phb__tag {
    font-family: 'Outfit', sans-serif;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: #7b6f63;
    margin-bottom: 4px;
  }
  /* PHB styles moved to aiwo-evoo-v3-gallery.css */

  /* --- Image Block V1 --- */
  .aiwo-v1-imgblock__mobile { display: none; }
  @media (max-width: 480px) {
    .aiwo-v1-imgblock__desktop { display: none; }
    .aiwo-v1-imgblock__mobile { display: block; }
  }

  /* --- FAQ Accordion V1 --- */
  .aiwo-v1-faq {
    padding: 32px 0;
  }
  .aiwo-v1-faq__tag {
    font-family: 'Outfit', sans-serif;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: #7b6f63;
    margin-bottom: 4px;
    border: 1px solid #7b6f63;
    display: inline-block;
    padding: 4px 10px;
    border-radius: 4px;
  }
  .aiwo-v1-faq__title {
    font-family: 'Outfit', sans-serif;
    font-size: 28px;
    font-weight: 700;
    color: #1a1a1a;
    margin-bottom: 24px;
  }
  .aiwo-v1-faq__list {
    border-top: 1px solid #ddd;
  }
  .aiwo-v1-faq__item {
    border-bottom: 1px solid #ddd;
  }
  .aiwo-v1-faq__question {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 18px 0;
    cursor: pointer;
    gap: 16px;
    -webkit-user-select: none;
