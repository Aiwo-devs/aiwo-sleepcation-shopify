    "section_evoo_v3_faq_rRJhLR": {
      "type": "section-evoo-v3-faq",
      "blocks": {
        "faq_item_BFc6Am": {
          "type": "faq_item",
          "settings": {
            "question": "What is blackstrap molasses and how is it different from jaggery?",
            "answer": "<p>Blackstrap molasses is the concentrated liquid byproduct of the third stage of sugarcane refining the point where the most minerals remain because the most sugar has been extracted. Jaggery is unrefined sugarcane juice solidified before refining. Molasses is darker, more bitter, and more mineral-dense. Different product, different flavour, different nutritional profile.<br/><br/></p>"
          }
        },
        "faq_item_pgG9dR": {
          "type": "faq_item",
          "settings": {
            "question": "Why is \"sulphur-free\" important?",
            "answer": "<p>Standard molasses processing often uses sulphur dioxide as a preservative and bleaching agent. Sulphur residues affect flavour producing a sharper, less clean taste and are a concern for sensitive individuals. AIWO Blackstrap Molasses is sulphur-free: no sulphur compounds in processing, cleaner flavour, cleaner label.<br/><br/></p>"
          }
        },
        "faq_item_zet6LP": {
          "type": "faq_item",
          "settings": {
            "question": " Can I use it as a daily sugar replacement?",
            "answer": "<p>Yes as a partial replacement in cooking, baking, and beverages. Blackstrap molasses has a strong, bittersweet flavour that pairs well with chai, oatmeal, gingerbread, sauces, and marinades. It is not a neutral sweetener recipes benefit from the flavour rather than hiding it.<br/><br/></p>"
          }
        },
        "faq_item_Q6TUxh": {
          "type": "faq_item",
          "settings": {
            "question": " Is it suitable for children?",
            "answer": "<p>The product label is suitable for general adult use. For children, consult your physician or nutritionist regarding appropriate serving sizes. Not for medicinal use.<br/><br/></p>"
          }
        },
        "faq_item_WyBt4K": {
          "type": "faq_item",
          "settings": {
            "question": " How should I store it?",
            "answer": "<p>Store in a cool, dry place away from direct sunlight. Refrigerate after opening if ambient temperature exceeds 28°C. Close the cap tightly after every use. The natural sugars will crystallise if exposed to temperature fluctuation this does not affect quality.<br/><br/></p>"
          }
        }
      },
      "block_order": [
        "faq_item_BFc6Am",
