<script>
  (function() {
    class OmegaHero{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.basePrice30 = {{ block.settings.price_30 | default: 0 }};
        this.basePrice60 = {{ block.settings.price_60 | default: 0 }};
        this.currentBasePrice = this.basePrice30;
      }

      connectedCallback() {
        this.quantityOptions = this.querySelectorAll('.ai-omega-hero-quantity-option-{{ ai_gen_id }}');
        this.priceValue = this.querySelector('.ai-omega-hero-price-value-{{ ai_gen_id }}');
        this.shopLink = this.querySelector('.ai-omega-hero-shop-link-{{ ai_gen_id }}');
        this.shopNowLink = this.querySelector('.ai-omega-hero-shop-now-link-{{ ai_gen_id }}');
        this.dynamicCount = this.querySelector('.ai-omega-hero-dynamic-count-{{ ai_gen_id }}');
        this.productImages = this.querySelectorAll('.ai-omega-hero-product-image-{{ ai_gen_id }}');
        this.qtyInput = this.querySelector('.ai-omega-hero-qty-input-{{ ai_gen_id }}');
        this.qtyDecrease = this.querySelector('.ai-omega-hero-qty-decrease-{{ ai_gen_id }}');
        this.qtyIncrease = this.querySelector('.ai-omega-hero-qty-increase-{{ ai_gen_id }}');

        this.setupQuantitySelector();
        this.setupQuantityControls();
      }

      setupQuantitySelector() {
        this.quantityOptions.forEach(option => {
          option.addEventListener('click', () => {
            this.quantityOptions.forEach(opt => opt.classList.remove('active'));
            option.classList.add('active');

            const quantity = option.getAttribute('data-quantity');
            const price = parseFloat(option.getAttribute('data-price'));
            const link = option.getAttribute('data-link');
            const imageId = option.getAttribute('data-image');

            if (quantity === '30') {
              this.currentBasePrice = this.basePrice30;
            } else if (quantity === '60') {
              this.currentBasePrice = this.basePrice60;
            }

            this.updateTotalPrice();

            if (this.shopLink && link) {
              this.shopLink.setAttribute('href', link);
            }

            if (this.shopNowLink && link) {
              this.shopNowLink.setAttribute('href', link);
            }

            if (this.dynamicCount) {
              this.dynamicCount.textContent = quantity;
            }

            if (imageId && this.productImages.length > 0) {
              this.productImages.forEach(img => {
                if (img.getAttribute('data-image-id') === imageId) {
                  img.style.display = 'block';
                  img.classList.add('ai-omega-hero-active-image-{{ ai_gen_id }}');
                } else {
                  img.style.display = 'none';
                  img.classList.remove('ai-omega-hero-active-image-{{ ai_gen_id }}');
                }
              });
            }
          });
        });
      }

      setupQuantityControls() {
        if (this.qtyDecrease) {
          this.qtyDecrease.addEventListener('click', () => {
            const currentValue = parseInt(this.qtyInput.value);
            const minValue = parseInt(this.qtyInput.getAttribute('min'));
            if (currentValue > minValue) {
              this.qtyInput.value = currentValue - 1;
              this.updateQuantityButtons();
              this.updateTotalPrice();
            }
          });
        }

        if (this.qtyIncrease) {
          this.qtyIncrease.addEventListener('click', () => {
            const currentValue = parseInt(this.qtyInput.value);
            const maxValue = parseInt(this.qtyInput.getAttribute('max'));
            if (currentValue < maxValue) {
              this.qtyInput.value = currentValue + 1;
              this.updateQuantityButtons();
              this.updateTotalPrice();
            }
          });
        }

        this.updateQuantityButtons();
      }

      updateQuantityButtons() {
        const currentValue = parseInt(this.qtyInput.value);
        const minValue = parseInt(this.qtyInput.getAttribute('min'));
        const maxValue = parseInt(this.qtyInput.getAttribute('max'));

        if (this.qtyDecrease) {
          this.qtyDecrease.disabled = currentValue <= minValue;
        }

        if (this.qtyIncrease) {
          this.qtyIncrease.disabled = currentValue >= maxValue;
        }
      }

      updateTotalPrice() {
        const qty = parseInt(this.qtyInput.value);
        const totalPrice = this.currentBasePrice * qty;
        
        if (this.priceValue) {
          this.priceValue.textContent = totalPrice.toFixed(0);
        }
      }
    }

    customElements.define('omega-hero-{{ ai_gen_id }}', OmegaHero{{ ai_gen_id }});
  })();
</script>

