<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>
  .policy-page {
    max-width: 820px;
    margin: 0 auto;
    padding: 40px 20px 60px;
    font-family: 'Outfit', sans-serif;
    color: #1a1a1a;
  }
  .policy-page__title {
    font-family: 'Outfit', sans-serif;
    font-size: 36px;
    font-weight: 700;
    margin-bottom: 8px;
    line-height: 1.2;
  }
  .policy-page__updated {
    font-size: 13px;
    color: #999;
    margin-bottom: 32px;
  }
  .policy-page__body {
    font-size: 15px;
    line-height: 1.8;
    color: #444;
  }
  .policy-page__body h1,
  .policy-page__body h2,
  .policy-page__body h3,
  .policy-page__body h4,
  .policy-page__body h5,
  .policy-page__body h6 {
    font-family: 'Outfit', sans-serif;
    font-weight: 600;
    color: #1a1a1a;
    margin-top: 32px;
    margin-bottom: 12px;
  }
  .policy-page__body h2 { font-size: 22px; }
  .policy-page__body h3 { font-size: 18px; }
  .policy-page__body p { margin-bottom: 16px; }
  .policy-page__body ul,
  .policy-page__body ol {
    margin-bottom: 16px;
    padding-left: 24px;
  }
  .policy-page__body li { margin-bottom: 6px; }
  .policy-page__body a {
    color: #3a7d34;
    text-decoration: underline;
  }
  .policy-page__body strong { font-weight: 600; color: #1a1a1a; }
  .policy-page__body table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 16px;
  }
  .policy-page__body th,
  .policy-page__body td {
    border: 1px solid #e5e5e5;
    padding: 10px 14px;
    text-align: left;
    font-size: 14px;
  }
  .policy-page__body th {
    background: #f5f5f5;
    font-weight: 600;
  }
  @media (max-width: 480px) {
    .policy-page { padding: 24px 16px 40px; }
    .policy-page__title { font-size: 26px; }
    .policy-page__body { font-size: 14px; }
  }
</style>

<div class="policy-page">
  {% if section.settings.show_title %}
    <h1 class="policy-page__title">{{ page.title }}</h1>
  {% endif %}
  {% if section.settings.updated_date != blank %}
    <p class="policy-page__updated">Last updated: {{ section.settings.updated_date }}</p>
  {% endif %}
  {% if page.content != blank %}
    <div class="policy-page__body">
      {{ page.content }}
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Policy Page",
  "tag": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Show Page Title",
      "default": true
    },
    {
      "type": "text",
      "id": "updated_date",
      "label": "Last Updated Date",
      "default": "March 2026"
    }
  ]
}
{% endschema %}