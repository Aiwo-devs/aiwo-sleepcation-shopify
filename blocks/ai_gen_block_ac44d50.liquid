{% doc %}
  @prompt
    Design an "Advanced Enteric Coating Technology" highlight section for AIWO Ultimate Omega 3.
    Layout:
    Full-width banner section with deep navy blue background (#0A1F5C), white text, rounded corners, generous padding (60px vertical).
    Header:
    
    Centered bold white heading (large): "Advanced Enteric Coating Technology"
    
    Description:
    
    Centered white text (medium size): "Our molecularly distilled fish oil with enteric coating ensures complete absorption in the intestine, eliminating burping and foul taste while protecting omega-3 fatty acids from stomach acids."
    Maximum width constraint for readability, centered alignment
    
    Statistics Row (3 columns, equal width):
    Stat 1:
    
    Large bold white number: "46%"
    Label below in white: "EPA Content"
    
    Stat 2:
    
    Large bold white number: "38%"
    Label below in white: "DHA Content"
    
    Stat 3:
    
    Large bold white number: "100%"
    Label below in white: "Enteric Coated"
    
    Styling:
    
    Statistics evenly spaced across the width
    Numbers in extra-large bold font
    Labels in regular weight, smaller font
    All text centered within each column
    Adequate spacing between description and statistics (40px gap)
    
    Responsive: 3 columns on desktop, 3 columns on tablet, 1 column (stacked) on mobile. Padding reduces on smaller screens.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-enteric-coating-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
    text-align: center;
  }

  .ai-enteric-coating-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-enteric-coating-heading-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 700;
    margin: 0 0 {{ block.settings.spacing_after_heading }}px 0;
    line-height: 1.2;
  }

  .ai-enteric-coating-description-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.description_size }}px;
    line-height: 1.6;
    margin: 0 0 {{ block.settings.spacing_after_description }}px 0;
    max-width: {{ block.settings.description_max_width }}px;
    margin-left: auto;
    margin-right: auto;
  }

  .ai-enteric-coating-stats-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.stats_gap }}px;
    margin-top: {{ block.settings.spacing_after_description }}px;
  }

  .ai-enteric-coating-stat-{{ ai_gen_id }} {
    text-align: center;
  }

  .ai-enteric-coating-stat-number-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.stat_number_size }}px;
    font-weight: 700;
    line-height: 1;
    margin: 0 0 {{ block.settings.spacing_between_stat }}px 0;
  }

  .ai-enteric-coating-stat-label-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.stat_label_size }}px;
    font-weight: 400;
    line-height: 1.4;
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-enteric-coating-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_vertical_mobile }}px {{ block.settings.padding_horizontal_mobile }}px;
    }

    .ai-enteric-coating-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
    }

    .ai-enteric-coating-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_size | times: 0.9 }}px;
    }

    .ai-enteric-coating-stats-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.stats_gap_mobile }}px;
    }

    .ai-enteric-coating-stat-number-{{ ai_gen_id }} {
      font-size: {{ block.settings.stat_number_size | times: 0.8 }}px;
    }

    .ai-enteric-coating-stat-label-{{ ai_gen_id }} {
      font-size: {{ block.settings.stat_label_size | times: 0.9 }}px;
    }
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    .ai-enteric-coating-stats-{{ ai_gen_id }} {
      grid-template-columns: repeat(3, 1fr);
    }
  }
{% endstyle %}

<enteric-coating-{{ ai_gen_id }} class="ai-enteric-coating-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-enteric-coating-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-enteric-coating-heading-{{ ai_gen_id }}">
        {{ block.settings.heading }}
      </h2>
    {% endif %}

    {% if block.settings.description != blank %}
      <div class="ai-enteric-coating-description-{{ ai_gen_id }}">
        {{ block.settings.description }}
      </div>
    {% endif %}

    <div class="ai-enteric-coating-stats-{{ ai_gen_id }}">
      <div class="ai-enteric-coating-stat-{{ ai_gen_id }}">
        <div class="ai-enteric-coating-stat-number-{{ ai_gen_id }}">
          {{ block.settings.stat_1_number }}
        </div>
        <div class="ai-enteric-coating-stat-label-{{ ai_gen_id }}">
          {{ block.settings.stat_1_label }}
        </div>
      </div>

      <div class="ai-enteric-coating-stat-{{ ai_gen_id }}">
        <div class="ai-enteric-coating-stat-number-{{ ai_gen_id }}">
          {{ block.settings.stat_2_number }}
        </div>
        <div class="ai-enteric-coating-stat-label-{{ ai_gen_id }}">
          {{ block.settings.stat_2_label }}
        </div>
      </div>

      <div class="ai-enteric-coating-stat-{{ ai_gen_id }}">
        <div class="ai-enteric-coating-stat-number-{{ ai_gen_id }}">
          {{ block.settings.stat_3_number }}
        </div>
        <div class="ai-enteric-coating-stat-label-{{ ai_gen_id }}">
          {{ block.settings.stat_3_label }}
        </div>
      </div>
    </div>
  </div>
</enteric-coating-{{ ai_gen_id }}>

<script>
  (function() {
    class EntericCoating{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('enteric-coating-{{ ai_gen_id }}', EntericCoating{{ ai_gen_id }});
  })();
</script>

