<script>
  (function() {
    class ComboOffers{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.buttons = this.querySelectorAll('.ai-combo-cta-{{ ai_gen_id }}');
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.buttons.forEach((button) => {
          button.addEventListener('click', (e) => {
            const productUrl = button.getAttribute('data-product-url');
            if (productUrl) {
              window.location.href = productUrl;
            }
          });
        });
      }
    }

    customElements.define('combo-offers-{{ ai_gen_id }}', ComboOffers{{ ai_gen_id }});
  })();
</script>

