    "testimonials_bPAxbw": {
      "type": "testimonials",
      "blocks": {
        "testimonial_J4KxCC": {
          "type": "testimonial",
          "settings": {
            "icon_star": "5_star",
            "custom_icon": "",
            "title": "Janaki M",
            "text": "<p><em>I was amazed at how extensive the AIWO 77 package is. With so many tests included, I got a clear picture of my overall health in one go. The reports were detailed yet easy to understand, and it really helped me track areas I need to improve.</em></p>",
            "author": "",
            "author_note": "",
            "product": ""
          }
        },
        "testimonial_mDNQRF": {
          "type": "testimonial",
          "settings": {
            "icon_star": "5_star",
            "custom_icon": "",
            "title": "Arjun Lal",
            "text": "<p><em>Very cost-effective compared to other packages I checked. I feel reassured knowing that so many health parameters were tested at once. The process was smooth and professional.</em></p>",
            "author": "",
            "author_note": "",
            "product": ""
          }
        },
        "testimonial_BYX7YM": {
          "type": "testimonial",
          "settings": {
            "icon_star": "5_star",
            "custom_icon": "",
            "title": "Sneha Nair",
            "text": "<p><em>As someone who’s proactive about my health, AIWO 77 was the perfect package. It's rare to find such a comprehensive set of tests at this price point. Highly recommend to anyone wanting a thorough check-up.</em></p>",
            "author": "",
            "author_note": "",
            "product": ""
          }
        },
        "testimonial_YqTdmw": {
          "type": "testimonial",
          "settings": {
            "icon_star": "5_star",
            "custom_icon": "",
            "title": "Ravi Bhaskar",
            "text": "<p><em>I booked this package for my parents and the experience was excellent. They felt comfortable, and the reports gave us vital information to discuss with the doctor. Great value for families.</em></p>",
            "author": "",
            "author_note": "",
            "product": ""
          }
        },
        "testimonial_38rzhh": {
          "type": "testimonial",
          "settings": {
            "icon_star": "5_star",
            "custom_icon": "",
            "title": "Meera Reji",
            "text": "<p><em>AIWO 77 is truly one of the most complete health check-ups I’ve taken. It gave me peace of mind by highlighting both the strengths and areas to watch in my health. Will definitely choose this again for routine monitoring.</em></p>",
            "author": "",
            "author_note": "",
            "product": ""
          }
        }
