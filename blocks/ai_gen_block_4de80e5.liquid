{% doc %}
  @prompt
    Create a stunning hero section for Fast Bar + EVOO combo launch landing page.
    
    LAYOUT: Split screen - 60% text left, 40% image right (stack vertically on mobile, image first)
    
    LEFT SIDE CONTENT:
    
    Main Heading:
    "Your Fasting Journey Is Harder Than It Should Be"
    - Font: Poppins Bold, 54px desktop / 32px mobile
    - Color: #211E1E
    - IMPORTANT: Style "Fasting Journey" in italic font-style with color #D68641
    - Line height: 1.2
    - Margin bottom: 20px
    
    Subheading:
    "Start a new chapter with India's first science-backed fasting nutrition system. Get premium Fast Bars + Extra Virgin Olive Oil with exclusive freebies worth ₹11,000+"
    - Font: Lato Regular, 18px
    - Color: #545252
    - Line height: 1.6
    - Max width: 600px
    - Margin bottom: 32px
    
    Stats Row (4 items horizontal, clean icons):
    [Icon] 5g Protein  |  [Icon] Rich in MCTs  |  [Icon] Premium Ingredients  |  [Icon] A.C. Verified
    - Icons: 32x32px, minimal line style
    - Text: Poppins SemiBold 16px (top) + Lato 13px (bottom)
    - Gap: 32px between items
    - Mobile: 2x2 grid
    
    Primary CTA Button:
    "View Combo Deals ↓"
    - Background: #5B2E28
    - Text: #FFFFFF, Poppins SemiBold 18px
    - Padding: 18px 48px
    - Border radius: 0px (sharp corners)
    - Hover effect: Fill from left to right with #FFFFFF, text changes to #5B2E28
    - Smooth transition: 0.4s ease
    
    Secondary Link (beside button):
    "How It Works →"
    - Font: Lato Regular 16px
    - Color: #211E1E
    - Text underline, underline-offset: 4px
    - Hover: #D68641
    
    Countdown Timer (below buttons):
    "⏰ Offer Ends In: 23:45:12"
    - Background: #FFF6EF
    - Padding: 12px 20px
    - Font: Poppins Medium 16px
    - Color: #211E1E
    - Display: inline-flex, align-items center
    - Make countdown live/functional
    
    Trust Badges Row (small, bottom):
    ✓ FSSAI Approved  |  ✓ 30-Day Guarantee  |  ✓ Free Shipping  |  ✓ 10,000+ Customers
    - Font: Lato Regular 13px
    - Color: #545252
    - Checkmarks: #4CAF50
    - Separator: 1px border-top, padding-top 20px
    - Mobile: wrap to 2x2
    
    RIGHT SIDE CONTENT:
    
    Product Image:
    - High-quality Fast Bar pack + EVOO bottle
    - Clean white/transparent background
    - Subtle shadow: 0 4px 20px rgba(33,30,30,0.08)
    
    Floating Discount Badge (position absolute, top-right):
    Circular badge 120x120px
    Text: "UP TO" / "72%" / "OFF" (stacked)
    - Background: #5B2E28
    - Text: #FFFFFF
    - Font: Poppins Bold
    - Animation: subtle pulse (scale 1 to 1.05, 2s infinite)
    
    DESIGN SPECIFICATIONS:
    - Background: #FFFFFF
    - Section padding: 64px top/bottom, 20px left/right
    - Max-width: 1400px, centered
    - Grid gap: 48px
    
    MOBILE RESPONSIVE:
    - Stack: Image → Text
    - Heading: 32px
    - Subheading: 16px
    - Full-width buttons
    - Stats: 2x2 grid, gap 20px
    - Section padding: 48px vertical, 20px horizontal
    
    AESTHETIC: Swiss minimalism, premium health brand, clean typography, generous white space, sophisticated without being cold, conversion-focused layout
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-hero-fastbar-{{ ai_gen_id }} {
    display: block;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding_desktop }}px 20px;
    width: 100%;
  }

  .ai-hero-fastbar-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 60% 40%;
    gap: {{ block.settings.grid_gap }}px;
    align-items: center;
  }

  .ai-hero-fastbar-content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .ai-hero-fastbar-heading-{{ ai_gen_id }} {
    font-family: 'Poppins', sans-serif;
    font-weight: 700;
    font-size: {{ block.settings.heading_size_desktop }}px;
    line-height: 1.2;
    color: {{ block.settings.heading_color }};
    margin: 0 0 20px 0;
  }

  .ai-hero-fastbar-heading-highlight-{{ ai_gen_id }} {
    font-style: italic;
    color: {{ block.settings.heading_highlight_color }};
  }

  .ai-hero-fastbar-subheading-{{ ai_gen_id }} {
    font-family: 'Lato', sans-serif;
    font-weight: 400;
    font-size: {{ block.settings.subheading_size_desktop }}px;
    line-height: 1.6;
    color: {{ block.settings.subheading_color }};
    max-width: 600px;
    margin: 0 0 32px 0;
  }

  .ai-hero-fastbar-stats-{{ ai_gen_id }} {
    display: flex;
    gap: 32px;
    margin-bottom: 32px;
  }

  .ai-hero-fastbar-stat-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .ai-hero-fastbar-stat-icon-{{ ai_gen_id }} {
    width: 32px;
    height: 32px;
    color: {{ block.settings.stat_icon_color }};
  }

  .ai-hero-fastbar-stat-title-{{ ai_gen_id }} {
    font-family: 'Poppins', sans-serif;
    font-weight: 600;
    font-size: 16px;
    color: {{ block.settings.heading_color }};
    text-align: center;
  }

  .ai-hero-fastbar-stat-subtitle-{{ ai_gen_id }} {
    font-family: 'Lato', sans-serif;
    font-size: 13px;
    color: {{ block.settings.subheading_color }};
    text-align: center;
  }

  .ai-hero-fastbar-cta-wrapper-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-bottom: 24px;
  }

  .ai-hero-fastbar-primary-btn-{{ ai_gen_id }} {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 18px 48px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    font-family: 'Poppins', sans-serif;
    font-weight: 600;
    font-size: 18px;
    text-decoration: none;
    border-radius: 0;
    border: none;
    cursor: pointer;
    overflow: hidden;
    transition: color 0.4s ease;
  }

  .ai-hero-fastbar-primary-btn-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: 100%;
    background-color: {{ block.settings.button_hover_bg_color }};
    transition: width 0.4s ease;
    z-index: 0;
  }

  .ai-hero-fastbar-primary-btn-{{ ai_gen_id }}:hover::before {
    width: 100%;
  }

  .ai-hero-fastbar-primary-btn-{{ ai_gen_id }}:hover {
    color: {{ block.settings.button_hover_text_color }};
  }

  .ai-hero-fastbar-primary-btn-{{ ai_gen_id }} span {
    position: relative;
    z-index: 1;
  }

  .ai-hero-fastbar-secondary-link-{{ ai_gen_id }} {
    font-family: 'Lato', sans-serif;
    font-size: 16px;
    color: {{ block.settings.heading_color }};
    text-decoration: underline;
    text-underline-offset: 4px;
    transition: color 0.3s ease;
  }

  .ai-hero-fastbar-secondary-link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.heading_highlight_color }};
  }

  .ai-hero-fastbar-countdown-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: {{ block.settings.countdown_bg_color }};
    padding: 12px 20px;
    margin-bottom: 20px;
  }

  .ai-hero-fastbar-countdown-text-{{ ai_gen_id }} {
    font-family: 'Poppins', sans-serif;
    font-weight: 500;
    font-size: 16px;
    color: {{ block.settings.heading_color }};
  }

  .ai-hero-fastbar-trust-badges-{{ ai_gen_id }} {
    display: flex;
    gap: 24px;
    padding-top: 20px;
    border-top: 1px solid {{ block.settings.trust_border_color }};
  }

  .ai-hero-fastbar-trust-badge-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: 'Lato', sans-serif;
    font-size: 13px;
    color: {{ block.settings.subheading_color }};
  }

  .ai-hero-fastbar-trust-check-{{ ai_gen_id }} {
    color: {{ block.settings.trust_check_color }};
    font-size: 16px;
  }

  .ai-hero-fastbar-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-hero-fastbar-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    filter: drop-shadow(0 4px 20px rgba(33, 30, 30, 0.08));
  }

  .ai-hero-fastbar-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 400px;
    position: relative;
  }

  .ai-hero-fastbar-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 400px;
    max-height: 400px;
  }

  .ai-hero-fastbar-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-hero-fastbar-discount-badge-{{ ai_gen_id }} {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 120px;
    height: 120px;
    border-radius: 50%;
    background-color: {{ block.settings.badge_bg_color }};
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    animation: ai-hero-fastbar-pulse-{{ ai_gen_id }} 2s infinite;
    z-index: 2;
  }

  .ai-hero-fastbar-badge-text-{{ ai_gen_id }} {
    font-family: 'Poppins', sans-serif;
    font-weight: 700;
    color: {{ block.settings.badge_text_color }};
    text-align: center;
    line-height: 1.2;
  }

  .ai-hero-fastbar-badge-up-{{ ai_gen_id }} {
    font-size: 14px;
  }

  .ai-hero-fastbar-badge-percent-{{ ai_gen_id }} {
    font-size: 36px;
  }

  .ai-hero-fastbar-badge-off-{{ ai_gen_id }} {
    font-size: 14px;
  }

  @keyframes ai-hero-fastbar-pulse-{{ ai_gen_id }} {
    0%, 100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.05);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-hero-fastbar-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_mobile }}px 20px;
    }

    .ai-hero-fastbar-container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .ai-hero-fastbar-image-wrapper-{{ ai_gen_id }} {
      order: -1;
    }

    .ai-hero-fastbar-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_mobile }}px;
    }

    .ai-hero-fastbar-subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size_mobile }}px;
    }

    .ai-hero-fastbar-stats-{{ ai_gen_id }} {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }

    .ai-hero-fastbar-cta-wrapper-{{ ai_gen_id }} {
      flex-direction: column;
      align-items: stretch;
      gap: 16px;
    }

    .ai-hero-fastbar-primary-btn-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-hero-fastbar-secondary-link-{{ ai_gen_id }} {
      text-align: center;
    }

    .ai-hero-fastbar-trust-badges-{{ ai_gen_id }} {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }

    .ai-hero-fastbar-discount-badge-{{ ai_gen_id }} {
      width: 100px;
      height: 100px;
      top: 10px;
      right: 10px;
    }

    .ai-hero-fastbar-badge-percent-{{ ai_gen_id }} {
      font-size: 30px;
    }
  }
{% endstyle %}

<fast-bar-hero-{{ ai_gen_id }} class="ai-hero-fastbar-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
