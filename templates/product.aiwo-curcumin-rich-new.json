      "blocks": {
        "ai_gen_block_59d31d1_UgYN4J": {
          "type": "ai_gen_block_59d31d1",
          "settings": {
            "gradient_color_1": "#ffdab9",
            "gradient_color_2": "#ffe4c4",
            "container_max_width": 800,
            "heading": "Frequently Asked Questions",
            "heading_size": 36,
            "heading_color": "#000000",
            "subtitle": "Everything you need to know about AIWO Curcumin Rich",
            "subtitle_size": 16,
            "subtitle_color": "#525151",
            "open_first": true,
            "allow_multiple": false,
            "card_background": "#ffffff",
            "border_color": "#fb8500",
            "border_hover_color": "#cc6d00",
            "border_width": 2,
            "border_radius": 12,
            "question_size": 18,
            "question_color": "#000000",
            "icon_color": "#fb8500",
            "answer_size": 15,
            "answer_color": "#666666",
            "question_1": "How is this different from just eating turmeric in food?",
            "answer_1": "Turmeric spice contains only 2-5% curcumin. To get 493mg curcumin (one AIWO capsule), you'd need 10-25 grams (2-5 teaspoons) of turmeric powder daily - impractical and inconsistent. Plus, dietary turmeric has poor absorption even with black pepper. AIWO provides concentrated, standardized BCM-95® extract with 7x better bioavailability.",
            "question_2": "How long until I see results?",
            "answer_2": "Results vary by individual and health goals. Some notice initial benefits (mood, energy, digestion) within 2-4 weeks. Joint comfort improvements typically appear within 4-8 weeks of consistent daily use. For best results, commit to daily use for at least 2-3 months.",
            "question_3": "Can I take this with other supplements?",
            "answer_3": "Yes, curcumin generally combines well with other supplements. Works synergistically with omega-3s, vitamin D, boswellia, and ginger. However, separate from iron supplements by 2+ hours. If you take prescription medications, always consult your healthcare provider first.",
            "question_4": "Is this safe for long-term use?",
            "answer_4": "Yes, curcumin has an excellent safety profile for long-term use at recommended doses. Turmeric has been consumed safely for thousands of years. Clinical studies have used curcumin supplementation for 6-12 months with good safety outcomes.",
            "question_5": "Why vegetarian capsules instead of gelatin?",
            "answer_5": "We use HPMC vegetarian capsules because they're 100% plant-based, suitable for vegetarians and vegans, more stable than gelatin capsules, and Kosher/Halal compatible. Some individuals also find them easier to digest.",
            "question_6": "Can my elderly parents take this?",
            "answer_6": "Curcumin may be particularly beneficial for aging adults. However, elderly individuals often take multiple medications, so consulting their physician is absolutely essential before starting any supplement. Medical supervision is critical for safe supplementation."
          },
          "blocks": {}
        }
