{% comment %} Two Column Grid Section {% endcomment %}

{%- style -%}
  #shopify-section-{{ section.id }} .two-col-section {
    padding: 60px 40px;
    width: 100%;
    box-sizing: border-box;
    {% if section.settings.bg_image %}
      background-image: url('{{ section.settings.bg_image | image_url: width: 2000 }}');
      background-size: cover;
      background-position: center 24%;
      background-repeat: no-repeat;
    {% elsif section.settings.bg_color %}
      background-color: {{ section.settings.bg_color }};
    {% endif %}
  }
  @media (max-width: 768px) {
    {% if section.settings.bg_image_mobile %}
      #shopify-section-{{ section.id }} .two-col-section {
        background-image: url('{{ section.settings.bg_image_mobile | image_url: width: 1000 }}');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
      }
    {% endif %}
  }
  #shopify-section-{{ section.id }} .col-heading {
    font-size: {{ section.settings.heading_size_mobile }}px;
    font-weight: 700;
    margin-bottom: 16px;
    line-height: 1.3;
    color: {{ section.settings.heading_color }};
  }
  #shopify-section-{{ section.id }} .col-description {
    font-size: {{ section.settings.description_size_mobile }}px;
    line-height: 1.7;
    margin-bottom: 24px;
    color: {{ section.settings.description_color }};
  }
  @media (min-width: 769px) {
    #shopify-section-{{ section.id }} .col-heading {
      font-size: {{ section.settings.heading_size }}px;
    }
    #shopify-section-{{ section.id }} .col-description {
      font-size: {{ section.settings.description_size }}px;
    }
  }
{%- endstyle -%}

<section class="two-col-section">
  <div class="two-col-grid">

    <div class="col-one">
      <h2 class="col-heading">{{ section.settings.heading }}</h2>
      <p class="col-description">{{ section.settings.description }}</p>
      <a href="{{ section.settings.cta_link }}" class="col-cta-btn">
        {{ section.settings.cta_text }}
      </a>
    </div>

    <div class="col-two"></div>

  </div>
</section>

<style>
  .two-col-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: center;
    max-width: 1400px;
    margin: 0 auto;
  }
  .col-one {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .col-cta-btn {
    display: inline-block;
    padding: 14px 32px;
    background-color: #000;
    color: #fff;
    text-decoration: none;
    font-weight: 600;
    border-radius: 4px;
    transition: background-color 0.3s ease;
  }
  .col-cta-btn:hover { background-color: #333; }
  @media (max-width: 768px) {
    .two-col-grid { grid-template-columns: 1fr; }
    .col-one { align-items: flex-start; text-align: left; }
  }
</style>

{% schema %}
{
  "name": "Two Column Grid",
  "settings": [
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image — Desktop / Tablet"
    },
    {
      "type": "image_picker",
      "id": "bg_image_mobile",
      "label": "Background image — Mobile"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background colour (fallback)",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your Heading Here"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size — desktop",
      "min": 16,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size — mobile",
      "min": 14,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading colour",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Description"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Add your description text here to tell your story."
    },
    {
      "type": "range",
      "id": "description_size",
      "label": "Description size — desktop",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "description_size_mobile",
      "label": "Description size — mobile",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description colour",
      "default": "#555555"
    },
    {
      "type": "header",
      "content": "CTA Button"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Two Column Grid"
    }
  ]
}
{% endschema %}
