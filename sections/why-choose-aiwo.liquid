      </h2>
    </header>
    
    <div class="why-choose_grid">
      
      <div class="why-choose_row">
        
        <article class="why-choose_card">
          <div class="why-choose_card-content">
            <h3 class="why-choose_card-title">{{ section.settings.card_1_title }}</h3>
            <p class="why-choose_card-text">{{ section.settings.card_1_description }}</p>
          </div>
          {%- if section.settings.card_1_image -%}
            <div class="why-choose_card-media why-choose_card-media--woman">
              {{- section.settings.card_1_image | image_url: width: 272 | image_tag: loading: 'lazy', alt: section.settings.card_1_title -}}
            </div>
