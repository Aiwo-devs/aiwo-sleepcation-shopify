    "section_evoo_v3_faq_rRJhLR": {
      "type": "section-evoo-v3-faq",
      "blocks": {
        "faq_item_BFc6Am": {
          "type": "faq_item",
          "settings": {
            "question": "What makes macadamia better than other nuts in a bar?",
            "answer": "<p>Macadamia has the highest monounsaturated fat content of any nut specifically oleic acid, the same fat found in extra virgin olive oil. It is associated with cardiovascular support and cognitive nourishment. Most bars use cheaper nuts like peanuts or cashews as the base. AIWO Macadamia Bar is built around macadamia as the hero ingredient, not a garnish.</p>"
          }
        },
        "faq_item_pgG9dR": {
          "type": "faq_item",
          "settings": {
            "question": "Is there added sugar in this bar?",
            "answer": "<p>No added sugar. The sweetness comes from brown rice sugar syrup a less refined sweetener with no high-fructose syrups, cane sugar, or artificial sweeteners in the formula.</p>"
          }
        },
        "faq_item_zet6LP": {
          "type": "faq_item",
          "settings": {
            "question": "Can I eat this bar if I am watching my cholesterol?",
            "answer": "<p>Yes. AIWO Macadamia Bar contains zero dietary cholesterol per serving. All fat in the bar comes from nuts and dry coconut unsaturated fat sources.</p>"
          }
        },
        "faq_item_Q6TUxh": {
          "type": "faq_item",
          "settings": {
            "question": "When is the best time to eat this bar?",
            "answer": "<p>Mid-morning when cognitive demand is high, post-workout as a recovery snack, or in the afternoon as a clean energy bridge. One bar. No preparation needed.</p>"
          }
        },
        "faq_item_WyBt4K": {
          "type": "faq_item",
          "settings": {
            "question": "Does it contain allergens I should know about?",
            "answer": "<p>Yes. The bar contains nuts and soy as declared on the allergen panel. If you have nut or soy sensitivities, review the full ingredient list before consuming.</p>"
          }
        }
      },
