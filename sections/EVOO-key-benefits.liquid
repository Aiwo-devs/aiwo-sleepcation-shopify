{% comment %}
  ============================================================
  Section  : Key Benefits
  Brand    : AIWO EVOO
  Version  : 1.2.0
  Layout   : Configurable — image left or right | heading + 2×2 benefit grid
  Tokens   : Matches site-wide colour + spacing system
  Updates  :
    v1.2.0 — Placeholder forced 1:1 on all devices
           — Border-radius set to 12px on media wrapper
           — Image position setting (Left / Right)
           — Section background color picker
           — Benefits grid fixed at 2×2 on all screen sizes
  ============================================================
{% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600;1,700&display=swap" rel="stylesheet">

<style>

/* ============================================================================
   DESIGN TOKENS
   ============================================================================ */
#kb-{{ section.id }} {
  /* Colours */
  --kb-bg:              {{ section.settings.bg_color }};
  --kb-heading-color:   #1A1818; 
  --kb-title-color:     #211E1E;
  --kb-desc-color:      #545252;
  --kb-icon-color:      #545252;

  /* Section */
  --kb-pad-v:           64px;
  --kb-pad-h:           60px;
  --kb-max-w:           1400px;

  /* Fonts */
  --kb-font:            'Poppins', sans-serif;

  /* Main Layout */
  --kb-col-gap:         80px;

  /* Heading */
  --kb-heading-size:    40px;
  --kb-heading-weight:  600;
  --kb-heading-lh:      120%;
  --kb-heading-mb:      48px;

  /* Benefit grid */
  --kb-grid-gap-col:    24px;
  --kb-grid-gap-row:    32px;

  /* Benefit Card Inner Gap */
  --kb-card-gap:        16px;

  /* Icon circle */
  --kb-icon-size:       64px;

  /* Card title */
  --kb-title-size:      24px;
  --kb-title-weight:    500;
  --kb-title-lh:        120%;

  /* Card description */
  --kb-desc-size:       16px;
  --kb-desc-weight:     500;
  --kb-desc-lh:         150%;
}

/* ============================================================================
   SECTION SHELL
   ============================================================================ */
#kb-{{ section.id }} {
  width: 100%;
  background-color: var(--kb-bg);
  padding-top: var(--kb-pad-v);
  padding-bottom: var(--kb-pad-v);
  padding-left: var(--kb-pad-h);
  padding-right: var(--kb-pad-h);
  font-family: var(--kb-font);
}

/* ============================================================================
   CONTAINER
   ============================================================================ */
#kb-{{ section.id }} .kb__container {
  max-width: var(--kb-max-w);
  margin-left: auto;
  margin-right: auto;
}

/* ============================================================================
   TWO-COLUMN GRID
   ============================================================================ */
#kb-{{ section.id }} .kb__grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  column-gap: var(--kb-col-gap);
  align-items: center;
}

/* ── Image position: Right — swap column order ── */
#kb-{{ section.id }} .kb__grid--image-right .kb__media {
  order: 2;
}
#kb-{{ section.id }} .kb__grid--image-right .kb__content {
  order: 1;
}

/* ============================================================================
   LEFT/RIGHT — IMAGE
   Forced 1:1 aspect ratio on ALL devices
   Border-radius: 12px
   ============================================================================ */
#kb-{{ section.id }} .kb__media {
  position: relative;
  width: 100%;
  padding-bottom: 100%;   /* 1:1 ratio — enforced at all breakpoints */
  border-radius: 12px;
  overflow: hidden;
  background-color: #E8E8E8;
}

/* Force both uploaded images and Shopify SVGs to cover the exact dimensions */
#kb-{{ section.id }} .kb__media img,
#kb-{{ section.id }} .kb__media .kb__media-placeholder svg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover !important;
  display: block;
}

/* Placeholder specific styling */
#kb-{{ section.id }} .kb__media .kb__media-placeholder {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

#kb-{{ section.id }} .kb__media .kb__media-placeholder svg {
  opacity: 0.8;
}

/* ============================================================================
   RIGHT/LEFT — CONTENT
   ============================================================================ */
#kb-{{ section.id }} .kb__content {
  display: flex;
  flex-direction: column;
}

/* ── Section Heading ── */
#kb-{{ section.id }} .kb__heading {
  font-size: var(--kb-heading-size);
  font-weight: var(--kb-heading-weight);
  font-style: italic;
  line-height: var(--kb-heading-lh);
  color: var(--kb-heading-color);
  margin: 0 0 var(--kb-heading-mb) 0;
  letter-spacing: -0.02em;
}

/* ============================================================================
   BENEFITS GRID — ALWAYS 2×2
   Fixed at 2 columns across ALL breakpoints including ≤479px
   ============================================================================ */
#kb-{{ section.id }} .kb__grid-benefits {
  display: grid;
  grid-template-columns: 1fr 1fr;   /* Locked 2×2 — never collapses to 1 col */
  column-gap: var(--kb-grid-gap-col);
  row-gap: var(--kb-grid-gap-row);
}

/* ── Single benefit card ── */
#kb-{{ section.id }} .kb__card {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: var(--kb-card-gap);
}

/* ── Icon wrapper ── */
#kb-{{ section.id }} .kb__icon-wrap {
  width: var(--kb-icon-size);
  height: var(--kb-icon-size);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin: 0; 
}

#kb-{{ section.id }} .kb__icon-wrap img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  display: block;
}

#kb-{{ section.id }} .kb__icon-wrap svg {
  width: 100%;
  height: 100%;
  display: block;
  stroke: var(--kb-icon-color);
  fill: none;
  stroke-width: 1.5;
  stroke-linecap: round;
  stroke-linejoin: round;
}

/* ── Benefit title ── */
#kb-{{ section.id }} .kb__card-title {
  font-size: var(--kb-title-size);
  font-weight: var(--kb-title-weight);
  line-height: var(--kb-title-lh);
  color: var(--kb-title-color);
  margin: 0;
}

/* ── Benefit description ── */
#kb-{{ section.id }} .kb__card-desc {
  font-size: var(--kb-desc-size);
  font-weight: var(--kb-desc-weight);
  line-height: var(--kb-desc-lh);
  color: var(--kb-desc-color);
  margin: 0;
}

#kb-{{ section.id }} .kb__card-desc p { margin: 0; }

/* ============================================================================
   RESPONSIVE — TABLET (≤991px)
   Single column layout. Image always 1:1.
   ============================================================================ */
@media screen and (max-width: 991px) {
  #kb-{{ section.id }} {
    --kb-pad-v:           48px;
    --kb-pad-h:           40px;
    --kb-heading-size:    36px;
    --kb-heading-mb:      32px;
    --kb-grid-gap-col:    20px;
    --kb-grid-gap-row:    28px;
    --kb-card-gap:        12px;
    --kb-icon-size:       56px;
    --kb-title-size:      20px;
    --kb-desc-size:       15px;
  }

  /* Collapse two-column layout to single column */
  #kb-{{ section.id }} .kb__grid {
    grid-template-columns: 1fr;
    row-gap: 48px;
  }

  /* Reset order for stacked layout — image always on top regardless of setting */
  #kb-{{ section.id }} .kb__grid--image-right .kb__media,
  #kb-{{ section.id }} .kb__grid--image-right .kb__content {
    order: unset;
  }

  /* 1:1 maintained — padding-bottom: 100% already set globally */
}

/* ============================================================================
   RESPONSIVE — MOBILE LANDSCAPE (≤767px)
   ============================================================================ */
@media screen and (max-width: 767px) {
  #kb-{{ section.id }} {
    --kb-pad-v:           40px;
    --kb-pad-h:           24px;
    --kb-heading-size:    32px;
    --kb-heading-mb:      28px;
    --kb-grid-gap-col:    16px;
    --kb-grid-gap-row:    24px;
    --kb-icon-size:       52px;
    --kb-title-size:      18px;
    --kb-desc-size:       14px;
  }

  #kb-{{ section.id }} .kb__grid {
    row-gap: 40px;
  }

  /* 2×2 benefits grid maintained — column-gap tightened via token above */
}

/* ============================================================================
   RESPONSIVE — MOBILE PORTRAIT (≤479px)
   ============================================================================ */
@media screen and (max-width: 479px) {
  #kb-{{ section.id }} {
    --kb-pad-v:           32px;
    --kb-pad-h:           20px;
    --kb-heading-size:    28px;
    --kb-heading-mb:      24px;
    --kb-grid-gap-col:    12px;   /* Tighter gap on small screens */
    --kb-grid-gap-row:    20px;
    --kb-card-gap:        10px;
    --kb-icon-size:       40px;
    --kb-title-size:      13px;
    --kb-desc-size:       11px;
  }

  /* 2×2 LOCKED — grid-template-columns stays 1fr 1fr (set globally, NOT overridden here) */
}
</style>

<section
  id="kb-{{ section.id }}"
  aria-label="{{ section.settings.heading }}"
>
  <div class="kb__container">
    <div class="kb__grid{% if section.settings.image_position == 'right' %} kb__grid--image-right{% endif %}">

      {%- comment %} ════════════════════════
        IMAGE COLUMN
        Renders first in DOM. CSS order flips it right when setting = 'right'.
      ════════════════════════ {%- endcomment %}
      <div class="kb__media">
        {%- if section.settings.image != blank -%}
          {{- section.settings.image
              | image_url: width: 900
              | image_tag:
                  loading: 'lazy',
                  alt: section.settings.image.alt | default: section.settings.heading
          -}}
        {%- else -%}
          <div class="kb__media-placeholder">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {%- endif -%}
      </div>

      {%- comment %} ════════════════════════
        CONTENT COLUMN — HEADING + BENEFITS GRID
      ════════════════════════ {%- endcomment %}
      <div class="kb__content">

        {%- if section.settings.heading != blank -%}
          <h2 class="kb__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <div class="kb__grid-benefits">
            {%- for block in section.blocks -%}
              <div class="kb__card" {{ block.shopify_attributes }}>

                <div class="kb__icon-wrap">
                  {%- if block.settings.icon_image != blank -%}
                    {{- block.settings.icon_image
                        | image_url: width: 128
                        | image_tag:
                            loading: 'lazy',
                            alt: ''
                    -}}
                  {%- else -%}
                    {%- case forloop.index -%}
                      {%- when 1 -%}
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                          <circle cx="12" cy="5" r="2"/>
                          <circle cx="19" cy="9" r="2"/>
                          <circle cx="19" cy="15" r="2"/>
                          <circle cx="12" cy="19" r="2"/>
                          <circle cx="5"  cy="15" r="2"/>
                          <circle cx="5"  cy="9"  r="2"/>
                          <line x1="12" y1="7"  x2="17.5" y2="8.1"/>
                          <line x1="19" y1="11" x2="19"   y2="13"/>
                          <line x1="17.5" y1="15.9" x2="12" y2="17"/>
                          <line x1="6.5" y1="15.9"  x2="12" y2="17"/>
                          <line x1="5"  y1="11" x2="5"    y2="13"/>
                          <line x1="6.5" y1="8.1"   x2="12" y2="7"/>
                        </svg>
                      {%- when 2 -%}
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                          <line x1="12" y1="2"  x2="12" y2="22"/>
                          <line x1="2"  y1="12" x2="22" y2="12"/>
                          <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/>
                          <line x1="19.07" y1="4.93" x2="4.93" y2="19.07"/>
                          <polyline points="9 3 12 2 15 3"/>
                          <polyline points="9 21 12 22 15 21"/>
                          <polyline points="3 9 2 12 3 15"/>
                          <polyline points="21 9 22 12 21 15"/>
                        </svg>
                      {%- when 3 -%}
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                          <path d="M12 2C12 2 5 10 5 15a7 7 0 0 0 14 0c0-5-7-13-7-13z"/>
                          <line x1="9" y1="17" x2="15" y2="17"/>
                          <line x1="12" y1="14" x2="12" y2="20"/>
                        </svg>
                      {%- when 4 -%}
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                          <path d="M3 13h18a9 9 0 0 0-18 0z"/>
                          <line x1="3" y1="13" x2="3" y2="16"/>
                          <line x1="21" y1="13" x2="21" y2="16"/>
                          <line x1="2" y1="16" x2="22" y2="16"/>
                          <line x1="12" y1="4" x2="12" y2="13"/>
                          <circle cx="12" cy="3.5" r="0.5" fill="currentColor"/>
                        </svg>
                      {%- else -%}
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                          <path d="M21 3C21 3 12 3 7 8s-2 13-2 13 8 1 13-4 3-14 3-14z"/>
                          <line x1="3" y1="21" x2="10.5" y2="13.5"/>
                        </svg>
                    {%- endcase -%}
                  {%- endif -%}
                </div>

                {%- if block.settings.title != blank -%}
                  <h3 class="kb__card-title">{{ block.settings.title }}</h3>
                {%- endif -%}

                {%- if block.settings.description != blank -%}
                  <div class="kb__card-desc">{{ block.settings.description }}</div>
                {%- endif -%}

              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}

      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Key Benefits",
  "tag": "section",
  "class": "section-key-benefits",
  "max_blocks": 4,
  "settings": [
    {
      "type": "header",
      "content": "Section Style"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Colour",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image Column Position",
      "info": "Controls whether the image sits on the left or right on desktop. On mobile the image always stacks on top.",
      "options": [
        { "value": "left",  "label": "Left (default)" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Image Column"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Section Image",
      "info": "Displays as a 1:1 square on all devices. Recommended: square crop."
    },
    {
      "type": "header",
      "content": "Content Column"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Key Benefits"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Icon Image",
          "info": "Upload a custom icon (PNG/SVG, recommended 64x64px, transparent bg). Leave empty to use the built-in fallback icon."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Benefit Title",
          "default": "Rich in Polyphenols & Oleic Acid"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>Promotes heart health, vitality, and overall well-being.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Key Benefits",
      "settings": {
        "bg_color": "#FFFFFF",
        "image_position": "left"
      },
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "title": "Rich in Polyphenols & Oleic Acid",
            "description": "<p>Promotes heart health, vitality, and overall well-being.</p>"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "title": "100% Cold-Pressed",
            "description": "<p>Extracted without heat or chemicals to retain natural flavors and nutrients.</p>"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "title": "Naturally Low Acidity",
            "description": "<p>Ensures an unrivaled taste and better health benefits.</p>"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "title": "Versatile Culinary Use",
            "description": "<p>Ideal for salads, dressings, marinades, and more.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
