</fast-bar-hero-{{ ai_gen_id }}>

<script>
  (function() {
    class FastBarHero{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.countdownElement = this.querySelector('#ai-hero-countdown-timer-{{ ai_gen_id }}');
      }

      connectedCallback() {
        if (this.countdownElement) {
          this.startCountdown();
        }
        this.applyHeadingHighlight();
      }

      applyHeadingHighlight() {
        const heading = this.querySelector('.ai-hero-fastbar-heading-{{ ai_gen_id }}');
        if (heading) {
          const highlightText = '{{ block.settings.heading_highlight_text }}';
          if (highlightText) {
            const headingHTML = heading.innerHTML;
            const highlightedHTML = headingHTML.replace(
              highlightText,
              '<span class="ai-hero-fastbar-heading-highlight-{{ ai_gen_id }}">' + highlightText + '</span>'
            );
            heading.innerHTML = highlightedHTML;
          }
        }
      }

      startCountdown() {
        const endTime = new Date().getTime() + ({{ block.settings.countdown_hours }} * 60 * 60 * 1000);

        const updateCountdown = () => {
          const now = new Date().getTime();
          const distance = endTime - now;

          if (distance < 0) {
            this.countdownElement.textContent = '00:00:00';
            return;
          }

          const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
          const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
          const seconds = Math.floor((distance % (1000 * 60)) / 1000);

          this.countdownElement.textContent = 
            String(hours).padStart(2, '0') + ':' + 
            String(minutes).padStart(2, '0') + ':' + 
            String(seconds).padStart(2, '0');
        };

        updateCountdown();
        setInterval(updateCountdown, 1000);
      }
    }

    customElements.define('fast-bar-hero-{{ ai_gen_id }}', FastBarHero{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Fast Bar hero",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum width",
      "min": 1000,
      "max": 1600,
      "step": 100,
      "unit": "px",
      "default": 1400
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Grid gap",
      "min": 20,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "section_padding_desktop",
      "label": "Desktop padding",
      "min": 20,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "section_padding_mobile",
      "label": "Mobile padding",
      "min": 20,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "header",
      "content": "Main heading"
    },
