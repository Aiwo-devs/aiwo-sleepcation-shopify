{% comment %}
  CTA Hero Section
  Background Image with Left-Aligned Content
{% endcomment %}

<style>
/* ==========================================================================
   CSS VARIABLES
   ========================================================================== */
:root {
  --cta-text: #FEFEFE;
  --cta-btn-bg: #FEFEFE;
  --cta-btn-text: #0C0C0D;
  --cta-btn-hover-bg: #0C0C0D;
  --cta-btn-hover-text: #FEFEFE;
  --cta-radius: 8px;
  --cta-transition: 0.3s ease;
}

/* ==========================================================================
   SECTION WITH BACKGROUND IMAGE
   ========================================================================== */
.section_cta-hero {
  width: 100%;
  padding: 80px 60px;
  background-color: #7A7A7A;
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  position: relative;
}

.section_cta-hero::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(to right, rgba(0, 0, 0, 0.3), transparent);
  pointer-events: none;
}

.cta-hero_container {
  max-width: 1400px;
  margin: 0 auto;
  position: relative;
  z-index: 1;
}

/* ==========================================================================
   CONTENT WRAPPER
   ========================================================================== */
.cta-hero_content {
  max-width: 900px;
}

/* ==========================================================================
   HEADING - ONE LINE ON DESKTOP
   ========================================================================== */
.cta-hero_heading {
  font-size: 48px;
  font-weight: 600;
  line-height: 1.2;
  color: var(--cta-text);
  margin: 0 0 16px 0;
}

@media (min-width: 768px) {
  .cta-hero_heading {
    white-space: nowrap;
  }
}

/* ==========================================================================
   DESCRIPTION
   ========================================================================== */
.cta-hero_description {
  font-size: 18px;
  font-weight: 400;
  line-height: 1.5;
  color: var(--cta-text);
  margin: 0 0 16px 0;
}

/* ==========================================================================
   PRICING
   ========================================================================== */
.cta-hero_pricing {
  display: flex;
  align-items: baseline;
  gap: 8px;
  margin-bottom: 24px;
}

.cta-hero_price {
  font-size: 48px;
  font-weight: 700;
  line-height: 1.2;
  color: var(--cta-text);
  margin: 0;
}

.cta-hero_price-label {
  font-size: 18px;
  font-weight: 400;
  line-height: 1.5;
  color: var(--cta-text);
  margin: 0;
}

/* ==========================================================================
   FEATURE BADGES
   ========================================================================== */
.cta-hero_badges {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-bottom: 40px;
}

.cta-hero_badge {
  display: flex;
  align-items: center;
  gap: 8px;
}

.cta-hero_badge-icon {
  width: 32px;
  height: 32px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cta-hero_badge-icon img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  display: block;
}

.cta-hero_badge-text {
  font-size: 18px;
  font-weight: 700;
  line-height: 1.5;
  color: var(--cta-text);
  margin: 0;
  white-space: nowrap;
}

/* ==========================================================================
   BUY NOW BUTTON
   ========================================================================== */
.cta-hero_button {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  padding: 12px 16px;
  background-color: var(--cta-btn-bg);
  color: var(--cta-btn-text);
  border: none;
  border-radius: var(--cta-radius);
  font-size: 20px;
  font-weight: 600;
  line-height: 1.5;
  text-decoration: none;
  cursor: pointer;
  transition: all var(--cta-transition);
}

.cta-hero_button-icon {
  width: 32px;
  height: 32px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: filter var(--cta-transition);
}

.cta-hero_button-icon svg {
  width: 100%;
  height: 100%;
  display: block;
}

.cta-hero_button:hover {
  background-color: var(--cta-btn-hover-bg);
  color: var(--cta-btn-hover-text);
}

.cta-hero_button:hover .cta-hero_button-icon svg path {
  stroke: var(--cta-btn-hover-text);
}

/* ==========================================================================
   RESPONSIVE - TABLET
   ========================================================================== */
@media (max-width: 991px) {
  .section_cta-hero {
    padding: 64px 40px;
  }
  
  .cta-hero_content {
    max-width: 700px;
  }
  
  .cta-hero_heading {
    font-size: 40px;
    white-space: normal;
  }
  
  .cta-hero_price {
    font-size: 40px;
  }
  
  .cta-hero_description,
  .cta-hero_price-label,
  .cta-hero_badge-text {
    font-size: 16px;
  }
  
  .cta-hero_badges {
    gap: 10px;
    margin-bottom: 32px;
  }
  
  .cta-hero_badge-icon {
    width: 28px;
    height: 28px;
  }
  
  .cta-hero_button {
    font-size: 18px;
    padding: 10px 14px;
  }
  
  .cta-hero_button-icon {
    width: 28px;
    height: 28px;
  }
}

/* ==========================================================================
   RESPONSIVE - MOBILE (2x2 BADGE GRID)
   ========================================================================== */
@media (max-width: 767px) {
  .section_cta-hero {
    padding: 48px 24px;
    background-position: 70% center;
  }
  
  .cta-hero_content {
    max-width: 100%;
  }
  
  .cta-hero_heading {
    font-size: 32px;
    white-space: normal;
  }
  
  .cta-hero_description {
    font-size: 15px;
    margin-bottom: 12px;
  }
  
  .cta-hero_pricing {
    flex-direction: column;
    gap: 4px;
    margin-bottom: 20px;
  }
  
  .cta-hero_price {
    font-size: 36px;
  }
  
  .cta-hero_price-label {
    font-size: 15px;
  }
  
  /* 2 COLUMNS × 2 ROWS GRID */
  .cta-hero_badges {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px 8px;
    margin-bottom: 32px;
  }
  
  .cta-hero_badge {
    gap: 6px;
  }
  
  .cta-hero_badge-icon {
    width: 24px;
    height: 24px;
  }
  
  .cta-hero_badge-text {
    font-size: 14px;
  }
  
  .cta-hero_button {
    width: 100%;
    justify-content: center;
    font-size: 18px;
    padding: 14px 20px;
  }
  
  .cta-hero_button-icon {
    width: 28px;
    height: 28px;
  }
}

/* ==========================================================================
   RESPONSIVE - MOBILE PORTRAIT
   ========================================================================== */
@media (max-width: 479px) {
  .section_cta-hero {
    padding: 40px 20px;
  }
  
  .cta-hero_heading {
    font-size: 28px;
  }
  
  .cta-hero_price {
    font-size: 32px;
  }
  
  .cta-hero_button {
    font-size: 16px;
  }
}
</style>

<div class="section_cta-hero" {% if section.settings.background_image %}style="background-image: url('{{ section.settings.background_image | image_url: width: 2000 }}');"{% endif %}>
  <div class="cta-hero_container">
    
    <div class="cta-hero_content">
      
      <!-- Heading -->
      <h2 class="cta-hero_heading">{{ section.settings.heading }}</h2>
      
      <!-- Description -->
      <p class="cta-hero_description">{{ section.settings.description }}</p>
      
      <!-- Pricing -->
      <div class="cta-hero_pricing">
        <p class="cta-hero_price">{{ section.settings.price }}</p>
        <p class="cta-hero_price-label">{{ section.settings.price_label }}</p>
      </div>
      
      <!-- Feature Badges -->
      <div class="cta-hero_badges">
        {%- for i in (1..4) -%}
          {%- assign badge_icon = 'badge_' | append: i | append: '_icon' -%}
          {%- assign badge_text = 'badge_' | append: i | append: '_text' -%}
          
          {%- if section.settings[badge_text] != blank -%}
            <div class="cta-hero_badge">
              {%- if section.settings[badge_icon] != blank -%}
                <div class="cta-hero_badge-icon">
                  {{- section.settings[badge_icon] | image_url: width: 64 | image_tag: loading: 'lazy', alt: section.settings[badge_text] -}}
                </div>
              {%- endif -%}
              <p class="cta-hero_badge-text">{{ section.settings[badge_text] }}</p>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
      
      <!-- Buy Now Button -->
      <a href="{{ section.settings.button_link | default: '#' }}" class="cta-hero_button">
        <span class="cta-hero_button-icon">
          <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M6 6L10 6L13.6 19.59C13.7 20.03 13.96 20.42 14.33 20.69C14.7 20.96 15.15 21.1 15.61 21.1H25.45C25.91 21.1 26.36 20.96 26.73 20.69C27.1 20.42 27.36 20.03 27.47 19.59L29.72 10.39C29.78 10.13 29.77 9.86 29.71 9.6C29.64 9.34 29.51 9.09 29.33 8.88C29.16 8.67 28.94 8.5 28.69 8.39C28.44 8.27 28.17 8.21 27.89 8.21H11.79M14 25C14 25.55 13.55 26 13 26C12.45 26 12 25.55 12 25C12 24.45 12.45 24 13 24C13.55 24 14 24.45 14 25ZM27 25C27 25.55 26.55 26 26 26C25.45 26 25 25.55 25 25C25 24.45 25.45 24 26 24C26.55 24 27 24.45 27 25Z" stroke="#0C0C0D" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
        <span>{{ section.settings.button_text }}</span>
      </a>
      
    </div>
    
  </div>
</div>

{% schema %}
{
  "name": "CTA Hero",
  "settings": [
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image",
      "info": "Recommended: 2000px wide"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Ready to Transform Your Fasting Journey?"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Join thousands of health-conscious Indians who have made AIWO Fast Bar their trusted companion. Whether you're new to intermittent fasting or a seasoned practitioner, start experiencing the difference today."
    },
    {
      "type": "header",
      "content": "Pricing"
    },
    {
      "type": "text",
      "id": "price",
      "label": "Price",
      "default": "₹3,000/"
    },
    {
      "type": "text",
      "id": "price_label",
      "label": "Price Label",
      "default": "Pack of 30 Bars"
    },
    {
      "type": "header",
      "content": "Badge 1"
    },
    {
      "type": "image_picker",
      "id": "badge_1_icon",
      "label": "Icon"
    },
    {
      "type": "text",
      "id": "badge_1_text",
      "label": "Text",
      "default": "30 Days Supply"
    },
    {
      "type": "header",
      "content": "Badge 2"
    },
    {
      "type": "image_picker",
      "id": "badge_2_icon",
      "label": "Icon"
    },
    {
      "type": "text",
      "id": "badge_2_text",
      "label": "Text",
      "default": "Free Shipping"
    },
    {
      "type": "header",
      "content": "Badge 3"
    },
    {
      "type": "image_picker",
      "id": "badge_3_icon",
      "label": "Icon"
    },
    {
      "type": "text",
      "id": "badge_3_text",
      "label": "Text",
      "default": "₹100 per bar"
    },
    {
      "type": "header",
      "content": "Badge 4"
    },
    {
      "type": "image_picker",
      "id": "badge_4_icon",
      "label": "Icon"
    },
    {
      "type": "text",
      "id": "badge_4_text",
      "label": "Text",
      "default": "FSSAI Certified"
